---
import BlogWebsiteQuestionnaire from '../components/BlogWebsiteQuestionnaire.astro';
import ConsentManagerHead from '../components/ConsentManagerHead.astro';
import '../styles/global.css';
import HomeNavigation from '../components/HomeNavigation.astro';
import { homeIntroContent } from '../data/homeIntroContent';
import '../styles/home-page.css';
import '../styles/service-pages.css';
import '../styles/knowledge.css';
import AgencyFooter from '../components/AgencyFooter.astro';
import AiImageFrame from '../components/AiImageFrame.astro';
import ResponsiveBlogImage from '../components/ResponsiveBlogImage.astro';
import { absoluteUrl, blogPostingSchema, jsonLd } from '../lib/siteMetadata';

const { frontmatter } = Astro.props;
const {
	title,
	seoTitle,
	draft = false,
	websiteQuestionnaire = false,
	socialImage,
	authorType = 'Person',
	kicker,
	date,
	lastModified = date,
	author,
	authorRole,
	authorHref,
	readTime,
	coverImage,
	coverImageFallback,
	coverImageAlt,
	coverImageWidth,
	coverImageHeight,
	coverImageDisclosure,
	excerpt,
	showExcerpt = true,
	lang,
	alternateLocaleHref,
	ctaTitle: customCtaTitle,
	ctaBody: customCtaBody,
	ctaButtonText: customCtaButtonText,
	ctaHref: customCtaHref,
} = frontmatter;

const locale = lang === 'de' ? 'de' : 'en';
const faviconHref = `${import.meta.env.BASE_URL}favicon.png`;

const formattedDate = new Date(date).toLocaleDateString(
	locale === 'de' ? 'de-DE' : 'en-US',
	{ year: 'numeric', month: 'long', day: 'numeric' }
);
const formattedLastModified = new Date(lastModified).toLocaleDateString(
	locale === 'de' ? 'de-DE' : 'en-US',
	{ year: 'numeric', month: 'long', day: 'numeric' }
);

const backText = locale === 'de' ? 'Zurück zu Wissen' : 'Back to Insights';
const backHref = locale === 'de' ? '/de/blog/' : '/en/blog/';

const defaultCtaTitle = locale === 'de'
	? 'Bereit für den nächsten Schritt?'
	: 'Ready to take the next step?';
const defaultCtaBody = locale === 'de'
	? 'Wir besprechen Ihre Ziele und klären, welche nächsten Schritte für Ihren digitalen Firmenauftritt oder Ihre Arbeitsabläufe sinnvoll sind.'
	: 'Let’s discuss your goals and explore the next steps for your online presence or business workflows.';
const defaultCtaButtonText = locale === 'de'
	? 'Erstgespräch vereinbaren'
	: 'Book a discovery call';
const ctaTitle = customCtaTitle ?? defaultCtaTitle;
const ctaBody = customCtaBody ?? defaultCtaBody;
const ctaButtonText = customCtaButtonText ?? defaultCtaButtonText;
const ctaHref = customCtaHref ?? 'https://calendar.app.google/utFQgw33PwJTiDk56';
const ctaIsExternal = /^https?:\/\//.test(ctaHref);
const normalizedPath = Astro.url.pathname.replace(/\/+$/, '') || '/';
const canonicalUrl = absoluteUrl(normalizedPath);
const normalizedAlternatePath = alternateLocaleHref?.replace(/\/+$/, '') || undefined;
const alternateUrl = normalizedAlternatePath ? absoluteUrl(normalizedAlternatePath) : undefined;
const languageSwitchHref = alternateLocaleHref ?? (locale === 'de' ? '/en/blog/' : '/de/blog/');
const socialImagePath = socialImage ?? coverImageFallback ?? coverImage;
const socialImageUrl = socialImagePath ? absoluteUrl(socialImagePath) : undefined;
const structuredData = blogPostingSchema({
	title,
	description: excerpt,
	pathname: normalizedPath,
	image: socialImagePath,
	datePublished: draft ? undefined : date,
	dateModified: lastModified,
	author,
	authorType,
	authorRole,
	authorUrl: authorHref ? absoluteUrl(authorHref) : undefined,
	locale,
});
const headings: { depth: number; slug: string; text: string }[] = Astro.props.headings ?? [];
const tocDepth = headings.some(h => h.depth === 2) ? 2 : 3;
const tocHeadings = headings.filter(h => h.depth === tocDepth);
const articleHtml = websiteQuestionnaire ? await Astro.slots.render('default') : '';
const insertionMatch = articleHtml.match(/<h2\b[^>]*id="welche-rolle-spielt-künstliche-intelligenz-bei-den-angriffen"/);
const insertionIndex = insertionMatch?.index ?? articleHtml.indexOf('<h2', articleHtml.indexOf('security-concepts'));
const beforeQuestionnaire = insertionIndex >= 0 ? articleHtml.slice(0, insertionIndex) : articleHtml;
const afterQuestionnaire = insertionIndex >= 0 ? articleHtml.slice(insertionIndex) : '';
const profileHref = authorHref ?? (author === 'Marlon Dietrich' ? `/${locale}/${locale === 'de' ? 'ueber-uns' : 'about-us'}/` : undefined);
---

<html lang={locale} class="home-document">
	<head>
		<ConsentManagerHead locale={locale} />
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/png" href={faviconHref} />
		<meta name="generator" content={Astro.generator} />
		{draft && <meta name="robots" content="noindex, nofollow" />}
		<title>{seoTitle ?? `${title} | Vibeperform`}</title>
		{excerpt ? <meta name="description" content={excerpt} /> : null}
		<link rel="canonical" href={canonicalUrl} />
		{!draft && <link rel="alternate" type="text/markdown" href={`${canonicalUrl}index.md`} />}
		<link rel="alternate" hreflang={locale} href={canonicalUrl} />
		{alternateUrl ? <link rel="alternate" hreflang={locale === 'de' ? 'en' : 'de'} href={alternateUrl} /> : null}
		<link rel="alternate" hreflang="x-default" href={locale === 'de' || !alternateUrl ? canonicalUrl : alternateUrl} />
		<meta property="og:type" content="article" />
		<meta property="og:site_name" content="Vibeperform" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={excerpt} />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:locale" content={locale === 'de' ? 'de_DE' : 'en_US'} />
		{alternateUrl ? <meta property="og:locale:alternate" content={locale === 'de' ? 'en_US' : 'de_DE'} /> : null}
		{socialImageUrl ? <meta property="og:image" content={socialImageUrl} /> : null}
		{coverImageAlt ? <meta property="og:image:alt" content={coverImageAlt} /> : null}
		{!draft && <meta property="article:published_time" content={date} />}
		<meta property="article:modified_time" content={lastModified} />
		<meta property="article:author" content={author} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={excerpt} />
		{socialImageUrl ? <meta name="twitter:image" content={socialImageUrl} /> : null}
		{coverImageAlt ? <meta name="twitter:image:alt" content={coverImageAlt} /> : null}
		<script type="application/ld+json" set:html={jsonLd(structuredData)} />
	</head>
<body><div class="home-shell" id="top">
<HomeNavigation copy={homeIntroContent[locale]} locale={locale} alternateLocaleHref={languageSwitchHref}/>
<main class="home-main">
<article class:list={['kn-post', {'kn-post--draft': draft}]}>
  <header class="sv-hero kn-post-hero" id="home-intro"><div class="hp-wrap">
    <a class="hp-text-link kn-back" href={backHref}><span aria-hidden="true">←</span>{backText}</a>
    <p class="sv-kicker">{kicker}</p>{draft && <p class="kn-draft">Entwurf zur Freigabe · noch nicht veröffentlicht</p>}<h1>{title}</h1>{showExcerpt && <p class="sv-lead">{excerpt}</p>}
    <div class="kn-byline"><div class="kn-author-mark" aria-hidden="true">{author.split(' ').map((n: string)=>n[0]).join('')}</div><div><p>{profileHref ? <a href={profileHref}>{author}</a> : author}</p>{authorRole && <p class="kn-author-role">{authorRole}</p>}<div class="kn-meta"><span>{draft ? 'Redaktionsstand: ' : ''}<time datetime={date}>{formattedDate}</time></span><span>{readTime}</span>{lastModified !== date && <span>{locale==='de'?'Aktualisiert':'Updated'} <time datetime={lastModified}>{formattedLastModified}</time></span>}</div></div></div>
  </div></header>
  {coverImage && <div class="hp-wrap kn-post-cover"><AiImageFrame label={coverImageDisclosure ?? (locale==='de'?'KI-generierte Illustration':'AI-generated illustration')}><ResponsiveBlogImage image={frontmatter} sizes="(max-width: 700px) calc(100vw - 52px), (max-width: 1288px) 90vw, 1160px" priority /></AiImageFrame></div>}
  <div class="hp-wrap kn-reading-grid">
    {tocHeadings.length > 0 && <aside class="kn-toc"><details open><summary>{locale==='de'?'In diesem Beitrag':'In this article'}<span aria-hidden="true">↕</span></summary><nav aria-label={locale==='de'?'Inhaltsverzeichnis':'Table of contents'}><ol>{tocHeadings.map(h=><li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol></nav></details></aside>}
    <div class="kn-reading-main"><div class="blog-content">{websiteQuestionnaire ? <><Fragment set:html={beforeQuestionnaire}/><BlogWebsiteQuestionnaire preview={draft} /><Fragment set:html={afterQuestionnaire}/></> : <slot/>}</div>{!websiteQuestionnaire && <section class="kn-article-cta" aria-labelledby="article-cta-title"><p class="hp-kicker">{locale==='de'?'Ihr nächster Schritt':'Your next step'}</p><h2 id="article-cta-title">{ctaTitle}</h2><p>{ctaBody}</p><a class="hp-button" href={ctaHref} data-analytics-event={ctaIsExternal?'contact_start':'cta_click'} data-analytics-name="blog-article-cta" data-analytics-location="blog-article">{ctaButtonText}<span aria-hidden="true">↗</span></a></section>}<a class="hp-text-link kn-back-bottom" href={backHref}><span aria-hidden="true">←</span>{backText}</a></div>
  </div>
</article>
</main><AgencyFooter locale={locale}/>
</div></body></html>
