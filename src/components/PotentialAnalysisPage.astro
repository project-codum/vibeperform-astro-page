---
import AgencyDocument from './AgencyDocument.astro';
import AssessmentExample from './AssessmentExample.astro';
import { potentialAnalysisContent } from '../data/potentialAnalysisContent';
import { supplementalContent } from '../data/supplementalContent';
import BookingCalendar from './BookingCalendar.astro';
import '../styles/service-narrative.css';
import '../styles/supplemental-pages.css';
interface Props { currentLocale:'de'|'en'; }
const {currentLocale:locale}=Astro.props;
const de=locale==='de';
const t=potentialAnalysisContent[locale];
const c=supplementalContent[locale];
const path=de?'/de/ki-potenzialanalyse/':'/en/ai-potential-analysis/';
---
<AgencyDocument locale={locale} title={t.metaTitle} description={t.metaDescription} path={path} alternatePath={de?'/en/ai-potential-analysis/':'/de/ki-potenzialanalyse/'} service>
 <section class="sv-hero sn-hero" aria-labelledby="home-title"><div class="hp-wrap" id="home-intro" tabindex="-1"><nav class="sv-breadcrumb" aria-label={de?'Seitenpfad':'Breadcrumb'}><a href={de?'/de/ki-strategie/':'/en/ai-strategy/'}>{de?'KI-Beratung':'AI consulting'}</a><span aria-hidden="true">/</span><span>{de?'Potenzialanalyse':'Potential analysis'}</span></nav><h1 id="home-title">{c.analysisTitle}<br/><em>{c.analysisEmphasis}</em></h1><div class="sn-hero-bottom"><p class="sv-lead">{t.hero.intro}</p><div class="sn-actions"><a class="hp-button" href="#kontakt">{c.analysisRequest}<span aria-hidden="true">↓</span></a><a class="hp-text-link" href="#auswertung">{de?'Beispiel einer Auswertung':'See an example assessment'}<span aria-hidden="true">↓</span></a></div></div></div></section>
 <section class="hp-section sp-assessment" id="auswertung" aria-labelledby="assessment-title"><div class="hp-wrap sp-assessment-grid"><div><p class="hp-kicker">{t.review.kicker}</p><h2 id="assessment-title">{de?'Eine klare Grundlage':'A clear basis'}<br/><em>{de?'für Ihre Entscheidung.':'for your decision.'}</em></h2><p class="hp-intro">{t.review.intro}</p><ul class="sp-deliverables">{t.review.items.map(item=><li>{item}</li>)}</ul><p>{t.review.decisionBody}</p></div><AssessmentExample locale={locale}/></div></section>
 <section class="hp-section sp-analysis-process" id={t.process.id} aria-labelledby="analysis-process-title"><div class="hp-wrap"><p class="hp-kicker">{t.process.kicker}</p><h2 id="analysis-process-title">{de?'Sie zeigen den Vorgang.':'You show us the task.'}<br/><em>{de?'Wir gehen ihn gemeinsam durch.':'We work through it together.'}</em></h2><ol class="sp-process">{t.process.items.map((item,i)=><li><span>0{i+1}</span><h3>{item.title}</h3><p>{item.body}</p></li>)}</ol></div></section>
 <section class="hp-section hp-faq" aria-labelledby="faq-title"><div class="hp-wrap hp-split"><h2 id="faq-title">{de?'Vor der':'Before the'}<br/><em>{de?'Analyse.':'analysis.'}</em></h2><div>{t.faq.items.map(item=><details><summary>{item.question}<span aria-hidden="true">＋</span></summary><p>{item.answer}</p></details>)}<details><summary>{de?'Ist das die kostenlose Erstberatung?':'Is this the free introductory call?'}<span aria-hidden="true">＋</span></summary><p>{c.analysisBoundary}</p></details></div></div></section>
 <section class="hp-section hp-contact" id="kontakt" aria-labelledby="contact-title"><div class="hp-wrap"><h2 id="contact-title">{c.analysisContactTitle}<br/><em>{c.analysisContactEmphasis}</em></h2><p class="hp-intro">{t.finalCta.body}</p><p class="sp-terms">{c.analysisBoundary}</p><div class="hp-contact-actions"><a class="hp-button" href={t.finalCta.button.href}>{c.analysisRequest}<span aria-hidden="true">↗</span></a></div><h3 class="sp-calendar-heading">{c.introCall}</h3><BookingCalendar locale={locale} autoOpen /></div></section>
</AgencyDocument>
