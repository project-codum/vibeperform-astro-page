---
import { Image } from 'astro:assets';
import TradeInquiryForm from './TradeInquiryForm.astro';
import { tradePageContent } from '../data/tradePageContent';
import interior from '../assets/website-service/interior.png';
import materials from '../assets/website-service/materials.png';
import '../styles/trade-page.css';
interface Props { locale:'de'|'en'; }
const {locale}=Astro.props;
const c=tradePageContent[locale];
const de=locale==='de';
---
<div class="tw-page" data-website-service data-locale={locale} data-inquiry-endpoint="/api/website-inquiries">
<svg width="0" height="0" aria-hidden="true" style="position:absolute"><defs><symbol id="arrow" viewBox="0 0 24 24"><path d="M4 12h16m-6-6 6 6-6 6"/></symbol></defs></svg>
<section class="sv-hero tw-hero" aria-labelledby="home-title">
  <div class="hp-wrap" id="home-intro" tabindex="-1">
    <nav class="sv-breadcrumb" aria-label={de?'Seitenpfad':'Breadcrumb'}><a href={de?'/de/leistungen/':'/en/services/'}>{de?'Leistungen':'Services'}</a><span aria-hidden="true">/</span><span>{c.kicker}</span></nav>
    <div class="tw-hero-grid"><div><p class="sv-kicker">{c.kicker}</p><h1 id="home-title">{c.title}<br/><em>{c.emphasis}</em></h1><p class="sv-lead">{c.intro}</p><a class="hp-button" href="#anfrage">{c.cta}<span aria-hidden="true">↗</span></a><p class="tw-hero-note">{c.note}</p></div>
    <figure class="tw-example"><div class="tw-browser" aria-hidden="true"><i></i><i></i><i></i><span>handwerk.example</span></div><div class="tw-site"><div class="tw-site-nav"><strong>WERK<span> / {de?'Möbel & Räume':'Furniture & spaces'}</span></strong><span>{de?'Leistungen · Projekte':'Services · Projects'}</span></div><div class="tw-site-image"><Image src={interior} alt={de?'Gestaltungsbeispiel mit KI-generiertem Innenausbau':'Design example with an AI-generated interior'} widths={[400,800,1200]} sizes="(max-width:900px) 90vw, 600px" format="webp" loading="eager" fetchpriority="high"/><div><small>{de?'Schreinerei · Innenausbau':'Joinery · Interior fitting'}</small><strong>{de?'Gute Räume.':'Great spaces.'}<br/><em>{de?'Von Hand gemacht.':'Made by hand.'}</em></strong></div></div><div class="tw-site-bottom"><p>{de?'Einbaumöbel. Küchen. Räume mit Charakter.':'Fitted furniture. Kitchens. Spaces with character.'}</p><span>{de?'Ihr Projekt beginnt hier':'Your project starts here'} ↗</span></div></div><figcaption>{c.example}</figcaption></figure></div>
  </div>
</section>
<section class="hp-section" aria-labelledby="problems-title"><div class="hp-wrap hp-split"><div><p class="hp-kicker">{de?'Aus Ihrem Betriebsalltag':'Your day-to-day business'}</p><h2 id="problems-title">{c.problemsTitle}<br/><em>{c.problemsEmphasis}</em></h2></div><div class="hp-editorial-list">{c.problems.map(([title,body])=><article><h3>{title}</h3><p>{body}</p></article>)}</div></div></section>
<section class="hp-section hp-services" id="angebot" aria-labelledby="scope-title"><div class="hp-wrap"><p class="hp-kicker">{c.scopeKicker}</p><div class="hp-section-heading"><h2 id="scope-title">{c.scopeTitle}<br/><em>{c.scopeEmphasis}</em></h2><p class="hp-intro">{c.scopeIntro}</p></div><div class="hp-service-grid">{c.scope.map(([title,body],i)=><article><span class="hp-number">0{i+1}</span><h3>{title}</h3><p>{body}</p></article>)}</div></div></section>
<section class="hp-section" aria-labelledby="own-title"><div class="hp-wrap hp-split tw-content"><figure><Image src={materials} alt={de?'Bildauswahl, Materialmuster und Website-Skizze als Illustration':'Illustration of image selection, material samples and a website sketch'} widths={[400,800]} sizes="(max-width:700px) 90vw, 540px" format="webp" loading="lazy"/><figcaption>{c.imageCaption}</figcaption></figure><div><p class="hp-kicker">{de?'Wenig Aufwand für Sie':'Less work for you'}</p><h2 id="own-title">{c.ownTitle}<br/><em>{c.ownEmphasis}</em></h2><p class="hp-intro">{c.ownBody}</p><div class="tw-contribution"><h3>{c.ownLabel}</h3><p>{c.ownDetail}</p></div></div></div></section>
<section class="hp-section tw-process" id="zusammenarbeit" aria-labelledby="process-title"><div class="hp-wrap"><p class="hp-kicker">{de?'So arbeiten wir':'How we work'}</p><h2 id="process-title">{c.processTitle}<br/><em>{c.processEmphasis}</em></h2><ol class="hp-process-grid">{c.steps.map(([title,body],i)=><li><span class="hp-number">0{i+1}</span><h3>{title}</h3><p>{body}</p></li>)}</ol></div></section>
<section class="hp-section hp-evolution" id="betreuung" aria-labelledby="care-title"><div class="hp-wrap hp-split"><div><p class="hp-kicker">{c.careKicker}</p><h2 id="care-title">{c.careTitle}<br/><em>{c.careEmphasis}</em></h2></div><div class="tw-care"><p>{c.careBody}</p><p>{c.careNote}</p><a class="hp-text-link" href={c.careHref}>{c.careLink}<span aria-hidden="true">↗</span></a></div></div></section>
<section class="hp-section hp-faq" id="fragen" aria-labelledby="faq-title"><div class="hp-wrap hp-split"><div><p class="hp-kicker">{de?'Gut zu wissen':'Good to know'}</p><h2 id="faq-title">{c.faqTitle}<br/><em>{c.faqEmphasis}</em></h2></div><div>{c.faq.map(([q,a])=><details><summary>{q}<span aria-hidden="true">＋</span></summary><p>{a}</p></details>)}</div></div></section>
<section class="hp-section tw-contact" id="anfrage" aria-labelledby="inquiry-title"><div class="hp-wrap hp-split"><div><p class="hp-kicker">{c.contactKicker}</p><h2 id="inquiry-title">{c.contactTitle}<br/><em>{c.contactEmphasis}</em></h2><p class="hp-intro">{c.contactBody}</p><p class="tw-note">{c.contactNote}</p><p class="tw-email">{c.mail}<br/><a class="hp-text-link" href="mailto:contact@vibeperform.com">contact@vibeperform.com ↗</a></p></div><TradeInquiryForm locale={locale}/></div></section>
</div>
