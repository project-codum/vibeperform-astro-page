---
import { Image } from 'astro:assets';
import TradeInquiryForm from './TradeInquiryForm.astro';
import { tradePageContent } from '../data/tradePageContent';
import kitchenPlanning from '../assets/website-service/joinery-consultation.png';
import CollaborationVisual from './CollaborationVisual.astro';
import BookingCalendar from './BookingCalendar.astro';
import '../styles/service-narrative.css';
import '../styles/trade-page.css';
interface Props { locale:'de'|'en'; }
const {locale}=Astro.props;
const c=tradePageContent[locale];
const de=locale==='de';
---
<div class="tw-page" data-website-service data-locale={locale} data-inquiry-endpoint="/api/website-inquiries">
<svg width="0" height="0" aria-hidden="true" style="position:absolute"><defs><symbol id="arrow" viewBox="0 0 24 24"><path d="M4 12h16m-6-6 6 6-6 6"/></symbol></defs></svg>
<section class="sv-hero tw-hero" aria-labelledby="home-title">
  <div class="hp-wrap" id="home-intro" tabindex="-1">
    <nav class="sv-breadcrumb" aria-label={de?'Seitenpfad':'Breadcrumb'}><a href={de?'/de/leistungen/':'/en/services/'}>{de?'Leistungen':'Services'}</a><span aria-hidden="true">/</span><span>{c.kicker}</span></nav>
    <div class="tw-hero-grid"><div><h1 id="home-title">{c.title}<br/><em>{c.emphasis}</em></h1><p class="sv-lead">{c.intro}</p><a class="hp-button" href="#anfrage" aria-describedby="check-expectation">{c.cta}<span aria-hidden="true">↗</span></a><p class="tw-hero-note" id="check-expectation">{c.note}</p></div>
    <figure class="tw-example"><div class="tw-browser" aria-hidden="true"><i></i><i></i><i></i><span>handwerk.example</span></div><div class="tw-site"><div class="tw-site-nav"><strong>WERK<span> / {de?'Möbel & Räume':'Furniture & spaces'}</span></strong><span>{de?'Leistungen · Projekte':'Services · Projects'}</span></div><div class="tw-site-image"><Image src={kitchenPlanning} alt={de?'Gestaltungsbeispiel mit KI-generierter Küchenplanung':'Design example with AI-generated kitchen planning'} widths={[400,800,1200]} sizes="(max-width:900px) 90vw, 600px" format="webp" loading="eager" fetchpriority="high"/><div><small>{de?'Schreinerei · Innenausbau':'Joinery · Interior fitting'}</small><strong>{de?'Küchen':'Kitchens'}<br/><em>{de?'nach Maß.':'made to measure.'}</em></strong></div></div><div class="tw-site-bottom"><p>{de?'Für Altbauwohnungen mit wenig Platz.':'For period flats with limited space.'}</p><span>{de?'Fotos und Maße schicken':'Send photos and dimensions'} ↗</span><p class="tw-example-next">{de?'Wir besprechen Ihre Küche.':'We discuss your kitchen.'}</p></div></div><figcaption>{c.example}</figcaption></figure></div>
  </div>
</section>
<section class="hp-section tf-focus" id="angebot" aria-labelledby="problems-title"><div class="hp-wrap"><div class="sn-example-heading"><h2 id="problems-title">{c.problemsTitle}<br/><em>{c.problemsEmphasis}</em></h2><p>{de?'Ihre Webseite soll ein Vorhaben verständlich machen, bevor das Telefon klingelt. Dafür richten wir Inhalte und Kontaktwege an Ihrem Arbeitsalltag aus.':'Your website should help clarify a project before the phone rings. We shape its content and contact options around your day-to-day work.'}</p></div><div class="tf-focus-grid"><div class="tf-questions">{c.problems.map(([title,body],i)=><article><span class="hp-label">0{i+1}</span><h3>{title}</h3><p>{body}</p></article>)}</div><div class="tf-example"><p class="hp-kicker">{de?'Echte Arbeit zeigen · HMS Loistl':'Show real work · HMS Loistl'}</p><CollaborationVisual index={2} locale={locale} large/><p class="tf-caption">{de?'Ein Hausmeisterservice macht seine Arbeit mit einem Vorher-Nachher-Vergleich sichtbar. Das gleiche Prinzip funktioniert mit passenden Beispielen aus Ihrem Gewerk.':'A property care business shows its work through a before-and-after comparison. The same principle applies to suitable examples from your trade.'}</p></div></div></div></section>
<section class="hp-section tf-enquiry" aria-labelledby="enquiry-context-title"><div class="hp-wrap hp-split"><div><h2 id="enquiry-context-title">{de?'Ein paar Angaben.':'A few details.'}<br/><em>{de?'Ein besserer Einstieg.':'A better starting point.'}</em></h2><p class="hp-intro">{de?'Statt einer leeren Nachricht können Interessenten direkt sagen, worum es geht. Welche Angaben sinnvoll sind, hängt von Ihrem Gewerk und Ihren Wunschaufträgen ab.':'Instead of an empty message, people can tell you what they need. The useful details depend on your trade and the projects you want.'}</p><p class="tf-caption">{de?'Wenn Mitarbeitergewinnung ein Ziel ist, ergänzen wir einen eigenen Bewerbungsweg.':'If recruitment is a goal, we can add a separate application route.'}</p></div><figure class="tf-project-note"><figcaption>{de?'Beispiel · Angaben für eine Projektanfrage':'Example · Details for a project enquiry'}</figcaption><dl>{(de?[['Vorhaben','Was soll gemacht werden?'],['Projektort','Wo ist die Arbeit geplant?'],['Einblick','Welche Fotos oder Maße liegen schon vor?']]:[['Project','What needs to be done?'],['Location','Where is the work planned?'],['Context','Which photos or measurements are available?']]).map(([label,value])=><div><dt>{label}</dt><dd>{value}</dd></div>)}</dl><p>{de?'Die Webseite sammelt Kontext. Die fachliche Einschätzung bleibt bei Ihrem Betrieb.':'The website gathers context. Your business makes the professional assessment.'}</p></figure></div></section>
<section class="hp-section tw-process" id="zusammenarbeit" aria-labelledby="process-title"><div class="hp-wrap"><p class="hp-kicker">{de?'So arbeiten wir':'How we work'}</p><h2 id="process-title">{c.processTitle}<br/><em>{c.processEmphasis}</em></h2>{'processNote' in c && <p class="hp-intro">{c.processNote.before}<a href={c.processNote.href} class="underline underline-offset-4">{c.processNote.label}</a>{c.processNote.after}</p>}<ol class="hp-process-grid">{c.steps.map(([title,body],i)=><li><span class="hp-number">0{i+1}</span><h3>{title}</h3><p>{body}</p></li>)}</ol></div></section>
<aside class="sn-related hp-wrap" id="betreuung" aria-label={de?'Nach dem Start':'After launch'}><span>{de?'Auch nach dem Start an Ihrer Seite:':'Support after launch:'}</span><a href={c.careHref}>{c.careLink} ↗</a></aside>
<section class="hp-section hp-faq" id="fragen" aria-labelledby="faq-title"><div class="hp-wrap hp-split"><div><p class="hp-kicker">{de?'Gut zu wissen':'Good to know'}</p><h2 id="faq-title">{c.faqTitle}<br/><em>{c.faqEmphasis}</em></h2></div><div>{c.faq.map(([q,a])=><details><summary>{q}<span aria-hidden="true">＋</span></summary><p>{a}</p></details>)}</div></div></section>
<section class="hp-section tw-contact" id="anfrage" aria-labelledby="inquiry-title"><div class="hp-wrap hp-split"><div><p class="hp-kicker">{c.contactKicker}</p><h2 id="inquiry-title">{c.contactTitle}<br/><em>{c.contactEmphasis}</em></h2><p class="hp-intro">{c.contactBody}</p><p class="tw-note">{c.contactNote}</p><a class="hp-text-link tf-call" href="#kontakt">{de?'Lieber persönlich sprechen':'Prefer a conversation?'}<span aria-hidden="true">↗</span></a><p class="tw-email">{c.mail}<br/><a class="hp-text-link" href="mailto:contact@vibeperform.com">contact@vibeperform.com ↗</a></p></div><TradeInquiryForm locale={locale}/></div></section>
<section class="hp-section hp-contact" id="kontakt" aria-labelledby="trade-call-title"><div class="hp-wrap"><h2 id="trade-call-title">{de?'Lieber persönlich':'Prefer a'}<br/><em>{de?'kennenlernen?':'conversation?'}</em></h2><p class="hp-intro">{de?'Im Gespräch bekommen Sie kostenlos einen Statuscheck Ihres Online-Auftritts mit Benotung und Feedback.':'During the call, you receive a free assessment of your online presence, including a rating and feedback.'}</p><BookingCalendar locale={locale} autoOpen /></div></section>
</div>

<style>
.tf-focus-grid{display:grid;grid-template-columns:1.1fr 1fr;gap:10%;align-items:center}.tf-questions article{padding:25px 0;border-top:1px solid var(--hp-line)}.tf-questions h3{font-size:25px}.tf-questions p{font-size:15px}.tf-example{min-width:0}.tf-example :global(.published-example){padding:30px}.tf-example :global(.published-heading){font-size:30px;max-width:21ch}.tf-example :global(.published-pair figcaption){font-size:10px;padding:5px 8px}.tf-caption{font-size:13px!important;line-height:1.7;color:var(--hp-muted);margin-top:23px}.tf-enquiry{background:#eee8e5}.tf-project-note{margin:0;padding:32px;background:#fffdf9;border-left:3px solid #a484ba}.tf-project-note figcaption{font-size:12px;color:#745188}.tf-project-note dl{margin:24px 0}.tf-project-note dl>div{padding:17px 0;border-top:1px solid #e5dbe9}.tf-project-note dt{font-size:12px;color:#745188}.tf-project-note dd{font-size:23px;line-height:1.25;letter-spacing:-.025em;margin:10px 0 0}.tf-project-note>p{font-size:13px;margin-bottom:0}.tf-call{margin-top:10px}.tw-process .hp-process-grid{grid-template-columns:repeat(3,minmax(0,1fr))}
@media(max-width:760px){.tf-focus-grid{grid-template-columns:1fr;gap:30px}.tf-example{max-width:480px;margin:auto}.tf-example :global(.collaboration-visual){max-width:none}.tf-example :global(.published-example){padding:23px}.tf-project-note{padding:25px}.tf-project-note dd{font-size:22px}.tw-process .hp-process-grid{grid-template-columns:1fr}.tw-hero h1{font-size:clamp(34px,8vw,49px)}}
</style>
