---
interface Props { index: number; locale: 'de' | 'en'; }
const { index, locale } = Astro.props;
const de = locale === 'de';
const base = (import.meta.env.BASE_URL ?? '/').replace(/\/$/, '');
---
<div class:list={['study-visual', index === 1 && 'study-visual--tree']}>
  {index === 0 ? <div class="motif-pair">
    <figure class="old-motif"><div class="motif-image"><img src={`${base}/case-studies/loistl/before-small.webp`} width="1000" height="3623" alt={de ? 'Frühere Webseite mit einer modernen Villa als Stockmotiv' : 'Previous website using a stock photo of a modern villa'} loading="lazy" /></div></figure>
    <span class="motif-arrow" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14m-6-6 6 6-6 6" /></svg></span>
    <figure class="new-motif"><div class="motif-image"><img src={`${base}/case-studies/loistl/after-desktop.webp`} width="1440" height="1000" alt={de ? 'Neuer Webseitenauftritt mit einem gepflegten Hauseingang' : 'New website featuring a well-kept building entrance'} loading="lazy" /></div></figure>
  </div> : <div class="page-tree" aria-label={de ? 'Auszug aus der Seitenstruktur: eigene Seiten für Leistungen und Servicegebiete' : 'Site structure excerpt: dedicated pages for services and service areas'}>
    <div class="tree-root">
      <span class="tree-home-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="m3 10 9-7 9 7M5 9v12h14V9M10 21v-7h4v7"/></svg></span>
      <div><strong>HMS Loistl</strong><span>hms-loistl.de</span></div>
    </div>
    <div class="tree-branches">
      {[
        { title: de ? 'Leistungen' : 'Services', labels: de ? ['Gebäudereinigung', 'Außenpflege', 'Winterdienst'] : ['Building cleaning', 'Grounds care', 'Winter service'], area: false },
        { title: de ? 'Servicegebiete' : 'Service areas', labels: ['Bogenhausen', 'Grünwald', 'Solln'], area: true },
      ].map(group => <div class="tree-column">
        <div class="tree-label"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">{group.area ? <><path d="M19 10c0 5-7 11-7 11S5 15 5 10a7 7 0 1 1 14 0Z"/><circle cx="12" cy="10" r="2.5"/></> : <><rect x="4" y="4" width="6" height="6" rx="1"/><rect x="14" y="4" width="6" height="6" rx="1"/><rect x="4" y="14" width="6" height="6" rx="1"/><rect x="14" y="14" width="6" height="6" rx="1"/></>}</svg><span>{group.title}</span></div>
        <div class="tree-pages">{group.labels.map(label => <div class="page-node"><span class="page-icon" aria-hidden="true"></span><span>{label}</span></div>)}</div>
      </div>)}
    </div>
  </div>}

</div>
<style>
.study-visual{height:280px;padding:20px;background:#eee6f3;border-bottom:1px solid #ded4e5;overflow:hidden;box-sizing:border-box}
.motif-pair{display:grid;grid-template-columns:1fr 1fr;gap:12px;position:relative;height:100%;align-items:center}
.motif-pair figure,.work-pair figure{margin:0;min-width:0;position:relative}
.motif-image{height:193px;overflow:hidden;border-radius:12px;background:#d9d0df;box-shadow:0 8px 18px #39274414}
.old-motif img{width:100%;height:auto;display:block}
.new-motif img{width:100%;height:100%;object-fit:cover;object-position:85% center;display:block}

.motif-arrow{position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);display:grid;place-items:center;width:32px;height:32px;border-radius:50%;background:#745188;color:#fff;z-index:1;font-size:22px}
.motif-arrow svg{display:block;width:20px;height:20px}.work-evidence{height:100%;display:flex;align-items:center}.work-pair{width:100%}
.study-visual--tree{display:grid;align-items:center}
.page-tree{width:100%;display:flex;flex-direction:column;align-items:center}
.tree-root{position:relative;display:flex;align-items:center;gap:10px;padding:9px 18px;border-radius:12px;background:#745188;color:#fffdf9;box-shadow:0 5px 14px #39274415}
.tree-home-icon{display:grid;place-items:center;width:30px;height:30px;border:1px solid #ffffff40;border-radius:8px}.tree-home-icon svg{width:19px;height:19px}
.tree-root strong{display:block;font-size:13px;font-weight:600;line-height:1.3}.tree-root div>span{display:block;font-size:9px;color:#e4d7ed;margin-top:2px}
.tree-root:after{content:'';position:absolute;left:50%;top:100%;height:16px;border-left:1px solid #ac92be}
.tree-branches{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:24px;width:100%;padding-top:30px;position:relative}
.tree-branches:before{content:'';position:absolute;left:8px;right:calc(50% - 20px);top:16px;height:14px;border:1px solid #ac92be;border-bottom:0;border-radius:7px 7px 0 0}
.tree-column{min-width:0;position:relative}
.tree-label{display:flex;gap:6px;align-items:center;justify-content:flex-start;font-size:12px;line-height:1.3;color:#57415f;font-weight:600;margin-bottom:10px}
.tree-label svg{width:16px;height:16px;flex-shrink:0;color:#9670af}
.tree-pages{position:relative;display:grid;gap:6px;padding-left:18px}

.page-node{position:relative;display:flex;align-items:center;gap:7px;min-height:34px;padding:7px 9px;background:#fffdf9;border:1px solid #d8c9e1;border-radius:7px;font-size:11px;line-height:1.25;color:#45354f;box-shadow:0 2px 4px #39274406}
.page-node:before{content:'';position:absolute;width:10px;right:100%;top:50%;border-top:1px solid #ac92be}
.page-node:after{content:'';position:absolute;left:-11px;top:-7px;bottom:-1px;border-left:1px solid #ac92be}
.page-node:first-child:after{top:-11px}
.page-node:last-child:after{bottom:50%}
.page-node>span:last-child{min-width:0;overflow-wrap:anywhere}
.page-icon{display:block;flex:0 0 10px;height:13px;border:1px solid #9a7daf;border-radius:2px;background:linear-gradient(#cfc0da,#cfc0da) 2px 4px/5px 1px no-repeat}
.work-pair{display:grid;grid-template-columns:1fr 1fr;gap:8px}.work-pair img{display:block;width:100%;height:184px;object-fit:cover;border-radius:10px}.work-pair figcaption{position:absolute;bottom:8px;left:8px;padding:4px 8px;border-radius:999px;background:#fffdf9ed;font-size:10px;color:#28232e}
@media(max-width:600px){.study-visual{height:290px;padding:20px}.motif-image{height:204px}.work-pair img{height:195px}.tree-branches{gap:16px}.tree-branches:before{left:8px;right:calc(50% - 16px)}.page-node{font-size:11px;padding:7px 6px}.study-visual--tree{height:auto;min-height:290px}}
</style>
