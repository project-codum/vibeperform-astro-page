---
import AgencyDocument from './AgencyDocument.astro';
import WebsiteServicePage from './WebsiteServicePage.astro';
import { websiteServiceMeta, websiteServiceRoutes, websiteServiceIndexable } from '../data/websiteServiceContent';
interface Props { locale:'de'|'en'; }
const {locale}=Astro.props;
const meta=websiteServiceMeta[locale];
---
<AgencyDocument locale={locale} title={meta.title} description={meta.description} path={websiteServiceRoutes[locale]} alternatePath={websiteServiceRoutes[locale==='de'?'en':'de']} service noindex={!websiteServiceIndexable}>
  <WebsiteServicePage locale={locale}/>
</AgencyDocument>
