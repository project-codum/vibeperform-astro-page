---
import { designStudies } from '../data/designStudies';
import type { Locale } from '../lib/siteMetadata';

interface Props { locale: Locale; }
const { locale } = Astro.props;
const de = locale === 'de';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const studies = designStudies(locale);
const start = 0;
const offsetFrom = (index: number, center: number) => ((index - center + 2 + studies.length) % studies.length) - 2;
const image = (id: string) => `${base}studien/hero-kmu/${id}.webp`;
const openLabel = de ? 'Studie im Vollbild öffnen' : 'Open study in full screen';
---
<section class="design-studies" id="designstudien" aria-labelledby="design-studies-title" data-design-studies data-start={start}>
  <header class="design-studies__heading">
    <h2 id="design-studies-title">{de ? 'Maßgeschneiderte Designs für dich' : 'Tailored designs for you'}</h2>
  </header>

  <div class="design-studies__carousel" role="group" aria-label={de ? 'Designstudien durchblättern' : 'Browse design studies'} tabindex="0" data-stage>
    <div class="design-studies__stage" data-swipe>
      {studies.map((study, index) => (
        <article class="design-studies__card" data-card data-index={index} data-offset={offsetFrom(index, start)} data-active={index === start ? 'true' : 'false'}>
          <a class="design-studies__card-link" href={`${base}studien/hero-kmu/${study.id}.html`} data-select data-title={study.trade}
            aria-label={`${study.trade}: ${openLabel}`} tabindex={index === start ? undefined : '-1'}>
            <div class="design-studies__thumbnail">
              <template><img src={image(study.id)} alt={`${study.imageTitle} – ${study.detail}`} width="720" height="405" decoding="async" draggable="false" /></template>
            </div>
            <div class="design-studies__card-body">
              <h3>{study.trade}</h3>
              <p class="design-studies__description">{study.detail}</p>
              <span class="design-studies__expand" aria-hidden="true">↗</span>
            </div>
          </a>
        </article>
      ))}
    </div>
    <button class="design-studies__arrow design-studies__arrow--prev" type="button" data-prev aria-label={de ? 'Vorherige Designstudie' : 'Previous design study'}>
      <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="m15 5-7 7 7 7" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </button>
    <button class="design-studies__arrow design-studies__arrow--next" type="button" data-next aria-label={de ? 'Nächste Designstudie' : 'Next design study'}>
      <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="m9 5 7 7-7 7" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </button>
  </div>

  <div class="design-studies__hint" aria-hidden="true">
    <span></span>{de ? 'zum Durchblättern' : 'swipe to browse'}<span></span>
  </div>
  <div class="design-studies__dots" role="group" aria-label={de ? 'Designstudie auswählen' : 'Choose a design study'}>
    {studies.map((study, index) => (
      <button type="button" data-dot data-index={index} aria-label={`${index + 1}. ${study.trade}`} aria-current={index === start ? 'true' : undefined}><span></span></button>
    ))}
  </div>
  <p class="design-studies__visually-hidden" aria-live="polite" aria-atomic="true" data-status></p>
  <noscript>
    <ul>{studies.map(study => <li><a href={`${base}studien/hero-kmu/${study.id}.html`}>{study.imageTitle} – {study.detail}</a></li>)}</ul>
  </noscript>
  <dialog class="design-studies__dialog" aria-labelledby="design-studies-dialog-title" data-dialog>
    <div class="design-studies__dialog-bar">
      <div><p>{de ? 'Designstudie · kein Kundenprojekt' : 'Design study · not a client project'}</p><h3 id="design-studies-dialog-title" data-dialog-title></h3></div>
      <form method="dialog"><button type="submit" aria-label={de ? 'Vorschau schließen' : 'Close preview'} autofocus>×</button></form>
    </div>
    <iframe data-study-frame title={de ? 'Interaktive Designstudie' : 'Interactive design study'}></iframe>
    <form class="design-studies__return" method="dialog"><button type="submit">{de ? '← Zur Studienübersicht' : '← Back to studies'}</button></form>
  </dialog>
</section>

<script>
  const setup = (root: HTMLElement) => {
    if (root.dataset.ready) return;
    root.dataset.ready = 'true';
    const cards = [...root.querySelectorAll<HTMLElement>('[data-card]')];
    const dots = [...root.querySelectorAll<HTMLButtonElement>('[data-dot]')];
    const stage = root.querySelector<HTMLElement>('[data-stage]');
    const swipe = root.querySelector<HTMLElement>('[data-swipe]');
    const status = root.querySelector<HTMLElement>('[data-status]');
    const dialog = root.querySelector<HTMLDialogElement>('[data-dialog]');
    const dialogTitle = root.querySelector<HTMLElement>('[data-dialog-title]');
    const frame = root.querySelector<HTMLIFrameElement>('[data-study-frame]');
    const narrow = matchMedia('(max-width: 650px)');
    let galleryVisible = false;
    function loadVisibleImages() {
      if (!galleryVisible) return;
      const radius = narrow.matches ? 1 : 2;
      for (const card of cards) {
        if (Math.abs(Number(card.dataset.offset)) > radius) continue;
        const template = card.querySelector('template');
        if (template) template.replaceWith(template.content.cloneNode(true));
      }
    }
    if (swipe && 'IntersectionObserver' in window) {
      const observer = new IntersectionObserver(([entry]) => {
        galleryVisible = entry.isIntersecting;
        loadVisibleImages();
      });
      observer.observe(swipe);
    } else {
      galleryVisible = true;
    }
    narrow.addEventListener('change', loadVisibleImages);
    const language = document.documentElement.lang;
    const german = language === 'de';
    const length = cards.length;
    let active = Number(root.dataset.start);
    let down: { x: number; y: number } | undefined;
    let suppressClickUntil = 0;

    function show(index: number, announce = true) {
      active = (index + length) % length;
      cards.forEach((card, n) => {
        const offset = ((n - active + 2 + length) % length) - 2;
        const selected = n === active;
        card.dataset.offset = String(offset);
        card.dataset.active = String(selected);
        const link = card.querySelector<HTMLAnchorElement>('[data-select]');
        if (!link) return;
        link.tabIndex = selected ? 0 : -1;
        if (selected) link.setAttribute('aria-current', 'true'); else link.removeAttribute('aria-current');
      });
      loadVisibleImages();
      dots.forEach((dot, n) => {
        if (n === active) dot.setAttribute('aria-current', 'true'); else dot.removeAttribute('aria-current');
      });
      if (announce && status) status.textContent = `${cards[active].querySelector('h3')?.textContent}, ${active + 1} ${german ? 'von' : 'of'} ${length}`;
    }

    const motion = matchMedia('(prefers-reduced-motion: no-preference)');
    if (swipe && length > 4 && motion.matches && 'IntersectionObserver' in window) {
      // Vary the opening card so every study can be the last one in the preview.
      active = Math.floor(Math.random() * length);
      let remaining = Math.random() < .5 ? 3 : 4;
      let timer: number | undefined;
      const listeners = new AbortController();
      const stop = () => {
        window.clearTimeout(timer);
        observer.disconnect();
        listeners.abort();
        root.removeAttribute('data-preview-running');
      };
      const advance = () => {
        if (listeners.signal.aborted || document.hidden || !root.isConnected) return stop();
        show(active + 1, false);
        remaining -= 1;
        timer = remaining ? window.setTimeout(advance, 270) : window.setTimeout(stop, 220);
      };
      const observer = new IntersectionObserver(([entry]) => {
        if (entry.intersectionRatio >= .5 && timer === undefined && !document.hidden) {
          root.setAttribute('data-preview-running', '');
          timer = window.setTimeout(advance, 160);
        } else if (!entry.isIntersecting && timer !== undefined) {
          stop();
        }
      }, { threshold: [0, .5] });
      const options = { signal: listeners.signal };
      for (const event of ['pointerdown', 'focusin', 'click', 'keydown']) {
        root.addEventListener(event, stop, { ...options, capture: true });
      }
      motion.addEventListener('change', stop, options);
      document.addEventListener('visibilitychange', () => {
        if (document.hidden && timer !== undefined) stop();
        else if (!document.hidden && timer === undefined) {
          observer.unobserve(swipe);
          observer.observe(swipe);
        }
      }, options);
      window.addEventListener('pagehide', stop, options);
      observer.observe(swipe);
    }
    show(active, false);
    root.querySelector('[data-prev]')?.addEventListener('click', () => show(active - 1));
    root.querySelector('[data-next]')?.addEventListener('click', () => show(active + 1));
    dots.forEach((dot, n) => dot.addEventListener('click', () => show(n)));
    cards.forEach((card, n) => card.querySelector<HTMLAnchorElement>('[data-select]')?.addEventListener('click', (event) => {
      if (performance.now() < suppressClickUntil) { event.preventDefault(); return; }
      if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
      const link = event.currentTarget as HTMLAnchorElement;
      if (!dialog?.showModal || !dialogTitle || !frame) return;
      event.preventDefault();
      dialogTitle.textContent = link.dataset.title ?? '';
      show(n, false);
      frame.title = link.getAttribute('aria-label') ?? dialogTitle.textContent;
      frame.src = link.href;
      dialog.showModal();

    }));

    root.addEventListener('keydown', (event) => {
      if (dialog?.open || !['ArrowLeft','ArrowRight','Home','End'].includes(event.key)) return;
      const wasCard = event.target instanceof HTMLElement && Boolean(event.target.closest('[data-card]'));
      const supportedTarget = event.target instanceof HTMLElement && Boolean(event.target.closest('[data-stage], [data-dot]'));
      if (!supportedTarget || event.altKey || event.metaKey || event.ctrlKey) return;
      event.preventDefault();
      show(event.key === 'Home' ? 0 : event.key === 'End' ? length - 1 : active + (event.key === 'ArrowLeft' ? -1 : 1));
      if (wasCard) cards[active].querySelector<HTMLAnchorElement>('[data-select]')?.focus({preventScroll: true});
    });
    swipe?.addEventListener('pointerdown', (event) => {
      if (event.pointerType !== 'touch' && event.pointerType !== 'pen') return;
      down = {x: event.clientX, y: event.clientY};
    });
    swipe?.addEventListener('pointerup', (event) => {
      if (!down) return;
      const dx = event.clientX - down.x, dy = event.clientY - down.y;
      down = undefined;
      if (Math.abs(dx) > 42 && Math.abs(dx) > 1.4 * Math.abs(dy)) {
        suppressClickUntil = performance.now() + 400;
        show(active + (dx < 0 ? 1 : -1));
      }
    });
    swipe?.addEventListener('pointercancel', () => { down = undefined; });
    frame?.addEventListener('load', () => {
      if (!dialog?.open) return;
      const doc = frame.contentDocument;
      const navigation = doc?.querySelector<HTMLElement>('[data-study-navigation]');
      if (navigation) navigation.hidden = true;
      doc?.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') { event.preventDefault(); dialog.close(); }
      });
    });
    dialog?.addEventListener('close', () => {
      frame?.removeAttribute('src');
      cards[active].querySelector<HTMLAnchorElement>('[data-select]')?.focus({preventScroll: true});
    });
    dialog?.addEventListener('click', (event) => { if (event.target === dialog) dialog.close(); });
  };
  document.querySelectorAll<HTMLElement>('[data-design-studies]').forEach(setup);
</script>

<style>
  .design-studies {
    --study-lilac: #d7b5ff;
    position: relative;
    isolation: isolate;
    width: min(calc(100% - clamp(1rem, 8vw, 7rem)), 86rem);
    margin: 0 auto;
    padding: clamp(1.85rem, 5vw, 4.25rem) 0 clamp(1rem, 3vw, 2rem);
    background: transparent;
    color: #fcf9fe;
    overflow: clip;
    scroll-margin-top: 6rem;
  }
  .design-studies__heading { text-align: center; padding: 0 1.15rem; position: relative; z-index: 2; }
  .design-studies h2 { margin: 0 auto; max-width: 43ch; font-weight: 530; font-size: clamp(1.5rem, 3.9vw, 3.3rem); line-height: 1.05; letter-spacing: -.052em; text-wrap: balance; }
  .design-studies__carousel { position: relative; margin: clamp(.9rem, 3vw, 2.6rem) 0 0; }
  .design-studies__stage { position: relative; touch-action: pan-y; height: clamp(17rem, 36vw, 28.5rem); }
  /* Backlight is anchored to the card silhouette, not painted on its frame.
     The link stays opaque; the broad light spills onto the scenery behind it. */
  .design-studies__stage::before {
    content: ''; position: absolute; pointer-events: none;
    left: 50%; top: 50%; transform: translate(-50%, -50%);
    width: min(59%, 42rem); height: 129%;
    mask-image: radial-gradient(ellipse closest-side, black 52%, #000e 69%, #0007 86%, transparent 100%);
    background:
      radial-gradient(ellipse 44% 34% at 35% 24%, #a24af2 0%, #9243ebc2 38%, transparent 100%),
      radial-gradient(ellipse 42% 38% at 70% 25%, #6660ff 0%, #5358e5a1 44%, transparent 100%),
      radial-gradient(ellipse 49% 30% at 67% 79%, #ae74fb 0%, #8846efa8 48%, transparent 100%),
      radial-gradient(ellipse 37% 37% at 27% 74%, #655ffc 0%, #555bd480 46%, transparent 100%);
    filter: blur(clamp(9px, 1.3vw, 20px)); opacity: .95;
  }

  /* Layer only the lateral spill over the neighbors. The opaque active
     card covers its center, so neither the frame nor its contents light up. */
  .design-studies__stage::after {
    content: ''; position: absolute; z-index: 3; pointer-events: none;
    inset: 0 auto; left: 50%; transform: translateX(-50%);
    width: min(62%, 44rem);
    background:
      radial-gradient(ellipse 24% 43% at 20% 47%, #915bf689 0%, #7b4cf143 44%, transparent 100%),
      radial-gradient(ellipse 24% 46% at 80% 53%, #9a73fc82 0%, #6b66f44f 43%, transparent 100%);
    filter: blur(clamp(7px, 1vw, 15px));
  }
  .design-studies__card {
    position: absolute; top: 50%; left: 50%;
    width: min(38.5%, 27rem); margin: 0; transform-origin: center;
    transform: translate(-50%, -50%) translateX(var(--study-x, 0%)) translateY(var(--study-y, 0%)) scale(var(--study-scale, 1));
    z-index: var(--study-depth, 4);
    opacity: var(--study-opacity, 1);
    transition: transform .38s cubic-bezier(.22,.7,.28,1), opacity .3s ease;
  }
  .design-studies__card:not([data-offset="-2"], [data-offset="-1"], [data-offset="0"], [data-offset="1"], [data-offset="2"]) {
    opacity: 0; visibility: hidden; pointer-events: none;
  }
  [data-preview-running] .design-studies__card { transition-duration: .21s, .17s; }
  .design-studies__card[data-offset="-2"] { --study-x: -162%; --study-y: 9%; --study-scale: .76; --study-opacity: .86; --study-depth: 1; }
  .design-studies__card[data-offset="-1"] { --study-x: -91%; --study-y: 7%; --study-scale: .845; --study-depth: 2; }
  .design-studies__card[data-offset="1"]  { --study-x: 91%; --study-y: 7%; --study-scale: .845; --study-depth: 2; }
  .design-studies__card[data-offset="2"]  { --study-x: 162%; --study-y: 9%; --study-scale: .76; --study-opacity: .86; --study-depth: 1; }
  .design-studies__card-link {
    position: relative; display: block; text-decoration: none; color: inherit;
    background: #151218; border: 1px solid #43384d; border-radius: .82rem; overflow: hidden;
    box-shadow: 0 .5rem 1.5rem #0006; transition: border-color .25s, box-shadow .25s;
  }
  /* The active selection ring is independent of keyboard focus. */
  .design-studies__card[data-active="true"]::after {
    content: ''; position: absolute; inset: -5px; pointer-events: none;
    border: 2px solid #e6caff; border-radius: calc(.82rem + 5px);
  }
  .design-studies__card-link:hover { border-color: #ba9ae5; }
  .design-studies__card[data-active="true"] .design-studies__card-link { border-color: #100e14; box-shadow: 0 1rem 2.15rem #0009; }
  .design-studies__thumbnail { aspect-ratio: 16 / 9; background: #151218; }
  .design-studies__card-link img {
    width: 100%; aspect-ratio: 16 / 9; display: block; height: auto; object-fit: cover; object-position: top;
    background: #09080b; border: 4px solid #09080b; border-radius: .78rem .78rem .34rem .34rem;
  }
  .design-studies__card-body { position: relative; min-height: clamp(5.6rem, 12vw, 8rem); padding: .72rem 2.25rem .76rem .86rem; }
  .design-studies__card-body h3 { margin: 0; font-size: clamp(1.125rem, 2vw, 1.55rem); line-height: 1.18; font-weight: 700; letter-spacing: -.025em; overflow-wrap: anywhere; hyphens: auto; }
  .design-studies__description { margin: .47rem 0 0; line-height: 1.4; font-size: 1rem; color: #fff; }
  .design-studies__expand { position: absolute; top: .64rem; right: .85rem; color: var(--study-lilac); font-size: 1.1rem; line-height: 1; }
  .design-studies__arrow {
    z-index: 5; position: absolute; top: 50%; transform: translateY(-44%); display: grid; place-items: center;
    inline-size: 2.65rem; block-size: 2.65rem; padding: 0; border: 1px solid #baa0e44d;
    border-radius: 50%; color: var(--study-lilac); background: #17121ee8; cursor: pointer;
    transition: background .2s, border-color .2s;
  }
  .design-studies__arrow:hover { border-color: #bd9ef0; background: #34234a; }
  .design-studies__arrow svg { width: 1.4rem; height: 1.4rem; }
  .design-studies__arrow--prev { left: clamp(.3rem, 1.5vw, 1.5rem); }
  .design-studies__arrow--next { right: clamp(.3rem, 1.5vw, 1.5rem); }
  .design-studies__hint { position: relative; display: flex; align-items: center; justify-content: center; gap: .58rem; margin: .26rem 0 .28rem; color: #f7efff; font-size: .9375rem; font-weight: 700; }
  .design-studies__hint span { width: min(15%, 8rem); height: 1px; background: #b58fe7; opacity: .75; }
  .design-studies__hint span:first-child::before, .design-studies__hint span:last-child::after { content:''; width: .37rem; height: .37rem; border: solid #b58fe7; border-width: 1px 0 0 1px; display: block; position: relative; top: -.14rem; transform: rotate(-45deg); }
  .design-studies__hint span:last-child::after { margin-left: auto; transform: rotate(135deg); }
  .design-studies__dots { display: flex; flex-wrap: wrap; justify-content: center; position: relative; max-width: 100%; margin-inline: auto; }
  .design-studies__dots button { display: grid; place-items: center; width: 2rem; height: 2rem; border: none; background: transparent; padding: 0; cursor: pointer; }
  .design-studies__dots button span { display: block; width: .44rem; height: .44rem; border-radius: 50%; background: #82728f; }
  .design-studies__dots button[aria-current="true"] span { background: #f1dfff; box-shadow: 0 0 .8rem #af75ff; }
  .design-studies :is(button, a, [data-stage]):focus-visible { outline: 2px solid #e6caff; outline-offset: 3px; }
  .design-studies__card[data-active="true"] .design-studies__card-link:focus-visible {
    outline-offset: 8px;
  }
  .design-studies [data-stage]:focus-visible { outline-offset: -3px; }
  .design-studies__visually-hidden { position: absolute; overflow: hidden; clip: rect(0, 0, 0, 0); width: 1px; height: 1px; margin: -1px; }
  .design-studies__dialog {
    position: fixed; inset: 0; width: 100%; height: 100%; height: 100dvh;
    max-width: none; max-height: none; box-sizing: border-box; padding: 0; margin: 0;
    border: 0; background: #1a1422; color: #fff; overflow: hidden;
  }
  .design-studies__dialog[open] { display: grid; grid-template-rows: auto minmax(0,1fr) auto; }
  :global(html:has(.design-studies__dialog[open])) { overflow: hidden; }
  .design-studies__dialog::backdrop { background: #100916dc; }
  .design-studies__dialog-bar { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: .7rem 1rem; }
  .design-studies__dialog-bar p { margin: 0; font-size: .9375rem; color: #f7efff; }
  .design-studies__dialog-bar h3 { margin: .15rem 0 0; font-size: 1.25rem; font-weight: 700; }
  .design-studies__dialog-bar button { width: 2.65rem; height: 2.65rem; display: grid; place-items: center; border: 1px solid #795792; border-radius: 50%; background: #271d32; color: #fff; font-size: 1.4rem; cursor: pointer; }
  .design-studies__return { padding: .4rem 1rem max(.4rem, env(safe-area-inset-bottom)); }
  .design-studies__return button { min-height: 44px; padding: 0 .5rem; background: transparent; color: #fff; border: 0; text-decoration: underline; cursor: pointer; }
  @media (scripting: none) {
    .design-studies__carousel, .design-studies__dots, .design-studies__hint { display: none; }
  }
  .design-studies__dialog iframe { display: block; width: 100%; height: 100%; border: 0; background: #fff; }
  @media (max-width: 650px) {
    .design-studies { width: calc(100% - 1.25rem); }
    .design-studies__stage { height: clamp(16.5rem, 76vw, 23rem); }
    .design-studies__stage::before { width: 105%; height: 123%; }
    .design-studies__stage::after { width: 112%; }
    .design-studies__card { width: 71%; }
    .design-studies__card[data-offset="-1"] { --study-x: -83%; --study-scale: .83; }
    .design-studies__card[data-offset="1"] { --study-x: 83%; --study-scale: .83; }
    .design-studies__card[data-offset="-2"], .design-studies__card[data-offset="2"] { opacity: 0; visibility: hidden; }
    .design-studies__arrow { width: 2.75rem; height: 2.75rem; }
    .design-studies__card-body { padding-left: .68rem; min-height: 6.5rem; }
    .design-studies__dots { max-width: min(100%, 19rem); }
    .design-studies__dots button { width: 1.5rem; height: 1.5rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    .design-studies *, .design-studies *::before, .design-studies *::after { transition: none !important; }
  }
</style>
