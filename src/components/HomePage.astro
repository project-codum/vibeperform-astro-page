---
import HomeNavigation from './HomeNavigation.astro';
import HomeHero from './HomeHero.astro';
import { homeIntroContent } from '../data/homeIntroContent';
import { homePageContent } from '../data/homePageContent';
import { bookingUrl, contactEmail, type Locale } from '../lib/siteMetadata';
import '../styles/home-page.css';

interface Props { currentLocale: Locale; alternateLocaleHref: string; }
const { currentLocale: locale, alternateLocaleHref } = Astro.props;
const t = homePageContent[locale];
const base = (import.meta.env.BASE_URL ?? '/').replace(/\/$/, '');
const href = (path: string) => path.startsWith('#') ? path : `${base}${path}`;
---
<div class="home-shell" id="top">
  <HomeNavigation copy={homeIntroContent[locale]} locale={locale} alternateLocaleHref={alternateLocaleHref} />
  <main class="home-main">
    <HomeHero copy={homeIntroContent[locale]} />

    <section class="hp-section hp-problems" id="home-next" tabindex="-1" aria-labelledby="problems-title" data-analytics-section="home-problems">
      <div class="hp-wrap hp-split">
        <div class="hp-heading">
          <p class="hp-kicker">{t.problems.kicker}</p>
          <h2 id="problems-title">{t.problems.title}<br /><em>{t.problems.emphasis}</em></h2>
          <p class="hp-intro">{t.problems.intro}</p>
        </div>
        <div class="hp-editorial-list">
          {t.problems.items.map(item => <article><span class="hp-label">{item.label}</span><h3>{item.title}</h3><p>{item.body}</p></article>)}
        </div>
      </div>
    </section>

    <section class="hp-section hp-services" id="leistungen" aria-labelledby="services-title" data-analytics-section="home-services">
      <div class="hp-wrap">
        <div class="hp-section-heading"><div><p class="hp-kicker">{t.services.kicker}</p><h2 id="services-title">{t.services.title}<br /><em>{t.services.emphasis}</em></h2></div><p class="hp-intro">{t.services.intro}</p></div>
        <div class="hp-service-grid">
          {t.services.items.map(item => <article><span class="hp-number">{item.number}</span><h3>{item.title}</h3><p>{item.body}</p><p class="hp-tags">{item.tags}</p><a class="hp-text-link" href={href(item.href)}>{item.link}<span aria-hidden="true">↗</span></a></article>)}
        </div>
        <aside class="hp-extra"><p>{t.services.extra}</p><a class="hp-text-link" href={href(t.services.extraHref)}>{t.services.extraLink}<span aria-hidden="true">↗</span></a></aside>
      </div>
    </section>

    <section class="hp-section hp-evolution" id="weiterentwicklung" aria-labelledby="evolution-title" data-analytics-section="home-evolution">
      <div class="hp-wrap hp-split">
        <div class="hp-heading"><p class="hp-kicker">{t.evolution.kicker}</p><h2 id="evolution-title">{t.evolution.title}<br /><em>{t.evolution.emphasis}</em></h2><p class="hp-intro">{t.evolution.intro}</p><p>{t.evolution.body}</p></div>
        <div class="hp-cycle"><ol>{t.evolution.steps.map((step,i) => <li><span class="hp-cycle-number" aria-hidden="true">0{i+1}</span><div><h3>{step.title}</h3><p>{step.body}</p></div></li>)}</ol><p class="hp-cycle-note">{t.evolution.note}</p></div>
      </div>
    </section>

    <section class="hp-section hp-process" id="zusammenarbeit" aria-labelledby="process-title" data-analytics-section="home-process">
      <div class="hp-wrap"><p class="hp-kicker">{t.process.kicker}</p><h2 id="process-title">{t.process.title}<br /><em>{t.process.emphasis}</em></h2><ol class="hp-process-grid">{t.process.items.map((item,i) => <li><span class="hp-label">0{i+1}</span><h3>{item.title}</h3><p>{item.body}</p></li>)}</ol></div>
    </section>

    <section class="hp-section hp-faq" aria-labelledby="faq-title">
      <div class="hp-wrap hp-split"><div><p class="hp-kicker">{t.faq.kicker}</p><h2 id="faq-title">{t.faq.title}<br /><em>{t.faq.emphasis}</em></h2></div><div>{t.faq.items.map(item => <details><summary>{item.question}<span aria-hidden="true">＋</span></summary><p>{item.answer}</p></details>)}</div></div>
    </section>

    <section class="hp-section hp-contact" id="kontakt" aria-labelledby="contact-title" data-analytics-section="home-contact">
      <div class="hp-wrap"><p class="hp-kicker">{t.contact.kicker}</p><h2 id="contact-title">{t.contact.title}<br /><em>{t.contact.emphasis}</em></h2><p class="hp-intro">{t.contact.body}</p><div class="hp-contact-actions"><a class="hp-button" href={bookingUrl} data-analytics-event="contact_start" data-analytics-name="book-discovery-call" data-analytics-location="home-contact">{t.contact.booking}<span aria-hidden="true">↗</span></a><a class="hp-text-link" href={`mailto:${contactEmail}`} data-analytics-event="contact_start" data-analytics-name="email" data-analytics-location="home-contact">{t.contact.email}<span aria-hidden="true">↗</span></a></div><p class="hp-contact-note">{t.contact.note}</p></div>
    </section>
  </main>

  <footer class="hp-footer"><div class="hp-wrap"><div class="hp-footer-top"><div><a class="hp-footer-brand" href={`${base}/${locale}/`} aria-label={homeIntroContent[locale].homeLabel}><img src={`${base}/vibeperform-logo.png`} alt="VibePerform" width="505" height="214" loading="lazy" /></a><p>{t.footer.tagline}</p></div><nav aria-label={locale==='de'?'Footernavigation':'Footer navigation'}><a href="#leistungen">{t.footer.services}</a><a href="#zusammenarbeit">{t.footer.process}</a><a href={href(t.footer.aboutHref)}>{t.footer.about}</a><a href={`mailto:${contactEmail}`}>{contactEmail}</a></nav></div><div class="hp-footer-bottom"><span>© {new Date().getFullYear()} VibePerform. {t.footer.rights}</span><div><a href={href(t.footer.legalHref)}>{t.footer.legal}</a><a href={href(t.footer.privacyHref)}>{t.footer.privacy}</a><a href="#top">{t.footer.top} ↑</a></div></div></div></footer>
</div>
