---
interface Props { pauseLabel: string; resumeLabel: string; }
const { pauseLabel, resumeLabel } = Astro.props;
---
<vf-fluid-background class="vf-fluid">
  <div class="vf-poster" aria-hidden="true"></div>
  <canvas aria-hidden="true"></canvas>
  <button class="vf-motion" type="button" hidden aria-pressed="false" data-pause={pauseLabel} data-resume={resumeLabel}>{pauseLabel}</button>
</vf-fluid-background>
<script>
  class FluidBackground extends HTMLElement {
    private controller: { toggle(): void; destroy(): void } | null = null;
    private generation = 0;
    private firstFrame = 0;
    private secondFrame = 0;
    private idle: number | null = null;
    private motion = matchMedia('(prefers-reduced-motion: reduce)');
    private toggle = () => this.controller?.toggle();
    private schedule = () => {
      if (this.controller || !this.isConnected || this.motion.matches) return;
      const generation = ++this.generation;
      // Let the real page paint before importing and compiling decoration.
      this.firstFrame = requestAnimationFrame(() => {
        this.secondFrame = requestAnimationFrame(() => {
          const start = () => {
            if (this.isConnected && generation === this.generation && !this.motion.matches) void this.mount(generation);
          };
          if ('requestIdleCallback' in window) this.idle = window.requestIdleCallback(start, { timeout: 1200 });
          else start();
        });
      });
    };
    connectedCallback() {
      this.motion.addEventListener('change', this.schedule);
      this.schedule();
    }
    private async mount(generation: number) {
      const canvas = this.querySelector('canvas')!;
      const button = this.querySelector('button')!;
      try {
        const { mountFluid } = await import('../lib/homeFluid.js');
        if (!this.isConnected || generation !== this.generation || this.motion.matches) return;
        this.controller = mountFluid(canvas, { onState: ({ available, paused }) => {
          button.hidden = !available;
          button.setAttribute('aria-pressed', String(paused));
          button.textContent = paused ? button.dataset.resume! : button.dataset.pause!;
        }});
        button.addEventListener('click', this.toggle);
      } catch { /* The CSS poster remains visible if loading fails. */ }
    }
    disconnectedCallback() {
      this.generation++;
      cancelAnimationFrame(this.firstFrame);
      cancelAnimationFrame(this.secondFrame);
      if (this.idle !== null) window.cancelIdleCallback(this.idle);
      this.motion.removeEventListener('change', this.schedule);
      this.querySelector('button')?.removeEventListener('click', this.toggle);
      this.controller?.destroy(); this.controller = null;
    }
  }
  if (!customElements.get('vf-fluid-background')) customElements.define('vf-fluid-background', FluidBackground);
</script>
