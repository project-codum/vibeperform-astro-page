---
import AgencyDocument from './AgencyDocument.astro';
import AgencyContact from './AgencyContact.astro';
import { serviceContent, servicePaths } from '../data/serviceContent';
import { websiteCreationContent } from '../data/websiteCreationContent';
import { detailPaths } from '../data/serviceDetails';
import type { Locale } from '../lib/siteMetadata';
import '../styles/website-creation.css';
interface Props { locale: Locale; version?: 1 | 2; preview?: boolean; }
const { locale, preview = false } = Astro.props;
const de = locale === 'de';
const c = websiteCreationContent[locale];
const t = serviceContent[locale].website;
const base = (import.meta.env.BASE_URL ?? '/').replace(/\/$/, '');
const path = servicePaths[locale].website;
const shot = (name: string) => `${base}/case-studies/loistl/${name}.webp`;
---
<AgencyDocument locale={locale} title={t.title} description={t.description} path={path} alternatePath={servicePaths[de ? 'en' : 'de'].website} service preview={preview}>
  {preview && <div class="wc-preview"><span>{de ? 'Entwurf · Webseitenerstellung' : 'Preview · Website creation'}</span><a href={`${base}${path}#umfang`}>{de ? 'Zur Leistungsseite' : 'View service page'} ↗</a></div>}
  <section class="sv-hero wc-hero" aria-labelledby="home-title">
    <div class="hp-wrap" id="home-intro" tabindex="-1">
      <nav class="sv-breadcrumb" aria-label={de ? 'Seitenpfad' : 'Breadcrumb'}><a href={`${base}${servicePaths[locale].overview}`}>{de ? 'Leistungen' : 'Services'}</a><span aria-hidden="true">/</span><span>{de ? 'Webseite erstellen lassen' : 'Website design & development'}</span></nav>
      <div class="wc-hero-grid">
        <div><h1 id="home-title">{c.headline}<br/><em>{c.emphasis}</em></h1><p class="sv-lead">{c.intro}</p><div class="wc-actions"><a class="hp-button" href="#kontakt">{c.primary}<span aria-hidden="true">↓</span></a><a class="hp-text-link" href="#ablauf">{c.secondary}<span aria-hidden="true">↓</span></a></div></div>
        <figure class="wc-project"><div class="wc-browser-bar"><span aria-hidden="true">● ● ●</span><span>hms-loistl.de</span></div><img src={shot('after-desktop')} width="1440" height="1000" fetchpriority="high" alt={de ? 'Die von VibePerform gestaltete HMS-Loistl-Webseite mit hellem Hauseingang und dem Text Ihre Immobilien. Persönlich gepflegt.' : 'The HMS Loistl website designed by VibePerform, featuring a bright entrance and a clear property care message.'}/><figcaption>{c.exampleLabel}</figcaption></figure>
      </div>
    </div>
  </section>
  <section class="hp-section wc-proof" aria-labelledby="proof-title"><div class="hp-wrap wc-proof-grid"><h2 id="proof-title">{c.exampleTitle}</h2><div><p>{c.exampleBody}</p><a class="hp-text-link" href="https://www.hms-loistl.de/" target="_blank" rel="noopener noreferrer">{c.exampleLink}<span aria-hidden="true">↗</span></a></div></div></section>
  <section class="wc-process" id="ablauf" aria-labelledby="process-title">
    <header class="hp-section wc-process-heading"><div class="hp-wrap"><h2 id="process-title">{c.processTitle}<br/><em>{c.processEmphasis}</em></h2></div></header>
    <div id="umfang">
    {c.steps.map((step,i) => <article class={`hp-section wc-step wc-step-${i}`} aria-labelledby={`creation-step-${i}`}>
      <div class="hp-wrap wc-step-grid">
        <div class="wc-step-copy"><span class="wc-step-number" aria-hidden="true">0{i+1}</span><h3 id={`creation-step-${i}`}>{step.title}</h3><p>{step.body}</p><dl class="wc-responsibility"><div><dt>{c.yourPart}</dt><dd>{step.contribution}</dd></div><div><dt>{c.result}</dt><dd>{step.result}</dd></div></dl><details class="wc-detail"><summary>{c.detail}<span aria-hidden="true">＋</span></summary><p>{step.detail}</p></details></div>
        <div class="wc-step-visual">
          {i===0 && <figure class="wc-brief"><figcaption>{c.briefLabel}</figcaption><dl>{c.briefRows.map(([label,value]) => <div><dt>{label}</dt><dd>{value}</dd></div>)}</dl><div class="wc-brief-route" aria-hidden="true"><span>{de ? 'Betrieb' : 'Business'}</span><span>→</span><span>{de ? 'Inhalte' : 'Content'}</span><span>→</span><strong>{de ? 'Seitenplan' : 'Page plan'}</strong></div></figure>}
          {i===1 && <figure class="wc-image-choice"><div class="wc-entrance"><img src={shot('after-desktop')} width="1440" height="1000" loading="lazy" alt={de ? 'Der gepflegte Hauseingang als zentrales Motiv im neuen HMS-Loistl-Auftritt' : 'The well-kept entrance as the main image in the new HMS Loistl website'}/></div><figcaption><span>{c.imageLabel}</span><strong>{c.imageTitle}</strong><p>{c.imageBody}</p></figcaption></figure>}
          {i===2 && <figure class="wc-devices"><div class="wc-desktop"><div class="wc-browser-bar" aria-hidden="true"><span>● ● ●</span><span>hms-loistl.de</span></div><img src={shot('after-desktop')} width="1440" height="1000" loading="lazy" alt={de ? 'HMS-Loistl-Webseite auf einem breiten Bildschirm' : 'HMS Loistl website on a wide screen'}/></div><div class="wc-phone"><img src={shot('after-mobile')} width="390" height="844" loading="lazy" alt={de ? 'Die passende mobile Ansicht derselben Webseite' : 'The mobile layout of the same website'}/></div><figcaption>{c.deviceLabel}</figcaption></figure>}
        </div>
      </div>
    </article>)}
    </div>
  </section>
  <section class="hp-section wc-investment" aria-labelledby="investment-title"><div class="hp-wrap wc-investment-grid"><div><h2 id="investment-title">{c.investmentTitle}<br/><em>{c.investmentEmphasis}</em></h2><p class="hp-intro">{c.investmentBody}</p><a class="hp-text-link" href="#kontakt">{c.investmentLink}<span aria-hidden="true">↓</span></a></div><div class="wc-price"><span>{c.priceLabel}</span><strong>{c.price}</strong><p>{c.priceNote}</p></div></div></section>
  <section class="hp-section hp-faq" id="fragen" aria-labelledby="faq-title"><div class="hp-wrap hp-split"><h2 id="faq-title">{de ? 'Vor Ihrer' : 'Before your'}<br/><em>{de ? 'neuen Webseite.' : 'new website.'}</em></h2><div>{t.faq.items.map(item => <details><summary>{de ? item.question.replaceAll('Website','Webseite') : item.question}<span aria-hidden="true">＋</span></summary><p>{de ? item.answer.replaceAll('Website','Webseite') : item.answer}</p></details>)}</div></div></section>
  <aside class="wc-related hp-wrap" aria-label={c.relatedLabel}><span>{c.relatedLabel}</span><a href={`${base}${detailPaths[locale].support}`}>{c.support} ↗</a><a href={`${base}${t.trade.href}`}>{c.trade} ↗</a></aside>
  <AgencyContact locale={locale} copy={c.contact} showKicker={false}/>
</AgencyDocument>
