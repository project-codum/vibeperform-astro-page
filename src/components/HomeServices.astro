---
import SearchVisibilityVisual from './SearchVisibilityVisual.astro';
import { homePageContent } from '../data/homePageContent';
import type { Locale } from '../lib/siteMetadata';

interface Props { locale: Locale; }
const { locale } = Astro.props;
const seo = homePageContent[locale].seo;
const base = (import.meta.env.BASE_URL ?? '/').replace(/\/$/, '');
---
<section class="hp-section hp-services" id="leistungen" aria-labelledby="home-seo-title" data-analytics-section="home-services">
  <div class="hp-wrap hp-service-layout">
    <div class="home-seo-copy">
      <h2 id="home-seo-title">{seo.title}</h2>
      <p>{seo.body}</p>
    </div>
    <SearchVisibilityVisual locale={locale} />
    <a class="hp-text-link" href={`${base}${seo.href}`}>{seo.link}<span aria-hidden="true">↗</span></a>
  </div>
</section>

<style>
  .hp-services { background: var(--hp-paper); border-top: 1px solid var(--hp-line); }
  .hp-service-layout { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); grid-template-rows: 1fr auto auto 1fr; align-items: center; column-gap: clamp(2rem, 8vw, 6rem); }
  .home-seo-copy { grid-area: 2 / 1; }
  .hp-service-layout > :global(.search-visual) { grid-area: 1 / 2 / -1 / 3; }
  .hp-service-layout > a { grid-area: 3 / 1; justify-self: start; }
  .home-seo-copy p { margin: 1.5rem 0; max-width: 40ch; }
  @media (max-width: 700px) {
    .hp-service-layout { display: flex; flex-direction: column; align-items: stretch; gap: 1.5rem; }
    .home-seo-copy p { margin-bottom: 0; }
    .hp-service-layout > a { align-self: flex-start; margin: 0; }
  }
</style>
