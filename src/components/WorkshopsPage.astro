---
import AgencyDocument from './AgencyDocument.astro';
import AgencyContact from './AgencyContact.astro';
import { supplementalContent } from '../data/supplementalContent';
import '../styles/service-narrative.css';
import '../styles/supplemental-pages.css';
interface Props { currentLocale:'de'|'en'; }
const {currentLocale:locale}=Astro.props;
const de=locale==='de';
const c=supplementalContent[locale];
const t=c.workshops;
const base=(import.meta.env.BASE_URL??'/').replace(/\/$/,'');
---
<AgencyDocument locale={locale} title={de?'KI-Workshops | VibePerform':'AI workshops | VibePerform'} description={t.intro} path={`/${locale}/workshops/`} alternatePath={`/${de?'en':'de'}/workshops/`}>
 <section class="sv-hero sn-hero" aria-labelledby="home-title"><div class="hp-wrap" id="home-intro" tabindex="-1"><nav class="sv-breadcrumb" aria-label={de?'Seitenpfad':'Breadcrumb'}><a href={de?'/de/ki-strategie/':'/en/ai-strategy/'}>{c.label}</a><span aria-hidden="true">/</span><span>Workshops</span></nav><h1 id="home-title">{t.title}<br/><em>{t.emphasis}</em></h1><div class="sn-hero-bottom"><p class="sv-lead">{t.intro}</p><a class="hp-button" href="#formate">{de?'Formate ansehen':'View formats'}<span aria-hidden="true">↓</span></a></div></div></section>
 <section class="hp-section sp-formats" id="formate" aria-label={de?'Workshopformate':'Workshop formats'}><div class="hp-wrap">{t.formats.map((format,i)=><article class="sp-format"><div><span class="hp-label">0{i+1} / {format.title}</span><h2>{format.question}</h2><p>{format.body}</p><a class="hp-text-link" href={i===0?`${base}/${locale}/workshop/explore-workshop/`:'#kontakt'}>{format.link}<span aria-hidden="true">↗</span></a></div><div class="sp-format-result"><span>{de?'Damit arbeiten Sie weiter':'What you take forward'}</span><p>{format.outcome}</p><div class="sp-format-diagram" aria-hidden="true">{(i===0?(de?['Ziele','Abläufe','Prioritäten']:['Goals','Workflows','Priorities']):(de?['Eingabe','Vorbereitung','Entscheidung']:['Input','Preparation','Decision'])).map((word,n)=><><span>{word}</span>{n<2&&<b>→</b>}</>)}</div></div></article>)}</div></section>
 <aside class="sn-related hp-wrap"><span>{de?'Sie möchten einen einzelnen Vorgang ansehen?':'Want to examine one specific task?'}</span><a href={de?'/de/ki-potenzialanalyse/':'/en/ai-potential-analysis/'}>{de?'Zur 60-minütigen Potenzialanalyse':'Explore the 60-minute potential analysis'} ↗</a></aside>
 <AgencyContact locale={locale} copy={{title:t.closingTitle,emphasis:t.closingEmphasis,body:t.closingBody}} showKicker={false}/>
</AgencyDocument>
