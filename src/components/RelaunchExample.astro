---
import {Image} from 'astro:assets';
import interior from '../assets/website-service/interior.png';
import materials from '../assets/website-service/materials.png';
import '../styles/relaunch-example.css';
interface Props {locale:'de'|'en'; before:boolean;}
const {locale,before}=Astro.props;
const de=locale==='de';
const services=de?['Möbel nach Maß','Einbauschränke','Innenausbau']:['Bespoke furniture','Fitted wardrobes','Interior joinery'];
---
<div class:list={['rx-browser',before?'rx-old':'rx-new']}>
 <div class="rx-chrome" aria-hidden="true"><i></i><i></i><i></i><span>schreinerei-beispiel.example</span></div>
 {before?<div class="rx-old-canvas">
   <div class="rx-old-banner"><span class="rx-old-mark" aria-hidden="true">S</span><div><strong>{de?'Schreinerei Beispiel':'Example Joinery'}</strong><p>{de?'Ihr Partner rund ums Holz!':'Your partner for all things wood!'}</p></div></div>
   <div class="rx-old-topline">{de?'Startseite » Herzlich willkommen':'Home » Welcome'}</div>
   <div class="rx-old-columns">
     <div class="rx-old-menu"><strong>{de?'Navigation':'Navigation'}</strong>{(de?['Home','Über uns','Was wir machen','Bildergalerie','Aktuelles','Links','Kontakt']:['Home','About us','What we do','Picture gallery','News','Links','Contact']).map(x=><span>{x} »</span>)}<div class="rx-old-badge">{de?'HOLZ IST':'WOOD IS'}<br/><b>{de?'UNSER LEBEN':'OUR LIFE'}</b></div></div>
     <div class="rx-old-content"><h4>{de?'Herzlich willkommen auf unserer Internetseite!':'Welcome to our website!'}</h4><p>{de?'Wir freuen uns, dass Sie den Weg zu uns gefunden haben. Auf den folgenden Seiten möchten wir Ihnen unseren Betrieb und unser umfangreiches Leistungsspektrum näher vorstellen.':'We are pleased that you have found your way to us. On the following pages we would like to introduce our company and our extensive range of services.'}</p><Image src={interior} width={350} format="webp" alt={de?'Kleines generiertes Raumfoto in der alten Beispielseite':'Small generated interior image on the old example site'} loading="lazy"/><p>{de?'Wir fertigen Möbel nach Maß, Einbauschränke und individuellen Innenausbau. Dabei stehen Ihre Wünsche im Mittelpunkt. Gerne beraten wir Sie persönlich. Weitere Informationen finden Sie in unserer Bildergalerie oder nehmen Sie Kontakt mit uns auf.':'We make bespoke furniture, fitted wardrobes and individual interior joinery. Your wishes are at the heart of our work. We are happy to advise you personally. Find more information in our picture gallery or contact us.'}</p><p class="rx-old-emphasis">{de?'Qualität und Service werden bei uns GROSS geschrieben!':'QUALITY and SERVICE are our priorities!'}</p><p>{de?'Viel Spaß beim Stöbern auf unserer Homepage wünscht Ihnen':'Enjoy browsing our homepage.'}<br/><b>{de?'Ihr Schreinerei-Team':'Your joinery team'}</b></p><hr/><small>{de?'Weitere Bilder finden Sie unter „Bildergalerie“.':'Find more pictures under “Picture gallery”.'}</small></div>
     <aside class="rx-old-sidebar"><strong>{de?'AKTUELLES':'NEWS'}</strong><p>{de?'Unsere Homepage hat ein neues Gesicht!':'Our homepage has a new look!'}</p><hr/><strong>{de?'Kontakt':'Contact'}</strong><p>{de?'Sie haben Fragen? Nutzen Sie unser Kontaktformular auf der Kontaktseite.':'Any questions? Use the form on our contact page.'}</p><span>{de?'Zur Kontaktseite »':'Go to contact »'}</span><hr/><small>{de?'Für eine optimale Ansicht bitte am PC öffnen.':'For the best view, please open on a desktop computer.'}</small></aside>
   </div>
   <div class="rx-old-footer">{de?'Startseite | Kontakt | Impressum':'Home | Contact | Legal notice'}</div>
 </div>:<div class="rx-new-canvas">
   <div class="rx-new-nav"><strong><span aria-hidden="true">s.</span>{de?'schreinerei beispiel':'example joinery'}</strong><div>{de?'Möbel · Einbauten · Projekte':'Furniture · Fitted pieces · Projects'}</div><span class="rx-nav-cta">{de?'Projekt besprechen':'Discuss a project'} ↗</span></div>
   <div class="rx-new-hero"><div><small>{de?'Möbel nach Maß & Innenausbau':'Bespoke furniture & interior joinery'}</small><h4>{de?'Ihr Raum.':'Your space.'}<br/><em>{de?'Ihr Lieblingsstück.':'Your favourite piece.'}</em></h4><p>{de?'Wir planen und fertigen Möbel, die genau zu Ihnen passen. Von der ersten Idee bis zum letzten Schliff.':'We design and make furniture that fits you perfectly. From the first idea to the finishing touch.'}</p><span class="rx-solid-cta">{de?'Ihre Idee besprechen':'Discuss your idea'} ↗</span></div><Image src={interior} width={900} format="webp" alt={de?'Großes generiertes Wohnraum-Motiv auf der neuen Beispielseite':'Large generated interior image on the new example site'} loading="lazy"/></div>
   <div class="rx-new-services"><div class="rx-section-caption"><span>01 / {de?'Was wir für Sie bauen':'What we build for you'}</span><strong>{de?'Für jeden Raum die passende Lösung.':'The right solution for every room.'}</strong></div><div class="rx-service-grid">{services.map((s,i)=><div><span class={`rx-furniture rx-furniture-${i}`} aria-hidden="true"><i></i><i></i><i></i></span><strong>{s}</strong><p>{(de?['Einzelstücke, die Ihren Alltag schöner machen.','Stauraum, der den vorhandenen Platz nutzt.','Durchdachte Räume, stimmig bis ins Detail.']:['Individual pieces for everyday living.','Storage that makes use of your space.','Thoughtful spaces, down to the last detail.'])[i]}</p><span class="rx-service-link">{de?'Entdecken':'Explore'} ↗</span></div>)}</div></div>
   <div class="rx-new-project"><Image src={materials} width={600} format="webp" alt={de?'Generierte Materialstudie als illustratives Projektmotiv':'Generated material study as an illustrative project image'} loading="lazy"/><div><span>02 / {de?'Einblick in die Gestaltung':'A closer look at the design'}</span><h4>{de?'Echtes Holz.':'Solid wood.'}<br/><em>{de?'Ein gutes Gefühl.':'A lasting feeling.'}</em></h4><p>{de?'Material, Oberfläche und Form gehören zusammen. Entdecken Sie, wie daraus ein stimmiger Raum entstehen kann.':'Material, finish and form belong together. See how they can create a coherent space.'}</p><span class="rx-service-link">{de?'Gestaltung ansehen':'Explore the design'} ↗</span></div></div>
   <div class="rx-new-contact"><div><small>03 / {de?'Ihr nächster Schritt':'Your next step'}</small><strong>{de?'Was möchten Sie aus Ihrem Raum machen?':'What would you like your space to become?'}</strong></div><span class="rx-solid-cta">{de?'Projekt besprechen':'Discuss a project'} ↗</span></div>
 </div>}
</div>
<div class="rx-structure"><span>{de?'Seitenaufbau':'Page structure'}</span><p>{before?(de?'Begrüßung → langer Fließtext → verstreute Informationen → Kontakt auf einer anderen Seite':'Welcome → long text → scattered information → contact on another page'):(de?'Klares Angebot → drei Leistungen → anschaulicher Einblick → direkte Anfrage':'Clear offering → three services → visual example → direct enquiry')}</p></div>
