---
import { Image } from 'astro:assets';
import before from '../assets/case-studies/loistl/rasen-vorher.jpg';
import after from '../assets/case-studies/loistl/rasen-nachher.jpg';
import InputEmail from './InputEmail.astro';
interface Props { index: number; locale: 'de' | 'en'; large?: boolean; }
const { index, locale, large = false } = Astro.props;
const de = locale === 'de';

---
<div class="collaboration-visual">
  {index === 0 ? <div class="shot-plan" role="img" aria-label={de ? 'Motivvorschlag: dieselbe Fläche vor und nach der Arbeit fotografieren' : 'Photo suggestion: photograph the same area before and after the work'}>
    <div class="camera" aria-hidden="true"><svg viewBox="0 0 48 36" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M5 9h10l4-6h10l4 6h10v24H5z"/><circle cx="24" cy="21" r="8"/><path d="M36 14h3"/></svg></div>
    <div class="shot-frames" aria-hidden="true"><div><span class="landscape"><i></i></span><span>{de ? 'Vorher' : 'Before'}</span></div><div><span class="landscape landscape-after"><i></i></span><span>{de ? 'Nachher' : 'After'}</span></div></div>
  </div> : index === 1 ? <InputEmail locale={locale} /> : <div class="published-example">
    <div class="published-heading">{de ? 'Weniger Laub. Mehr gepflegte Fläche.' : 'Fewer leaves. Better-kept grounds.'}</div>
    <div class="published-pair">
      <figure><Image src={before} width={large ? 650 : 360} format="webp" alt={de ? 'Rasenfläche vor der Laubbeseitigung' : 'Lawn before leaf removal'} loading="lazy" /><figcaption>{de ? 'Vorher' : 'Before'}</figcaption></figure>
      <figure><Image src={after} width={large ? 650 : 360} format="webp" alt={de ? 'Rasenfläche nach der Laubbeseitigung' : 'Lawn after leaf removal'} loading="lazy" /><figcaption>{de ? 'Nachher' : 'After'}</figcaption></figure>
    </div>
  </div>}

</div>
<style>
.collaboration-visual{width:100%;min-height:170px;display:grid;place-items:center;border:1px solid #d9cce3;border-radius:14px;background:#eee6f3;overflow:hidden;box-sizing:border-box}
.shot-plan{width:100%;max-width:210px;padding:18px}.camera{width:42px;margin:0 auto 12px;color:#745188}.camera svg{display:block;width:100%}.shot-frames{display:grid;grid-template-columns:1fr 1fr;gap:8px}.shot-frames>div{font-size:10px;color:#745188;text-align:center}.landscape{display:block;position:relative;height:50px;border:1px dashed #a087b2;border-radius:5px;background:#fffdf9;overflow:hidden;margin-bottom:4px}.landscape:before{content:'';position:absolute;width:14px;height:14px;border-radius:50%;background:#d6bdf2;top:7px;right:9px}.landscape i{position:absolute;left:0;right:0;bottom:0;height:24px;background:#bca8cd;clip-path:polygon(0 60%,25% 0,55% 60%,74% 30%,100% 75%,100% 100%,0 100%)}.landscape-after{border-style:solid;background:#faf6ff}
.published-example{width:100%;background:#123e30;color:#f5f2ed;padding:16px 12px}
.published-heading{font-size:15px;line-height:1.15;font-weight:600;letter-spacing:-.035em;margin-bottom:14px;max-width:18ch}
.published-pair{display:grid;grid-template-columns:1fr 1fr;gap:7px}.published-pair figure{position:relative;margin:0;min-width:0}.published-pair img{display:block;width:100%;height:auto;aspect-ratio:3/4;object-fit:cover;border-radius:6px}.published-pair figcaption{position:absolute;top:5px;left:5px;background:#f5f2ed;color:#19362d;border-radius:999px;padding:3px 5px;font-size:8px;font-weight:600}
@media(max-width:600px){.collaboration-visual{max-width:360px;min-height:190px}.shot-plan{max-width:240px}.published-example{padding:22px 18px}.published-heading{font-size:23px}.published-pair figcaption{font-size:10px;padding:5px 8px}}
</style>
