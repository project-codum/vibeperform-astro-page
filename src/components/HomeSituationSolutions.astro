---
import WebsiteBuildAnimation from './WebsiteBuildAnimation.astro';
import type { Locale } from '../lib/siteMetadata';
const {locale}=Astro.props as {locale:Locale};
const de=locale==='de';
const privateDemo=de && import.meta.env.VP_PRIVATE_PREVIEW==='1';
const localMedia=de && import.meta.env.VP_LOCAL_MEDIA_READY;
const privateAssets="/lokale-vorschau-vp";
const problems=de ? [
 ['„Gibt’s die überhaupt noch?“','Der Betrieb hat sich weiterentwickelt. Die Website sieht noch aus wie damals.'],
 ['„Können Sie mir mal ein Angebot machen?“','Kein Ort, keine Maße, keine Fotos. Beim Rückruf müssen Sie erst herausfinden, worum es geht.'],
 ['„Das sieht doch nur der Kunde, für den wir’s gemacht haben.“','Das Projekt ist fertig. Andere potenzielle Kunden erfahren nie davon.'],
] : [
 ['“Are they still in business?”','Your business has moved on. Your website still looks the way it used to.'],
 ['“Can you send me a quote?”','No location, dimensions or photos. You have to call back to find out what the job is.'],
 ['“Only the client we did it for ever sees it.”','The job is done. Other potential customers never get to see it.'],
];
const solutions=de ? [
 ['Eine Website, die den Betrieb von heute zeigt','Wir ordnen Leistungen, schreiben die Inhalte und zeigen mit aktuellen Bildern, was Sie heute für Kunden leisten.'],
 ['Eine Anfrage, mit der Sie arbeiten können','Je nach Auftrag fragt die Website nach anderen Details. Probieren Sie es aus: Am Ende sehen Sie, was beim Betrieb ankommt.'],
 localMedia ? ['Aus zwei kurzen Clips wird ein Social-Media-Video','Vor Ort wurden zwei kurze Clips aufgenommen. Aus dem Material haben wir ein Hochkantvideo mit Schnitt, Sprecherstimme und Untertiteln gemacht.'] : ['Aus einer Sprachnotiz wird ein Projektbeispiel','Sie erzählen kurz, was vor Ort anstand und wie Sie es gelöst haben. Wir machen daraus einen Beitrag, den auch künftige Kunden sehen können.'],
] : [
 ['A website that reflects the business today','We organise your services, write the copy and use current photos to show the work you do today.'],
 ['An enquiry you can act on','Your website asks different questions for different jobs. Try it out to see what the business receives.'],
 ['Turn a voice note into a project story','Tell us what you found on site and how you solved it. We turn that into a story future customers can see.'],
];
const modes=[
 {label:de?'Ein Zimmer streichen':'Paint a room', fields:[
  {label:de?'Wie groß ist das Zimmer?':'How big is the room?', options:de?['Bis 20 m²','Über 20 m²']:['Up to 20 m²','Over 20 m²']},
  {label:de?'Decke mitstreichen?':'Paint the ceiling too?', options:de?['Nur Wände','Wände und Decke']:['Walls only','Walls and ceiling']},
 ]},
 {label:de?'Fassade sanieren':'Renovate a facade', fields:[
  {label:de?'Was fällt an der Fassade auf?':'What condition is the facade in?', options:de?['Anstrich verwittert','Risse im Putz']:['Weathered paint','Cracked render']},
  {label:de?'Wie hoch ist das Gebäude?':'How tall is the building?', options:de?['Ein Geschoss','Zwei oder mehr Geschosse']:['One storey','Two or more storeys']},
 ]},
];
---
<section class="scenes" id="situationen" aria-labelledby="situation-title">
 <div class="sc-wrap">
  <p class="eyebrow">{de?'Drei Situationen aus dem Alltag':'Three familiar situations'}</p>
  <h2 id="situation-title">{de?'Gute Arbeit. Aber wer sieht sie?':'Good work. But who sees it?'}</h2>
  <div class="problems">
   {problems.map(([title,body],i)=><article>
    <span class="index">0{i+1}</span>
    <div class="scene-mini" aria-hidden="true">
     {i===0 ? <div class="old-site"><small>● ● ●</small><b>{de?'Willkommen auf unserer Homepage':'Welcome to our homepage'}</b><span>{de?'Letztes Update: 2018':'Last updated: 2018'}</span></div>
     : i===1 ? <div class="empty-mail"><small>{de?'Neue Anfrage':'New enquiry'}</small><b>{de?'Was kostet das?':'How much does it cost?'}</b><span>{de?'Ort: —　Umfang: —':'Location: —　Scope: —'}</span></div>
     : <div class="empty-camera"><small>{de?'Auf dem Handy':'On the phone'}</small><div class="photo-symbol">▧</div><span>{de?'Nur lokal gespeichert':'Saved on this device'}</span></div>}
    </div><h3>{title}</h3><p>{body}</p>
   </article>)}
  </div>
 </div>
 <div class="sc-response">
  <div class="sc-wrap">
   <p class="eyebrow">{de?'So lösen wir das':'How we solve it'}</p>
   <h2>{de?'Was wir konkret für Sie ändern':'What we change for you'}</h2>
   {solutions.map(([title,body],i)=><article class="solution" id={i===1?'anfrage-demo':undefined}>
    <div class="sc-copy"><span class="index">0{i+1}</span><h3>{title}</h3><p>{body}</p></div>
    <div class="scene">
     {i===0 ? <WebsiteBuildAnimation locale={locale} /> : i===1 && privateDemo ? <div class="original-maler">
       <p class="mini-label">Interaktive Maler-Demo · keine Übermittlung</p>
       <iframe data-original-maler title="Interaktive Maleranfrage: Wände, Maße und Projektstart auswählen" src={`${privateAssets}/maler.html`} sandbox="allow-scripts"></iframe>
      </div> : i===1 ? <div class="demo" data-enquiry-demo>
      <div class="demo-form">
       <p class="mini-label">{de?'Interaktive Demo · Malerbetrieb':'Interactive demo · Painting business'}</p>
       <label class="sc-field"><span>{de?'Was möchten Sie machen lassen?':'What work do you need?'}</span><select data-mode>{modes.map((m,n)=><option value={String(n)}>{m.label}</option>)}</select></label>
       {modes.map((m,n)=><div data-branch={n} hidden={n!==0}>{m.fields.map(f=><label class="sc-field"><span>{f.label}</span><select>{f.options.map(o=><option>{o}</option>)}</select></label>)}</div>)}
       <small>{de?'Nur ein Beispiel. Nichts wird gesendet.':'Example only. Nothing is sent.'}</small>
      </div>
      <div class="demo-result" aria-live="polite" aria-atomic="true">
       <p class="mini-label">{de?'So kommt die Anfrage an':'What the business receives'}</p>
       <strong data-summary-title>{modes[0].label}</strong>
       <ul><li data-summary-answer>{modes[0].fields[0].options[0]}</li><li data-summary-answer>{modes[0].fields[1].options[0]}</li></ul>
      </div>
     </div> : localMedia ? <div class="video-showcase">
      <div><p class="mini-label">01 · Originalclips</p><div class="raw-clips">
        <figure><video controls playsinline preload="none" poster={`${privateAssets}/roh-1.jpg`} src={`${privateAssets}/roh-1.mp4`} aria-label="Laub, Originalclip 1"></video><figcaption>Clip 1 · Ausgangslage</figcaption></figure>
        <figure><video controls playsinline preload="none" poster={`${privateAssets}/roh-2.jpg`} src={`${privateAssets}/roh-2.mp4`} aria-label="Laub, Originalclip 2"></video><figcaption>Clip 2 · bei der Arbeit</figcaption></figure>
      </div></div>
      <div><p class="mini-label">02 · Fertiges Reel</p><figure><video controls playsinline preload="none" poster={`${privateAssets}/reel.jpg`} src={`${privateAssets}/reel.mp4`} aria-label="Fertiges Reel mit Untertiteln"></video><figcaption>Lokales Beispiel · Laubpflege</figcaption></figure></div>
     </div> : <div class="story-pair">
      <div class="voice"><p class="mini-label">{de?'01 · Beispiel-Sprachnotiz':'01 · Example voice note'}</p><div class="wave" aria-hidden="true">{[8,14,26,20,32,13,24,34,23,10,17,9].map(h=><i style={`height:${h}px`}></i>)}</div><p>{de?'„An der Wetterseite bröckelte der Putz. Wir haben die losen Stellen entfernt, neu verputzt und die Fassade gestrichen.“':'“The render was flaking on the exposed side. We removed the loose material, repaired the render and painted the facade.”'}</p></div>
      <div class="story-sample"><div class="facade" aria-hidden="true"><i></i><i></i><i></i></div><div><p class="mini-label">{de?'02 · Beispiel-Projektbeitrag':'02 · Example project story'}</p><strong>{de?'Wetterseite wieder instand gesetzt':'The exposed side, restored'}</strong><p>{de?'Lose Putzstellen entfernt, die Fläche ausgebessert und neu gestrichen.':'Loose render removed, the surface repaired and repainted.'}</p></div></div>
     </div>}
    </div>
   </article>)}
  </div>
 </div>
</section>

<script>
 function setup(){
  for(const frame of document.querySelectorAll<HTMLIFrameElement>('[data-original-maler]:not([data-ready])')){
   frame.dataset.ready='true';
   window.addEventListener('message',event=>{
    if(event.source!==frame.contentWindow || event.data?.kind!=='maler-state' || !Number.isFinite(event.data.height))return;
    frame.style.height=`${Math.min(1800,Math.max(280,Math.ceil(event.data.height)))}px`;
   });
  }
  for(const demo of document.querySelectorAll<HTMLElement>('[data-enquiry-demo]')){
   if(demo.dataset.ready)continue;
   demo.dataset.ready='true';
   const mode=demo.querySelector<HTMLSelectElement>('[data-mode]');
   if(!mode)continue;
   const branches=[...demo.querySelectorAll<HTMLElement>('[data-branch]')];
   const title=demo.querySelector('[data-summary-title]');
   const result=[...demo.querySelectorAll('[data-summary-answer]')];
   const update=()=>{
    branches.forEach((b,n)=>{b.hidden=n!==Number(mode.value);});
    if(title)title.textContent=mode.selectedOptions[0].text;
    branches[Number(mode.value)].querySelectorAll<HTMLSelectElement>('select').forEach((el,n)=>{result[n].textContent=el.value;});
   };
   demo.addEventListener('change',update);update();
  }
 }
 setup();document.addEventListener('astro:page-load',setup);
</script>

<style>
.scenes{background:#211929;color:#f8f4fb;scroll-margin-top:5rem}
.sc-wrap{width:min(1160px,92%);margin-inline:auto}
.eyebrow,.mini-label{text-transform:uppercase;font-size:.72rem;font-weight:700;letter-spacing:.11em;color:#d4b8ef;margin:0 0 .65rem}
h2{font-weight:550;font-size:clamp(2rem,5.5vw,4.5rem);line-height:1.02;letter-spacing:-.061em;margin:0}
h3{font-weight:650;font-size:clamp(1.32rem,2.4vw,2rem);line-height:1.12;letter-spacing:-.041em;margin:.7rem 0 .55rem;text-wrap:balance}
p{margin:0}
.problems{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:clamp(1.2rem,4vw,3rem);padding:clamp(1.6rem,5vw,3rem) 0 clamp(3rem,7vw,6rem)}
.problems article{min-width:0;border-top:1px solid #634e73;padding-top:.95rem}.problems p{color:#dcd0e3;line-height:1.5}
.index{font:700 .72rem Arial,sans-serif;letter-spacing:.12em;color:#d4b8ef}
.scene-mini{height:9rem;margin:.75rem 0 1rem;display:grid;place-items:center;border-radius:.75rem;background:radial-gradient(at 50% 100%,#654578,#392946 61%,#2d2239);padding:.7rem}
.scene-mini>div{display:grid;gap:.25rem;text-align:left;min-width:67%;background:#f4edf6;color:#322639;padding:.65rem .75rem;border-radius:.46rem;transform:rotate(-3deg);box-shadow:0 .65rem 1.25rem #18121e65}
.scene-mini>div span,.scene-mini small{font-size:.69rem;color:#6c5477}.scene-mini>div b{font-size:.87rem;line-height:1.05}
.scene-mini .old-site{font-family:Georgia,serif}.scene-mini .empty-mail{transform:rotate(2deg)}.scene-mini .empty-camera{min-width:0;transform:rotate(-2deg)}
.photo-symbol{font-size:1.75rem;text-align:center;line-height:1.14;color:#7a5c8e}
.sc-response{background:linear-gradient(180deg,#211929 0,#ded1e8 clamp(4rem,10vw,8rem),#f5f2ed clamp(19rem,39vw,32rem));padding:clamp(4.5rem,11vw,9rem) 0 clamp(3.2rem,7vw,6rem);color:#28232e}
.sc-response .eyebrow,.sc-response .index,.scene .mini-label{color:#654479}
.solution{display:grid;grid-template-columns:minmax(0,.72fr) minmax(0,1.28fr);gap:clamp(1.5rem,6vw,5rem);align-items:center;padding-block:clamp(1.6rem,4.5vw,3.6rem);border-bottom:1px solid #d9d2dc}
.solution:last-child{border-bottom:0}.sc-copy p{max-width:41ch;color:#5a4c65;line-height:1.55}
.scene{min-width:0;padding:clamp(.75rem,2.5vw,1.65rem);border-radius:1rem;background:radial-gradient(at 55% 0,#f8f1fb,#e9dfef);border:1px solid #daccdf}
.demo,.story-pair{display:grid;grid-template-columns:1fr 1fr;gap:.7rem;align-items:stretch}
.demo-form,.demo-result,.voice,.story-sample{min-width:0;background:#fffbfe;border:1px solid #dacae1;border-radius:.65rem;padding:.8rem;font-size:.88rem}
.demo-result{background:#33233e;color:#faf3fd}.scene .demo-result .mini-label{color:#e2c9f5}
.demo-result ul{padding-left:1rem;margin:.55rem 0}.demo-result li{margin-top:.22rem}
.sc-field{display:grid;gap:.22rem;margin-bottom:.53rem;font-weight:600}.sc-field select{width:100%;min-height:2.35rem;background:#fff;border:1px solid #9d83ad;border-radius:.3rem;color:#2d2234;font:inherit;padding:.28rem}.sc-field select:focus-visible{outline:2px solid #6b4088;outline-offset:2px}
.demo-form small{display:block;line-height:1.35;color:#665271}
.voice{border-radius:1rem;background:#31243a;color:#fbf4fe}.scene .voice .mini-label{color:#e2c9f5}
.wave{height:2.1rem;display:flex;align-items:center;gap:3px;margin:.3rem 0 .55rem;color:#c69aeb}.wave i{background:currentColor;width:3px;border-radius:3px}
.story-sample{padding:0;overflow:hidden}.story-sample>div:last-child{padding:.75rem}.story-sample strong{display:block;margin-bottom:.25rem;line-height:1.14}
.facade{min-height:4.25rem;background:linear-gradient(151deg,#c4a5dc 0%,#e9bfac 62%,#d6a492);display:flex;gap:.45rem;align-items:flex-end;padding:.8rem 1rem}.facade i{width:1.2rem;height:1.6rem;border:2px solid #f9eadf;background:#856383;box-shadow:0 .15rem .1rem #61354960}
@media(max-width:740px){.problems,.solution{grid-template-columns:1fr}.problems{gap:1.15rem}.scene-mini{height:7.5rem}.sc-response{background:linear-gradient(#211929,#f5f2ed 4.4rem)}}
@media(max-width:430px){.demo,.story-pair{grid-template-columns:1fr}}
</style>

<style>
.original-maler iframe{display:block;width:100%;height:760px;border:1px solid #daccdf;border-radius:.7rem;background:#fffbff}
.video-showcase{display:grid;grid-template-columns:1.4fr 1fr;gap:.8rem;align-items:start}
.video-showcase figure{margin:0;min-width:0}.video-showcase video{display:block;width:100%;aspect-ratio:9/16;object-fit:contain;background:#201628;border-radius:.55rem}
.raw-clips{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.4rem}
.video-showcase figcaption{font-size:.7rem;margin-top:.35rem;color:#654479}
@media(max-width:435px){.video-showcase{grid-template-columns:1fr}.video-showcase>div:last-child{max-width:min(70%,15rem)}}
</style>
