---
import WebsiteBuildAnimation from './WebsiteBuildAnimation.astro';
import type { Locale } from '../lib/siteMetadata';
const {locale}=Astro.props as {locale:Locale};
const de=locale==='de';
const problems=de ? [
 ['Können die mein\nProjekt überhaupt?','Das Projekt ist fertig. Andere potenzielle Kunden erfahren nie davon.', 'Wenig und schlechte Projektreferenzen'],
 ['Was würde das\nbei denen kosten?','Kein Ort, keine Maße, keine Fotos. Beim Rückruf musst du erst herausfinden, worum es geht.', 'Ort: —　Umfang: —'],
 ["Gibt's die\nüberhaupt noch?",'Der Betrieb hat sich weiterentwickelt. Die Webseite sieht noch aus wie damals.', 'Letztes Update: 2018'],
] : [
 ['“Are they still in business?”','Your business has moved on. Your website still looks the way it used to.'],
 ['“Can you send me a quote?”','No location, dimensions or photos. You have to call back to find out what the job is.'],
 ['“Only the client we did it for ever sees it.”','The job is done. Other potential customers never get to see it.'],
];
---
<section class="scenes" id="situationen" aria-labelledby="situation-title">
  <div class="hp-wrap">
    <question-headlines>
      <div class="question-stage">
        <h2 id="situation-title">{de ? 'Du machst gute Arbeit.' : 'Good work.'} {de && <br />}<em>{de ? 'Aber auf deiner Webseite denkt man sich:' : 'But who sees it?'}</em></h2>
        <div class:list={['problems', { 'question-cards': de }]}>
          {problems.map(([title, body, detail], index) => <article>
            <div class="scene-mini" aria-hidden={de ? undefined : 'true'}>
              {de ? <div class:list={[{ 'mock-site': index === 2 }]}><h3>{title}</h3><span>{detail}</span></div>
              : index === 0 ? <div class="mock-site"><small>● ● ●</small><b>Welcome to our homepage</b><span>Last updated: 2018</span></div>
              : index === 1 ? <div><small>New enquiry</small><b>How much does it cost?</b><span>Location: —　Scope: —</span></div>
              : <div><small>On the phone</small><div class="photo-symbol">▧</div><span>Saved on this device</span></div>}
            </div>
            {!de && <h3>{title}</h3>}
            <p>{body}</p>
          </article>)}
        </div>
      </div>
    </question-headlines>
  </div>

  <div class="hp-wrap sc-response" data-stacked={de || undefined}>
    <h2>{de ? 'Wir arbeiten für dich' : 'What we'} {de && <br />}<em>{de ? 'an deinem Online-Auftritt.' : 'work on for you'}</em></h2>
    <article class="solution">
      {de ? <header class="solution-intro">
        <h3>Eine Webseite die immer aktuell bleibt</h3>
        <p>Wir publizieren stetig deine neusten Projekte und Rezensionen damit die nächsten Kunden wissen <strong>was du heute kannst</strong>.</p>
      </header> : <h3>A website that reflects your business today.</h3>}
      <div class="scene"><WebsiteBuildAnimation locale={locale} /></div>
      <a class="hp-button sc-cta" href="#kontakt">{de ? 'Kennenlerngespräch vereinbaren' : 'Book an intro call'}<span aria-hidden="true">↓</span></a>
    </article>
  </div>
</section>

<script>
 import '../lib/questionHeadlines';
</script>

<style>
  .scenes {
    --sc-surface: #fffdfa;
    --sc-flieder: #e8deef;
    background: var(--hp-paper);
    color: var(--hp-ink);
    padding: clamp(4rem, 7vw, 6rem) 0;
    scroll-margin-top: 5rem;
  }
  h2 { margin: 0; font-size: clamp(2rem, 4.2vw, 3.75rem); font-weight: 700; line-height: 1.12; letter-spacing: -.045em; text-wrap: balance; }
  h2 em { font-style: italic; font-family: Georgia, 'Times New Roman', serif; font-weight: 400; }
  h3 { margin: 0; font-weight: 700; font-size: clamp(1.42rem, 2.3vw, 2rem); line-height: 1.2; letter-spacing: -.025em; }
  p { margin: 0; }
  .problems { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(1.5rem, 3.5vw, 3rem); padding-top: 2rem; }
  .problems article { min-width: 0; border-top: 1px solid var(--hp-line); padding-top: 1rem; }
  .problems p { margin-top: .75rem; font-size: 1.125rem; line-height: 1.6; }
  .scene-mini { min-height: 8.5rem; margin-bottom: 1.5rem; padding: 1rem; display: grid; place-items: center; border-radius: 6px; background: var(--sc-flieder); }
  .scene-mini > div { display: grid; gap: .3rem; width: min(100%, 13rem); padding: .75rem 1rem; border: 1px solid var(--hp-line); border-radius: 6px; background: var(--sc-surface); }
  .scene-mini :is(span, small) { font-size: .875rem; line-height: 1.35; }
  .scene-mini :is(b, h3) { font-size: 1rem; line-height: 1.3; letter-spacing: normal; }
  .scene-mini .mock-site :is(b, h3) { font-family: Georgia, 'Times New Roman', serif; }
  .question-cards {
    grid-template-columns: minmax(0, 386fr) minmax(0, 366fr) minmax(0, 366fr);
    gap: 1.25rem;
  }
  question-headlines { display: block; }
  question-headlines[data-motion]::after { content: ''; display: block; height: clamp(56rem, 145svh, 100rem); }
  question-headlines[data-motion] .question-stage { position: sticky; top: clamp(.75rem, 5svh, 4rem); isolation: isolate; }
  question-headlines[data-motion] .scene-mini { position: relative; }
  question-headlines[data-motion] article { border-color: var(--rule-color, transparent); }
  .question-cards .scene-mini { padding: .75rem .5rem; }
  .question-cards .scene-mini > div {
    width: min(100%, 21.875rem);
    container-type: inline-size;
  }
  .question-cards article:first-child .scene-mini > div { width: min(100%, 23.125rem); }
  .question-cards .scene-mini h3 {
    font-size: min(2.25rem, 11.4cqi);
    line-height: 1.12;
    letter-spacing: -.025em;
    white-space: pre-line;
  }
  @media (max-width: 56rem) {
    .question-cards { grid-template-columns: 1fr; gap: 1rem; padding-top: 1.25rem; }
    .question-cards article { padding-top: 0; border: 0; }
    .question-cards .scene-mini { min-height: 0; margin-bottom: .375rem; padding: .5rem; }
    .question-cards .scene-mini > div,
    .question-cards article:first-child .scene-mini > div { width: 100%; padding: .5rem .75rem; }
    .question-cards p { margin-top: 0; font-size: 1rem; line-height: 1.4; }
  }
  .photo-symbol { color: var(--hp-plum); font-size: 1.6rem; line-height: 1; }
  .sc-response { border-top: 1px solid var(--hp-line); margin-top: clamp(3rem, 6vw, 5rem); padding-top: clamp(2rem, 4vw, 3rem); }
  .solution { display: grid; grid-template-columns: minmax(0, .72fr) minmax(0, 1.28fr); grid-template-areas: "title scene" "button scene"; grid-template-rows: 1fr 1fr; column-gap: clamp(1.5rem, 6vw, 5rem); align-items: center; padding-block: clamp(1.75rem, 4.5vw, 3.5rem); scroll-margin-top: 5rem; }
  .solution:last-child { padding-bottom: 0; }
  .solution > h3 { grid-area: title; align-self: end; }
  .solution > .scene { grid-area: scene; }
  .sc-cta { grid-area: button; align-self: start; justify-self: start; margin-top: 1.5rem; }
  .sc-response[data-stacked] .solution {
    grid-template: "title" auto "scene" auto "button" auto / minmax(0, 1fr);
    row-gap: clamp(1.25rem, 2.5vw, 2rem);
    max-width: 50rem;
    margin-inline: auto;
  }
  .solution-intro { grid-area: title; }
  .solution-intro p { margin: .65rem 0 0; max-width: 65ch; font-size: 1.25rem; line-height: 1.55; }
  .solution-intro strong { font-weight: 700; }
  .sc-response[data-stacked] .sc-cta { margin-top: 0; }
  .sc-cta:focus-visible { outline: 2px solid var(--hp-plum); outline-offset: 3px; }
  .scene { min-width: 0; padding: clamp(.75rem, 2.5vw, 1.5rem); border: 1px solid var(--hp-line); border-radius: 6px; background: var(--sc-flieder); }
  @media (max-width: 700px) {
    .problems, .solution { grid-template-columns: 1fr; }
    .solution { grid-template-areas: "title" "scene" "button"; grid-template-rows: auto; row-gap: 1.5rem; }
    .sc-cta { margin-top: 0; }
    .scene-mini { min-height: 7rem; }
  }
</style>
