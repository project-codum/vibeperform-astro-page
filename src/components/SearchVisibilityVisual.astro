---
import type { Locale } from '../lib/siteMetadata';
interface Props { locale: Locale; }
const { locale } = Astro.props;
const de = locale === 'de';
const query = de ? 'Wonach suchen deine Kunden?' : 'What are your customers looking for?';
---
<div class="search-visual" data-search-preview={de || undefined} style={`--typing-time: ${query.length * 38}ms`} role="img" aria-label={de ? 'Schematische Suchansicht: Kundenfragen führen zu passenden Leistungen und verständlichen Antworten' : 'Illustrative search view: customer questions lead to relevant services and clear answers'}>
  <div class="search-query" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><circle cx="10" cy="10" r="6"/><path d="m15 15 6 6"/></svg><span>{de ? Array.from(query, (letter, index) => <span class="query-letter" style={`--letter-delay: ${index * 38}ms`}>{letter}</span>) : query}</span></div>
  <div class="search-path" aria-hidden="true"></div>
  <div class="search-results" aria-hidden="true">
    <div class="search-result"><div class="result-source"><span class="result-icon">↗</span><span>{de ? 'Dein Unternehmen' : 'Your business'}</span></div><strong>{de ? 'Die passende Leistung.' : 'The right service.'}</strong><div class="result-lines"><i></i><i></i></div></div>
    <div class="search-result"><div class="result-source"><span class="result-icon result-icon--answer">?</span><span>{de ? 'Deine Antworten' : 'Your answers'}</span></div><strong>{de ? 'Genau das wollte ich wissen.' : 'Just what I needed to know.'}</strong><div class="result-lines"><i></i><i></i></div></div>
  </div>
</div>
<script>
  if ('IntersectionObserver' in window && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const observer = new IntersectionObserver(entries => {
      for (const entry of entries) {
        if (!entry.isIntersecting) continue;
        entry.target.setAttribute('data-reveal', 'playing');
        observer.unobserve(entry.target);
      }
    }, { threshold: .2 });
    document.querySelectorAll('[data-search-preview]').forEach(preview => {
      preview.setAttribute('data-reveal', 'waiting');
      observer.observe(preview);
    });
  }
</script>
<style>
@media (prefers-reduced-motion: no-preference) {
  [data-reveal="waiting"] :is(.query-letter, .search-result, .search-path) { visibility: hidden; }
  [data-reveal="playing"] .query-letter { animation: type-letter 1ms step-end var(--letter-delay) backwards; }
  [data-reveal="playing"] .search-path { animation: unfold-result .16s ease-out var(--typing-time) backwards; }
  [data-reveal="playing"] .search-result {
    animation: unfold-result .38s ease-out calc(var(--typing-time) + .16s) backwards;
  }
  [data-reveal="playing"] .search-result + .search-result {
    animation-delay: calc(var(--typing-time) + .62s);
  }
}
@keyframes type-letter { from { opacity: 0; } to { opacity: 1; } }
@keyframes unfold-result { from { clip-path: inset(0 0 100%); } to { clip-path: inset(0); } }

.search-visual{width:100%;color:#000}.search-query{display:flex;align-items:center;gap:15px;padding:22px 24px;border:1px solid #c4afd1;border-radius:999px;background:#fffdf9;font-size:clamp(16px,1.5vw,19px);font-weight:700;line-height:1.4}.search-query svg{width:24px;height:24px;flex-shrink:0;color:#745188}.search-path{height:28px;border-left:1px solid #af91c3;margin-left:36px}.search-results{display:grid;gap:16px}.search-result{padding:24px 28px;background:#fffdf9;border-left:3px solid #b399c4}.result-source{display:flex;align-items:center;gap:10px;font-size:15px;font-weight:700;margin-bottom:14px}.result-icon{display:grid;place-items:center;width:25px;height:25px;background:#e7d7f1;border-radius:50%;font-size:16px}.result-icon--answer{background:#ffd5bf}.search-result strong{font-size:clamp(18px,2vw,25px);font-weight:700;letter-spacing:-.025em;line-height:1.2}.result-lines{display:grid;gap:7px;margin-top:16px}.result-lines i{height:5px;background:#e0d6e5;border-radius:5px}.result-lines i:last-child{width:74%}@media(max-width:700px){.search-query{padding:18px}.search-result{padding:22px}.search-result strong{font-size:21px}}
</style>
