---
import HomeFluidBackdrop from './HomeFluidBackdrop.astro';
import type { HomeIntroContent } from '../data/homeIntroContent';
import '../styles/home-hero.css';
interface Props { copy: HomeIntroContent; }
const { copy } = Astro.props;
---
<section class="vf-hero" data-home-hero data-analytics-section="home-hero" aria-labelledby="home-title">
  <HomeFluidBackdrop pauseLabel={copy.pauseLabel} resumeLabel={copy.resumeLabel} />
  <div class="vf-copy" id="home-intro" tabindex="-1">
    {copy.audience && <p class="vf-kicker">{copy.audience}</p>}
    <h1 id="home-title" class:list={{'vf-title-aligned': copy.headline.includes('\n')}}>{copy.headline.split('\n').map((line, index) => <>{index > 0 && <br />}<span class="vf-title-line">{line}</span></>)}<br /><em>{copy.emphasis}</em></h1>
    <div class="vf-actions">
      <a class="vf-primary" href={copy.primaryHref} data-analytics-event="contact_start" data-analytics-name="book-discovery-call" data-analytics-location="home-hero">{copy.heroPrimaryLabel}<span aria-hidden="true">↗</span></a>
      <a class="vf-secondary" href="#projekt-hms-loistl">{copy.moreLabel}<span aria-hidden="true">↓</span></a>
    </div>
    <p class="vf-intro">{copy.intro.map((paragraph, index) => <>{index > 0 && <><br class="vf-desktop" /> </>}{paragraph}</>)}</p>
  </div>

  <div class="vf-hero-bottom" aria-hidden="true"></div>
</section>
