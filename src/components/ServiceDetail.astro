---
import AgencyDocument from './AgencyDocument.astro';
import AgencyContact from './AgencyContact.astro';
import ServiceEvidence from './ServiceEvidence.astro';
import { serviceDetails, detailPaths, type ServiceKey } from '../data/serviceDetails';
import { serviceNarratives } from '../data/serviceNarratives';
import type { Locale } from '../lib/siteMetadata';
import '../styles/service-detail.css';
import '../styles/service-narrative.css';
interface Props { locale:Locale; service:ServiceKey; }
const {locale,service}=Astro.props;
const t=serviceDetails[locale][service];
const c=serviceNarratives[locale][service];
const de=locale==='de';
const base=(import.meta.env.BASE_URL??'/').replace(/\/$/,'');
const overview=de?'/de/leistungen/':'/en/services/';
const related=service==='ai' ? [
 {name:de?'KI-Potenzialanalyse':'AI potential analysis',href:de?'/de/ki-potenzialanalyse/':'/en/ai-potential-analysis/'},
 {name:de?'Ihr Online-Auftritt':'Your online presence',href:overview},
] : t.related.map(key=>({name:serviceDetails[locale][key].name,href:detailPaths[locale][key]}));
---
<AgencyDocument locale={locale} title={`${t.name} | VibePerform`} description={t.description} path={detailPaths[locale][service]} alternatePath={detailPaths[de?'en':'de'][service]} service>
  <section class={`sv-hero sn-hero sn-hero-${service}`} aria-labelledby="home-title">
    <div class="hp-wrap" id="home-intro" tabindex="-1">
      <nav class="sv-breadcrumb" aria-label={de?'Seitenpfad':'Breadcrumb'}><a href={`${base}${overview}`}>{de?'Leistungen':'Services'}</a><span aria-hidden="true">/</span><span>{t.name}</span></nav>
      <h1 id="home-title">{t.title[0]}<br/><em>{t.title[1]}</em></h1>
      <div class="sn-hero-bottom"><p class="sv-lead">{t.intro}</p><div class="sn-actions"><a class="hp-button" href="#kontakt">{c.call}<span aria-hidden="true">↓</span></a><a class="hp-text-link" href="#beispiel">{de?'Ein Beispiel ansehen':'See an example'}<span aria-hidden="true">↓</span></a></div></div>
    </div>
  </section>
  <ServiceEvidence kind={service} locale={locale}/>
  <section class="hp-section sn-scope" id="umfang" aria-labelledby="scope-title"><div class="hp-wrap sn-scope-layout"><div><p class="hp-kicker">{de?'Leistung & Ergebnis':'Scope & results'}</p><h2 id="scope-title">{t.scopeTitle[0]}<br/><em>{t.scopeTitle[1]}</em></h2><p class="hp-intro">{t.scopeIntro}</p></div><div class="sn-scope-points">{t.scope.map(([title,body])=><article><h3>{title}</h3><p>{body}</p></article>)}</div></div><div class="hp-wrap"><div class="sn-boundary"><strong>{de?'So legen wir den Umfang fest':'How we agree the scope'}</strong><p>{t.boundary}{t.boundaryLink&&<>{' '}{t.boundaryLink.before}<a href={`${base}${t.boundaryLink.href}`}>{t.boundaryLink.label}</a>{t.boundaryLink.after}</>}</p></div></div></section>
  <section class="hp-section sn-working" id="ablauf" aria-labelledby="process-title"><div class="hp-wrap"><div class="sn-working-heading"><h2 id="process-title">{de?'Sie geben die Richtung vor.':'You set the direction.'}<br/><em>{de?'Wir übernehmen die Arbeit.':'We do the work.'}</em></h2><p>{t.contribution}</p></div><ol class="sn-process">{t.process.map(([title,body],i)=><li><span aria-hidden="true">0{i+1}</span><h3>{title}</h3><p>{body}</p></li>)}</ol></div></section>
  <section class="hp-section hp-faq" id="fragen" aria-labelledby="faq-title"><div class="hp-wrap hp-split"><h2 id="faq-title">{de?'Vor Ihrer':'Before your'}<br/><em>{de?'Entscheidung.':'decision.'}</em></h2><div>{t.faq.map(([question,answer])=><details><summary>{question}<span aria-hidden="true">＋</span></summary><p>{answer}</p></details>)}</div></div></section>
  <aside class="sn-related hp-wrap" id="weiterdenken" aria-label={de?'Ergänzende Leistungen':'Related services'}><span>{de?'Passt zu Ihrem Vorhaben:':'Related to your project:'}</span>{related.map(item=><a href={`${base}${item.href}`}>{item.name} ↗</a>)}</aside>
  <AgencyContact locale={locale} copy={{title:c.contactTitle,emphasis:c.contactEmphasis,body:t.contact}} showKicker={false}/>
</AgencyDocument>
