---
import { homePageContent } from '../data/homePageContent';
import ContactActions from './ContactActions.astro';
import type { Locale } from '../lib/siteMetadata';
interface Props { locale: Locale; copy?: { kicker?: string; title: string; emphasis: string; body: string }; showKicker?: boolean; }
const { locale, copy, showKicker = true } = Astro.props;
const t = homePageContent[locale].contact;
const c = copy ?? t;
---
<section class="hp-section hp-contact" id="kontakt" aria-labelledby="contact-title" data-analytics-section="contact">
  <div class="hp-wrap">
    {showKicker && c.kicker && <p class="hp-kicker">{c.kicker}</p>}
    <h2 id="contact-title">{c.title}<br /><em>{c.emphasis}</em></h2>
    <p class="hp-intro">{c.body}</p>
    <ContactActions locale={locale} />
  </div>
</section>
