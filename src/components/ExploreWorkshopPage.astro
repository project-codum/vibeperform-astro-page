---
import AgencyDocument from './AgencyDocument.astro';
import AgencyContact from './AgencyContact.astro';
import AssessmentExample from './AssessmentExample.astro';
import { supplementalContent } from '../data/supplementalContent';
import '../styles/service-narrative.css';
import '../styles/supplemental-pages.css';
interface Props { currentLocale:'de'|'en'; }
const {currentLocale:locale}=Astro.props;
const de=locale==='de';
const c=supplementalContent[locale];
const t=c.explore;
const base=(import.meta.env.BASE_URL??'/').replace(/\/$/,'');
---
<AgencyDocument locale={locale} title="Explore Workshop | VibePerform" description={t.intro} path={`/${locale}/workshop/explore-workshop/`} alternatePath={`/${de?'en':'de'}/workshop/explore-workshop/`} service>
 <section class="sv-hero sn-hero" aria-labelledby="home-title"><div class="hp-wrap" id="home-intro" tabindex="-1"><nav class="sv-breadcrumb" aria-label={de?'Seitenpfad':'Breadcrumb'}><a href={`${base}/${locale}/workshops/`}>Workshops</a><span aria-hidden="true">/</span><span>Explore</span></nav><h1 id="home-title">{t.title}<br/><em>{t.emphasis}</em></h1><div class="sn-hero-bottom"><p class="sv-lead">{t.intro}</p><div class="sn-actions"><a class="hp-button" href="#kontakt">{de?'Workshop besprechen':'Discuss a workshop'}<span aria-hidden="true">↓</span></a><a class="hp-text-link" href={de?'#ergebnis':'#outcome'}>{de?'Ergebnis ansehen':'See the outcome'}<span aria-hidden="true">↓</span></a></div></div></div></section>
 <section class="hp-section" id={de?'ergebnis':'outcome'} aria-labelledby="outcome-title"><div class="hp-wrap sp-assessment-grid"><div><h2 id="outcome-title">{t.resultTitle}<br/><em>{t.resultEmphasis}</em></h2><p class="hp-intro">{t.resultBody}</p><p class="sp-caption">{de?'Das Beispiel zeigt die Bewertung eines einzelnen Vorgangs. Im Workshop werden mögliche Ansätze gemeinsam eingeordnet und priorisiert.':'The example illustrates the assessment of one task. In the workshop, possible approaches are reviewed and prioritised together.'}</p></div><AssessmentExample locale={locale}/></div></section>
 <section class="hp-section sp-workshop-fields" aria-labelledby="fields-title"><div class="hp-wrap sp-fields-grid"><figure><img src={`${base}/explore-workshop/strategic-discovery-workshop-1280.webp`} srcset={`${base}/explore-workshop/strategic-discovery-workshop-720.webp 720w, ${base}/explore-workshop/strategic-discovery-workshop-1280.webp 1280w`} sizes="(max-width:760px) 90vw, 50vw" width="1280" height="853" loading="lazy" alt={de?'KI-generierte Illustration einer gemeinsamen Workshoparbeit':'AI-generated illustration of a collaborative workshop'}/><figcaption>{de?'KI-generierte Illustration':'AI-generated illustration'}</figcaption></figure><div><h2 id="fields-title">{de?'Fünf Fragen.':'Five questions.'}<br/><em>{de?'Ein gemeinsames Bild.':'One shared picture.'}</em></h2><dl class="sp-fields">{t.fields.map(([title,body])=><div><dt>{title}</dt><dd>{body}</dd></div>)}</dl></div></div></section>
 <AgencyContact locale={locale} copy={{title:t.closingTitle,emphasis:t.closingEmphasis,body:t.closingBody}} showKicker={false}/>
</AgencyDocument>
