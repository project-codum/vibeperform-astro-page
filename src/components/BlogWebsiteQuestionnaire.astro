---
import questionnaireScript from '../scripts/blogWebsiteQuestionnaire.js?raw';
import '../styles/blog-questionnaire.css';
interface Props { preview?: boolean; }
const { preview = true } = Astro.props;
const questions = [
  { name:'updateFrequency', title:'Wie oft aktualisieren Sie Ihre Webseite mit neuen Inhalten?', answers:[['weekly','Jede Woche','clock'],['monthly','Jeden Monat','calendar'],['rarely','Selten','leaf'],['never','Nie','pause']]},
  { name:'contentOwner', title:'Wer kümmert sich bei Ihnen um neue Inhalte?', answers:[['self','Ich selbst','person'],['team','Unser Team','team'],['external','Externe Betreuung','support'],['nobody','Niemand','person-off']]},
  { name:'updateObstacle', title:'Was erschwert Ihnen die Pflege Ihrer Webseite?', answers:[['time','Zu wenig Zeit','clock'],['ideas','Fehlende Ideen','lightbulb'],['technology','Umständliche Technik','tools'],['none','Nichts, läuft gut','check']]},
];
const paths = {
 person: 'M12 3a4 4 0 1 0 0 8 4 4 0 0 0 0-8 M5 21v-2a7 7 0 0 1 14 0v2',
 team: 'M9 3a3 3 0 1 0 0 6 3 3 0 0 0 0-6 M2 20v-2a7 7 0 0 1 14 0v2 M17 4a3 3 0 0 1 0 6 M19 13a5 5 0 0 1 3 5v2',
 support: 'M4 13v-2a8 8 0 0 1 16 0v2 M4 11H2v7h4v-7z M20 11h2v7h-4v-7z M20 18v2h-8',
 'person-off': 'M12 3a4 4 0 1 0 0 8 4 4 0 0 0 0-8 M4 21v-2a7 7 0 0 1 8-7 M16 15l6 6 M22 15l-6 6',
 lightbulb: 'M8 17c0-3-3-4-3-7a7 7 0 0 1 14 0c0 3-3 4-3 7z M8 20h8 M10 23h4 M12 13V9',
 check: 'M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18 M7 12l3 3 7-7',
 calendar: 'M5 5h14v15H5z M5 10h14 M8 3v4 M16 3v4 M8 13h2v2H8z M14 13h2v2h-2z',
 clock: 'M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18 M12 7v5l3 2',
 leaf: 'M5 19C2 9 9 4 20 4c0 11-5 18-15 15 M5 19l10-10 M10 14h5',
 window: 'M3 5h18v14H3z M3 9h18 M6 7h1 M9 7h1 M9 14h6 M12 11v6',
 spark: 'm12 3 2.5 6.5L21 12l-6.5 2.5L12 21l-2.5-6.5L3 12l6.5-2.5Z',
 compass: 'M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18 M16 8l-2 6-6 2 2-6z',
 pause: 'M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18 M9 8v8 M15 8v8',
 rocket: 'M9 15c1-7 6-11 11-11 0 5-4 10-11 11z M9 10H5l-2 5h6 M14 15v4l-5 2v-6 M6 18l-3 3 M14 9h.01',
 tools: 'm4 20 8-8 M14 4a5 5 0 0 0-4 8l2 2a5 5 0 0 0 8-4l-4 2-4-4z',
};
---
<section class="bq" id="webseite-weiterdenken" aria-label="Drei Fragen zu Ihrer Webseite" data-blog-questionnaire data-preview={String(preview)}>
  <noscript><p>Sie möchten über Ihre Webseite sprechen? Schreiben Sie uns eine <a href="mailto:contact@vibeperform.com">E-Mail</a>.</p></noscript>
  <form hidden novalidate data-bq-form>
    <div class="bq-topline"><p data-bq-progress aria-live="polite">Frage 1 von 3</p><button type="button" class="bq-back" data-bq-back hidden>← Zurück</button></div>
    {questions.map((question,index)=><div class="bq-panel" data-bq-panel={index} hidden={index!==0}>
      <h3 tabindex="-1">{question.title}</h3>
      <input type="hidden" name={question.name} value="" />
      <div class="bq-options" role="group" aria-label={question.title}>{question.answers.map(([value,label,icon])=><button type="button" class="bq-choice" data-bq-choice data-name={question.name} data-value={value} aria-pressed="false"><span class="bq-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"><path d={paths[icon as keyof typeof paths]} /></svg></span><span class="bq-choice-label">{label}</span><span class="bq-choice-check" aria-hidden="true">✓</span></button>)}</div>
    </div>)}
    <div class="bq-panel" data-bq-panel="3" hidden>
      <h3 tabindex="-1">Lernen wir uns kennen!</h3>
      <label class="bq-email-label" for="bq-email">Ihre E-Mail-Adresse</label>
      <input id="bq-email" class="bq-email" name="email" type="email" autocomplete="email" inputmode="email" maxlength="254" required aria-describedby="bq-purpose bq-error" placeholder="name@unternehmen.de" />
      <div class="bq-honey" aria-hidden="true"><label>Firmenwebseite<input name="companyWebsite" type="text" tabindex="-1" autocomplete="off" /></label></div>
      <details class="bq-answers"><summary>Ihre Antworten ansehen</summary><dl data-bq-answers></dl><button type="button" class="bq-edit" data-bq-edit>Antworten bearbeiten</button></details>
      <p id="bq-purpose" class="bq-purpose">Wir verwenden Ihre Angaben, um diese Anfrage zu bearbeiten. Keine Newsletter-Anmeldung. Weitere Informationen in unserer <a href="/de/datenschutz/">Datenschutzerklärung</a>.</p>
      {preview && <p class="bq-preview">Vorschau: Es werden keine Daten versendet oder gespeichert.</p>}
      <button type="submit" class="bq-next" data-bq-next>Senden</button>
    </div>
    <p id="bq-error" class="bq-error" role="alert" hidden></p>
  </form>
  <div class="bq-result" data-bq-result hidden tabindex="-1" role="status"><span class="bq-result-mark" aria-hidden="true">✓</span><h3 data-bq-result-title></h3><p data-bq-result-copy></p><button type="button" class="bq-edit" data-bq-restart>Antworten erneut ansehen</button></div>
</section>
<script is:inline data-blog-questionnaire-script set:html={questionnaireScript}></script>
