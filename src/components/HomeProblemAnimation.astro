---
import type { Locale } from '../lib/siteMetadata';
import '../styles/home-problem-animation.css';

interface Props { locale: Locale; variant?: 'problems' | 'website-static' | 'website' | 'profile'; }
const { locale, variant = 'problems' } = Astro.props as Props;
const de = locale === 'de';
const isProblems = variant === 'problems';
const isAnimated = variant === 'problems' || variant === 'website' || variant === 'profile';
const isServiceVisual = !isProblems;
const showWebsite = variant !== 'profile';
const showProfile = variant === 'problems' || variant === 'profile';
const copy = de
  ? {
      description: 'Website und Unternehmensprofil werden regelmäßig aktualisiert.',
      website: 'Website',
      profile: 'Unternehmensprofil',
      issues: ['Veraltete Website', 'Veraltetes Unternehmensprofil', 'Uneinheitliche Angaben'],
      growth: 'Regelmäßig aktualisieren. Mit dem Unternehmen weiterwachsen.',
    }
  : {
      description: 'The website and business profile are kept up to date.',
      website: 'Website',
      profile: 'Business profile',
      issues: ['Outdated website', 'Outdated business profile', 'Inconsistent details'],
      growth: 'Keep it updated. Grow it with your business.',
    };
---

<figure class:list={['hp-presence-loop', 'hp-presence-loop--' + variant, isAnimated && 'hp-presence-loop--animated']} data-presence-animation={isAnimated ? '' : undefined} aria-hidden={isServiceVisual ? 'true' : undefined}>
  <div class="hp-presence-panels">
    {showWebsite && <div class="hp-presence-card hp-presence-card--service-art">
      <h3>{copy.website}</h3>
      <div class:list={['hp-website-visual', variant === 'website-static' && 'hp-website-visual--unfold']}>
        {variant === 'website-static' && <span class="hp-website-orb" aria-hidden="true"></span>}
        <svg class="hp-illustration hp-illustration--website" viewBox="0 0 520 360" aria-hidden="true" focusable="false">
        <rect x="2" y="2" width="516" height="356" rx="14" fill="#f3f1f4" stroke="#ded9e2" stroke-width="2" />
        <circle cx="24" cy="23" r="5" fill="#c8c3cc" /><circle cx="42" cy="23" r="5" fill="#d7d2da" /><circle cx="60" cy="23" r="5" fill="#ded9e2" />
        <rect x="89" y="17" width="252" height="12" rx="6" fill="#d7d3dc" />
        <rect x="20" y="48" width="480" height="96" rx="9" fill="#e5e2e8" />
        <path d="M31 126 L138 75 L217 119 L319 65 L489 126 Z" fill="#c5c0cb" />
        <circle cx="163" cy="94" r="12" fill="#f3f1f4" />
        <rect x="20" y="159" width="212" height="10" rx="5" fill="#aaa4b0" />
        <rect x="20" y="178" width="340" height="7" rx="3.5" fill="#cec9d2" />
        <rect x="20" y="199" width="148" height="48" rx="8" fill="#e5e2e8" />
        <rect x="186" y="199" width="148" height="48" rx="8" fill="#e5e2e8" />
        <rect x="352" y="199" width="148" height="48" rx="8" fill="#e5e2e8" />
        <rect x="20" y="263" width="480" height="3" rx="1.5" fill="#d7d3dc" />
        <rect x="20" y="276" width="152" height="8" rx="4" fill="#aaa4b0" />
        <rect x="20" y="292" width="148" height="22" rx="6" fill="#e5e2e8" />
        <rect x="186" y="292" width="148" height="22" rx="6" fill="#e5e2e8" />
        <rect x="352" y="292" width="148" height="22" rx="6" fill="#e5e2e8" />
        <rect x="20" y="320" width="480" height="24" rx="6" fill="#f0edf2" />
        <rect x="32" y="328" width="172" height="7" rx="3.5" fill="#cec9d2" />
        <rect x="444" y="327" width="42" height="10" rx="5" fill="#d7d3dc" />

        <g class="hp-presence-change hp-change-one">
          <rect x="20" y="48" width="480" height="96" rx="9" fill="#e8d8ff" />
          <path d="M31 126 L138 75 L217 119 L319 65 L489 126 Z" fill="#9b62dc" />
          <circle cx="406" cy="78" r="17" fill="#ff9a7e" />
          <rect x="41" y="101" width="152" height="8" rx="4" fill="#fff" opacity=".86" />
          <rect x="41" y="116" width="98" height="6" rx="3" fill="#fff" opacity=".64" />
        </g>
        <g class="hp-presence-change hp-change-two">
          <rect x="20" y="199" width="148" height="48" rx="8" fill="#eee3ff" stroke="#b58ae6" stroke-width="2" />
          <circle cx="44" cy="223" r="10" fill="#772be5" /><path d="M40 223h8m-4-4v8" stroke="#fff" stroke-width="2" stroke-linecap="round" />
          <rect x="61" y="219" width="82" height="7" rx="3.5" fill="#8d55c8" />
        </g>
        <g class="hp-presence-change hp-change-three">
          <rect x="186" y="199" width="148" height="48" rx="8" fill="#fff0eb" stroke="#ff9a7e" stroke-width="2" />
          <circle cx="210" cy="223" r="10" fill="#f07c68" /><path d="M205 224l4 4 7-9" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
          <rect x="227" y="219" width="82" height="7" rx="3.5" fill="#a75b58" />
        </g>
        </svg>
      </div>
    </div>}

    {showProfile && <div class="hp-presence-card hp-presence-card--profile hp-presence-card--service-art">
      <h3>{de ? <>Unternehmens<wbr />profil</> : copy.profile}</h3>
      <svg class="hp-illustration hp-illustration--profile" viewBox="0 0 320 460" aria-hidden="true" focusable="false">
        <rect x="2" y="2" width="316" height="456" rx="27" fill="#fff" stroke="#ded9e2" stroke-width="2" />
        <rect x="15" y="15" width="290" height="430" rx="19" fill="#f3f1f4" />
        <rect x="123" y="22" width="74" height="6" rx="3" fill="#d7d3dc" />
        <circle cx="35" cy="48" r="3" fill="#aaa4b0" /><path d="M48 48h22m-22 7h16" stroke="#c7c2cb" stroke-width="3" stroke-linecap="round" />
        <rect x="25" y="68" width="270" height="92" rx="12" fill="#e5e2e8" />
        <circle cx="70" cy="139" r="29" fill="#c5c0cb" stroke="#fff" stroke-width="5" />
        <circle cx="70" cy="132" r="9" fill="#f3f1f4" /><path d="M52 153c3-12 11-17 18-17s15 5 18 17" fill="#f3f1f4" />
        <rect x="109" y="122" width="152" height="10" rx="5" fill="#aaa4b0" />
        <rect x="109" y="140" width="112" height="7" rx="3.5" fill="#cec9d2" />
        <rect x="25" y="178" width="126" height="35" rx="17" fill="#e5e2e8" />
        <g fill="#ded9e2" aria-hidden="true">
          <path d="M183 185l3.1 6.3 7 .9-5.1 4.9 1.2 7-6.2-3.4-6.2 3.4 1.2-7-5.1-4.9 7-.9z" />
          <path d="M207 185l3.1 6.3 7 .9-5.1 4.9 1.2 7-6.2-3.4-6.2 3.4 1.2-7-5.1-4.9 7-.9z" />
          <path d="M231 185l3.1 6.3 7 .9-5.1 4.9 1.2 7-6.2-3.4-6.2 3.4 1.2-7-5.1-4.9 7-.9z" />
          <path d="M255 185l3.1 6.3 7 .9-5.1 4.9 1.2 7-6.2-3.4-6.2 3.4 1.2-7-5.1-4.9 7-.9z" />
          <path d="M279 185l3.1 6.3 7 .9-5.1 4.9 1.2 7-6.2-3.4-6.2 3.4 1.2-7-5.1-4.9 7-.9z" />
        </g>
        <rect x="25" y="229" width="270" height="54" rx="10" fill="#e5e2e8" />
        <circle cx="47" cy="256" r="9" fill="#c5c0cb" /><path d="M44 256h6m-3-3v6" stroke="#f3f1f4" stroke-width="1.5" />
        <rect x="66" y="249" width="182" height="8" rx="4" fill="#aaa4b0" /><rect x="66" y="264" width="130" height="6" rx="3" fill="#cec9d2" />
        <rect x="25" y="296" width="270" height="54" rx="10" fill="#e5e2e8" />
        <circle cx="47" cy="323" r="9" fill="#c5c0cb" /><path d="M43 323h8" stroke="#f3f1f4" stroke-width="2" />
        <rect x="66" y="316" width="194" height="8" rx="4" fill="#aaa4b0" /><rect x="66" y="331" width="145" height="6" rx="3" fill="#cec9d2" />
        <rect x="25" y="363" width="270" height="58" rx="10" fill="#e5e2e8" />
        <circle cx="47" cy="392" r="9" fill="#c5c0cb" /><path d="M44 392h6m-3-3v6" stroke="#f3f1f4" stroke-width="1.5" />
        <rect x="66" y="384" width="176" height="8" rx="4" fill="#aaa4b0" /><rect x="66" y="399" width="112" height="6" rx="3" fill="#cec9d2" />

        <g class="hp-presence-change hp-change-four">
          <rect x="25" y="68" width="270" height="92" rx="12" fill="#eee3ff" />
          <circle cx="70" cy="139" r="29" fill="#772be5" stroke="#fff" stroke-width="5" />
          <circle cx="70" cy="132" r="9" fill="#fff" /><path d="M52 153c3-12 11-17 18-17s15 5 18 17" fill="#fff" />
          <rect x="109" y="122" width="152" height="10" rx="5" fill="#8950c4" />
          <rect x="109" y="140" width="112" height="7" rx="3.5" fill="#b68bda" />
        </g>
        <g class="hp-presence-change hp-change-five">
          <rect x="25" y="178" width="126" height="35" rx="17" fill="#eee3ff" stroke="#b58ae6" stroke-width="2" />
          <circle cx="46" cy="195" r="6" fill="#772be5" /><path d="M43 195h6m-3-3v6" stroke="#fff" stroke-width="1.5" />
          <rect x="59" y="192" width="72" height="6" rx="3" fill="#8950c4" />
        </g>
        <g fill="#ffb347" stroke="#f08a59" stroke-width=".7" aria-label={de ? 'Fünf Sterne erscheinen nacheinander' : 'Five stars appear one by one'}>
          <path class="hp-rating-star hp-rating-star--1" d="M183 185l3.1 6.3 7 .9-5.1 4.9 1.2 7-6.2-3.4-6.2 3.4 1.2-7-5.1-4.9 7-.9z" />
          <path class="hp-rating-star hp-rating-star--2" d="M207 185l3.1 6.3 7 .9-5.1 4.9 1.2 7-6.2-3.4-6.2 3.4 1.2-7-5.1-4.9 7-.9z" />
          <path class="hp-rating-star hp-rating-star--3" d="M231 185l3.1 6.3 7 .9-5.1 4.9 1.2 7-6.2-3.4-6.2 3.4 1.2-7-5.1-4.9 7-.9z" />
          <path class="hp-rating-star hp-rating-star--4" d="M255 185l3.1 6.3 7 .9-5.1 4.9 1.2 7-6.2-3.4-6.2 3.4 1.2-7-5.1-4.9 7-.9z" />
          <path class="hp-rating-star hp-rating-star--5" d="M279 185l3.1 6.3 7 .9-5.1 4.9 1.2 7-6.2-3.4-6.2 3.4 1.2-7-5.1-4.9 7-.9z" />
        </g>
        <g class="hp-presence-change hp-change-six">
          <rect x="25" y="229" width="270" height="54" rx="10" fill="#fff0eb" stroke="#ff9a7e" stroke-width="2" />
          <circle cx="47" cy="256" r="9" fill="#f07c68" /><path d="M43 256l3 3 5-6" fill="none" stroke="#fff" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
          <rect x="66" y="249" width="182" height="8" rx="4" fill="#a75b58" /><rect x="66" y="264" width="130" height="6" rx="3" fill="#e1aaa0" />
        </g>
        <g class="hp-presence-change hp-change-seven">
          <rect x="25" y="363" width="270" height="58" rx="10" fill="#f6e5ff" stroke="#b58ae6" stroke-width="2" />
          <circle cx="47" cy="392" r="9" fill="#772be5" /><path d="M43 392h8m-4-4v8" stroke="#fff" stroke-width="1.5" stroke-linecap="round" />
          <rect x="66" y="384" width="176" height="8" rx="4" fill="#8950c4" /><rect x="66" y="399" width="112" height="6" rx="3" fill="#b68bda" />
        </g>
      </svg>
    </div>}
  </div>
  {isProblems && <>
    <figcaption class="hp-presence-description">{copy.description}</figcaption>
    <ul class="hp-problem-issues" aria-label={de ? 'Probleme, die wir lösen' : 'Problems we solve'}>
      {copy.issues.map(issue => <li>{issue}</li>)}
    </ul>
    <p class="hp-presence-growth">{copy.growth}</p>
  </>}
</figure>
