---
import { Image } from 'astro:assets';
import interior from '../assets/website-service/interior.png';
const { locale } = Astro.props as { locale: 'de' | 'en' };
const en = locale === 'en';
const text = (de: string, english: string) => en ? english : de;
const steps = [
 [text('Verhalten erkennen','See what visitors do'),text('Wo entsteht Interesse? Wo geht es verloren?','What creates interest? Where do visitors drop off?'),text('Wir analysieren, welche Inhalte angesehen werden, wo Besucher klicken und wo der Weg zur Anfrage abbricht. Daraus entwickeln wir konkrete Verbesserungen.','We analyse which content people view, where they click and where they leave the enquiry journey. This helps us identify practical improvements.')],
 [text('Vorschläge erhalten','Get clear recommendations'),text('Ein Bericht. Klare nächste Schritte.','One report. Clear next steps.'),text('Jeden Monat erfahren Sie verständlich, was auffällt und was wir verbessern würden. Mit einem konkreten Vorschlag und dem Grund dahinter.','Each month, you receive a clear explanation of what stands out and what we recommend changing, along with the reason behind it.')],
 [text('Freigeben & verbessern','Approve & improve'),text('Sie geben Ihr Okay. Wir setzen um.','You give the go-ahead. We make it happen.'),text('Nach Ihrer Freigabe passen wir Inhalte und Anfragewege an. Anschließend prüfen wir die Wirkung – und nehmen die nächsten Verbesserungen in Angriff.','After your approval, we update content and enquiry journeys. Then we review the effect and work on the next improvements.')]
];
---
<section class="optimization-loop" id="betreuung" aria-labelledby="optimization-title">
 <div class="wrap">
  <div class="optimization-heading"><p class="optimization-kicker">{text('Ihr digitaler Vertriebsmitarbeiter · Von uns betreut','Your digital sales assistant · Managed by us')}</p><h2 id="optimization-title">{text('Ihre Website.','Your website.')}<br/><span>{text('Jeden Monat einen Schritt weiter.','One step further. Every month.')}</span></h2><p>{text('Wir erkennen, was Besucher überzeugt. Und verbessern Ihre Website mit Ihrem Okay. Für Anfragen, die Ihren Betrieb weiterbringen.','We learn what convinces visitors and improve your website with your approval. For enquiries that help your business move forward.')}</p></div>
  <div class="optimization-tabs" role="tablist" aria-label={text('So verbessern wir Ihre Website','How we improve your website')}>
   {steps.map((step,i)=><button type="button" role="tab" id={`optimization-tab-${i}`} aria-controls={`optimization-panel-${i}`} aria-selected={i===0?'true':'false'} tabindex={i===0?0:-1}><span class="optimization-number">0{i+1}</span><span>{step[0]}</span><span class="optimization-tab-arrow" aria-hidden="true">↗</span></button>)}
  </div>
  <div class="optimization-panels">
   {steps.map((step,i)=><div class:list={['optimization-panel',{'is-active':i===0}]} id={`optimization-panel-${i}`} role="tabpanel" aria-labelledby={`optimization-tab-${i}`} aria-hidden={i!==0?'true':'false'} inert={i!==0} tabindex="0">
    <div class="optimization-visual">
     <div class="optimization-windowbar"><span><i></i><i></i><i></i></span><small>{text('So kann es aussehen · Beispiel','How it could look · Example')}</small></div>
     {i===0 && <div class="heatmap-example"><div class="heatmap-nav"><strong>{text('Handwerk. Mit Charakter.','Craft. With character.')}</strong><span class="heatmap-projects">{text('Projekte','Projects')}<span class="heat-hotspot hotspot-one" aria-hidden="true"></span></span></div><div class="heatmap-site"><Image src={interior} alt="" loading="lazy" format="webp" widths={[400,800]} sizes="(max-width: 700px) 90vw, 600px"/><div><span class="visual-eyebrow">{text('Einbaumöbel nach Maß','Bespoke fitted furniture')}</span><strong>{text('Jede Nische verdient eine gute Idee.','Every corner deserves a good idea.')}</strong><span class="heatmap-cta">{text('Projekt anfragen','Enquire about a project')} ↗</span></div></div><div class="heat-hotspot hotspot-two" aria-hidden="true"></div><div class="heatmap-key"><span></span>{text('Klicks & Aufmerksamkeit · Illustration','Clicks & attention · Illustration')}</div></div>}
     {i===1 && <div class="monthly-example"><span class="visual-eyebrow">{text('Ihr Monatsbericht','Your monthly report')}</span><h3>{text('Das fällt auf. Das bringt Sie weiter.','What stands out. What comes next.')}</h3><div class="insight-row"><span>01</span><div><strong>{text('Erkannt','Observed')}</strong><p>{text('Interesse an Einbauschränken. Passende Projektbilder sind schwer zu finden.','Interest in fitted wardrobes. Relevant project photos are hard to find.')}</p></div></div><div class="insight-row"><span>02</span><div><strong>{text('Unser Vorschlag','Our recommendation')}</strong><p>{text('Ein passendes Projekt direkt bei der Leistung zeigen und zur Anfrage führen.','Show a relevant project alongside the service and guide visitors to an enquiry.')}</p></div></div><div class="approval-badge">{text('Bereit für Ihre Freigabe','Ready for your approval')} <span aria-hidden="true">↗</span></div></div>}
     {i===2 && <div class="improvement-example"><span class="approval-badge">✓ {text('Von Ihnen freigegeben','Approved by you')}</span><div class="updated-project"><Image src={interior} alt="" loading="lazy" format="webp" widths={[400,800]} sizes="(max-width: 700px) 90vw, 600px"/><div><span class="visual-eyebrow">{text('Jetzt direkt sichtbar','Now easy to find')}</span><h3>{text('Gute Arbeit. Klar gezeigt.','Good work. Clearly shown.')}</h3><p>{text('Projektbild, passende Erklärung und ein klarer nächster Schritt.','A project photo, a helpful explanation and a clear next step.')}</p></div></div><div class="repeat-note"><span aria-hidden="true">↻</span><div><strong>{text('Und jetzt? Wirkung prüfen.','What next? Review the effect.')}</strong><p>{text('Finden mehr passende Interessenten zur Anfrage?','Do more suitable prospects reach the enquiry?')}</p></div></div></div>}
    </div>
    <div class="optimization-explanation"><span class="optimization-stage-label">0{i+1} / 0{steps.length}</span><h3>{step[1]}</h3><p>{step[2]}</p><div class="optimization-takeaway"><span aria-hidden="true">↳</span>{[text('Hürden erkennen. Den nächsten Schritt erleichtern.','Spot obstacles. Make the next step easier.'),text('Sie wissen, was wir ändern würden – und warum.','Know what we recommend changing and why.'),text('Aktuell bleiben. Passende Anfragen gewinnen.','Stay current. Attract relevant enquiries.')][i]}</div></div>
   </div>)}
  </div>
  <div class="optimization-footer"><p><span aria-hidden="true">↻</span>{text('Kein einmaliges Update. Ein fortlaufender Kreislauf.','More than a one-off update. An ongoing cycle.')}</p><details class="disclosure"><summary>{text('Welche Daten fließen ein?','Which data do we use?')}</summary><p>{text('Mit spezialisierten Analyseverfahren erkennen wir, welche Inhalte Interesse wecken, wie Besucher sich auf Ihrer Website bewegen und was den Weg zur Anfrage erleichtert. Wir konzentrieren uns auf die Erkenntnisse, die Ihre Website gezielt verbessern – mit so viel Einblick wie nötig und so wenig Datenerhebung wie möglich. Die Auswertung erfolgt im Rahmen der erteilten Einwilligungen.','Specialist analysis methods help us understand which content attracts interest, how visitors navigate your website and what makes it easier to enquire. We focus on insights that support meaningful improvements, gathering as much insight as needed while keeping data collection to a minimum. Analysis stays within the scope of the consent given.')}</p></details><details class="disclosure"><summary>{text('Und Ihr Wissen aus dem Betriebsalltag?','What about what you learn in your day-to-day work?')}</summary><p>{text('Welche Anfragen passen wirklich? Was fragen Kunden immer wieder? Ihr Feedback hilft uns, Inhalte und Anfragewege gezielt weiterzuentwickeln. Neue Leistungen und Projekte beziehen wir gemeinsam mit Ihnen ein.','Which enquiries are a good fit? What do customers keep asking? Your feedback helps us improve content and enquiry journeys. We work with you to include new services and projects.')}</p></details></div>
 </div>
</section>
<script>
 document.querySelectorAll<HTMLElement>('.optimization-loop').forEach(root => {
  const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
  const panels = Array.from(root.querySelectorAll<HTMLElement>('[role="tabpanel"]'));
  const select = (index: number) => {
   tabs.forEach((tab,i)=>{tab.setAttribute('aria-selected',String(i===index));tab.tabIndex=i===index?0:-1;});
   panels.forEach((panel,i)=>{panel.classList.toggle('is-active',i===index);panel.setAttribute('aria-hidden',String(i!==index));panel.inert=i!==index;});
  };
  tabs.forEach((tab,index)=>{
   tab.addEventListener('click',()=>select(index));
   tab.addEventListener('keydown',event=>{
    let next=index;
    if(event.key==='ArrowRight') next=(index+1)%tabs.length;
    else if(event.key==='ArrowLeft') next=(index+tabs.length-1)%tabs.length;
    else if(event.key==='Home') next=0;
    else if(event.key==='End') next=tabs.length-1;
    else return;
    event.preventDefault();select(next);tabs[next].focus();
   });
  });
 });
</script>
<style>
.optimization-loop{background:#21162e;color:#fff;padding:100px 0;overflow:clip}.optimization-heading{max-width:890px}.optimization-kicker{color:#d2b6ff!important;font-size:13px!important;letter-spacing:.08em;text-transform:uppercase;margin:0 0 22px!important}.optimization-heading h2{font-size:clamp(38px,4.5vw,68px);line-height:1.04;letter-spacing:-.055em;margin:0 0 26px}.optimization-heading h2 span{color:#cdaaff}.optimization-heading>p{font-size:18px;line-height:1.65;color:#d8cfe1;max-width:740px}.optimization-tabs{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin:42px 0 18px}.optimization-tabs button{font:inherit;color:#d5cbdc;text-align:left;display:flex;align-items:center;gap:12px;padding:20px 16px;border:1px solid #594568;border-radius:12px;background:transparent;cursor:pointer;transition:background .2s,color .2s,border-color .2s;font-size:14px}.optimization-tabs button[aria-selected=true]{color:#21162e;background:#ddc8ff;border-color:#ddc8ff}.optimization-tabs button:hover{border-color:#d0aeff}.optimization-tabs button:focus-visible,.optimization-panel:focus-visible{outline:3px solid #b78aff;outline-offset:4px}.optimization-number{font-size:12px;opacity:.7}.optimization-tab-arrow{margin-left:auto}.optimization-panels{display:grid}.optimization-panel{grid-area:1/1;display:grid;grid-template-columns:1.3fr 1fr;gap:0;visibility:hidden;opacity:0;pointer-events:none;transition:opacity .24s,visibility .24s;background:#2e203c;border:1px solid #513b64;border-radius:20px;overflow:hidden}.optimization-panel.is-active{visibility:visible;opacity:1;pointer-events:auto}.optimization-visual{background:#f8f5fc;color:#21162e;margin:16px;border-radius:12px;min-width:0;overflow:hidden;align-self:start}.optimization-windowbar{display:flex;align-items:center;justify-content:space-between;padding:15px 20px;border-bottom:1px solid #e6deef;gap:10px}.optimization-windowbar>span{display:flex;gap:5px}.optimization-windowbar i{width:6px;height:6px;border-radius:50%;background:#c3b5d1}.optimization-windowbar small{font-size:10px;color:#766383}.optimization-explanation{padding:46px 38px;align-self:start}.optimization-stage-label{font-size:12px;color:#ceb0ee;letter-spacing:.08em}.optimization-explanation h3{font-size:clamp(26px,2.5vw,36px);line-height:1.13;letter-spacing:-.035em;margin:32px 0 20px}.optimization-explanation>p{font-size:16px;line-height:1.7;color:#d8cfe1}.optimization-takeaway{border-top:1px solid #5d456d;padding-top:22px;margin-top:26px;color:#ddc8ff;font-size:14px;display:flex;gap:12px;line-height:1.5}.monthly-example,.improvement-example{padding:32px}.visual-eyebrow{font-size:10px;letter-spacing:.06em;text-transform:uppercase;color:#7e658f;display:block}.heatmap-example{position:relative;isolation:isolate}.heatmap-nav{display:flex;align-items:center;justify-content:space-between;padding:22px;font-size:10px;gap:12px}.heatmap-nav>span{border-bottom:1px solid #856496}.heatmap-site{position:relative;margin:0 20px}.heatmap-site img{width:100%;height:305px;object-fit:cover;border-radius:7px;filter:brightness(.56)}.heatmap-site>div{position:absolute;inset:30px;display:flex;flex-direction:column;align-items:flex-start;justify-content:center;gap:18px;color:white}.heatmap-site .visual-eyebrow{color:#eee0fd}.heatmap-site strong{font-size:32px;letter-spacing:-.03em;line-height:1.08;max-width:280px}.heatmap-cta{background:#fff;color:#21162e;border-radius:5px;padding:11px 16px;font-size:11px}.heat-hotspot{position:absolute;pointer-events:none;border-radius:50%;background:radial-gradient(ellipse,#ff482ba6 0%,#ffde4b80 20%,#8aff7980 36%,#79a5f35c 55%,transparent 70%);mix-blend-mode:screen;width:210px;height:130px}.heatmap-projects{position:relative}.hotspot-one{left:50%;top:50%;transform:translate(-50%,-50%)}.hotspot-two{bottom:22px;left:14px;width:230px;height:180px}.heatmap-key{display:flex;align-items:center;gap:8px;font-size:10px;color:#756780;padding:18px 22px}.heatmap-key>span{width:45px;height:6px;background:linear-gradient(90deg,#84a9fc,#83f883,#ffe350,#fb6d5d);border-radius:8px}.monthly-example h3{font-size:29px;line-height:1.1;letter-spacing:-.035em;margin:20px 0}.insight-row{display:flex;gap:18px;padding:20px 0;border-top:1px solid #e6dced}.insight-row>span{font-size:11px;background:#eadefb;flex:0 0 28px;height:28px;border-radius:50%;display:grid;place-items:center}.insight-row strong{font-size:13px}.insight-row p,.updated-project p,.repeat-note p{font-size:13px;line-height:1.55;color:#756381;margin:7px 0 0}.approval-badge{display:flex;justify-content:space-between;gap:10px;align-items:center;background:#e8dcf7;border:1px solid #d8c0f0;padding:13px 16px;border-radius:7px;font-size:12px;color:#60358a}.updated-project{margin:24px 0;display:grid;grid-template-columns:1fr 1fr;gap:20px;align-items:center}.updated-project img{width:100%;height:205px;object-fit:cover;border-radius:8px}.updated-project h3{font-size:26px;line-height:1.05;letter-spacing:-.03em;margin:12px 0}.repeat-note{display:flex;gap:16px;border-top:1px solid #e3d6ed;padding-top:22px}.repeat-note>span{font-size:35px;color:#8745cf}.repeat-note strong{font-size:14px}.optimization-footer{margin-top:26px;display:grid;grid-template-columns:1.2fr 1fr 1fr;gap:28px;align-items:start}.optimization-footer>p{font-size:15px;color:#d8c8e7;line-height:1.5;display:flex;align-items:center;gap:12px;margin:17px 0}.optimization-footer>p>span{font-size:24px;line-height:1;flex:none;color:#caa3f8}.optimization-footer details{border-color:#564362;margin:0}.optimization-footer summary{font-size:13px;padding:20px 20px 20px 0}.optimization-footer details p{font-size:13px;color:#d8cfe1;line-height:1.65}.optimization-footer summary::after{color:#ceb0ee}
@media(max-width:900px){.optimization-tabs button{font-size:12px;padding:16px 12px;gap:8px}.optimization-explanation{padding:30px 24px}.optimization-footer{grid-template-columns:1fr 1fr}.optimization-footer>p{grid-column:1/-1;margin:0}.monthly-example,.improvement-example{padding:24px}.updated-project{gap:12px}.updated-project h3{font-size:23px}}
@media(max-width:700px){.optimization-loop{padding:64px 0}.optimization-heading>p{font-size:16px}.optimization-kicker{font-size:10px!important}.optimization-tabs{grid-template-columns:1fr;margin-top:30px}.optimization-tabs button{min-height:66px}.optimization-panel{grid-template-columns:1fr;align-content:start}.optimization-visual{margin:10px;min-height:408px}.optimization-explanation{padding:24px;min-height:330px}.optimization-explanation h3{margin:18px 0}.optimization-explanation>p{font-size:14px}.optimization-takeaway{margin-top:20px;padding-top:18px;font-size:13px}.optimization-footer{grid-template-columns:1fr;gap:8px}.optimization-footer>p{margin:0 0 8px}.heatmap-site img{height:295px}.heatmap-site>div{inset:24px}.heatmap-site strong{font-size:29px}.updated-project img{height:195px}.updated-project h3{font-size:25px}.updated-project p{font-size:11px}.monthly-example h3{font-size:27px}}
@media(prefers-reduced-motion:reduce){.optimization-panel,.optimization-tabs button{transition:none}}
</style>
