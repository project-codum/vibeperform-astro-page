---
import { bookingEmbedUrl, bookingUrl, type Locale } from '../lib/siteMetadata';
interface Props { locale: Locale; }
const { locale } = Astro.props;
const de = locale === 'de';
const t = de ? {
  button: 'Termin finden',
  description: 'Lädt die freien Termine von Google Kalender.',
  external: 'Kalender in neuem Tab öffnen',
  hide: 'Kalender schließen',
  loading: 'Wir laden die freien Termine …',
  frame: 'Freie Termine für Ihr Erstgespräch mit VibePerform',
} : {
  button: 'Find a time',
  description: 'Loads available times from Google Calendar.',
  external: 'Open calendar in a new tab',
  hide: 'Close calendar',
  loading: 'Loading available times …',
  frame: 'Available times for your introductory call with VibePerform',
};
---
<div class="booking-calendar" data-booking-calendar data-phase="closed">
  <div class="booking-placeholder" data-booking-placeholder>
    <button class="hp-button booking-load" type="button" data-booking-load hidden aria-description={t.description} aria-controls={`booking-panel-${locale}`} aria-expanded="false" data-analytics-event="contact_start" data-analytics-name="load-booking-calendar" data-analytics-location="home-contact">{t.button}<span aria-hidden="true">↗</span></button>
    <a class="hp-button booking-fallback" data-booking-fallback href={bookingUrl} target="_blank" rel="noopener noreferrer">{t.button}<span aria-hidden="true">↗</span></a>
  </div>
  <div class="booking-panel" id={`booking-panel-${locale}`} data-booking-panel hidden aria-busy="false">
    <div class="booking-window">
      <div class="booking-status" role="status" data-booking-status>
        <div class="booking-preview" aria-hidden="true">
          <svg class="booking-spark" viewBox="88 32 84 68.5"><path fill="currentColor" d="M128 32C128 57 118 68 88 68C118 68 128 79 128 100.5C128 79 140 68 172 68C140 68 128 57 128 32Z" /></svg>
          <div class="booking-preview-line"></div>
          <div class="booking-preview-grid">{Array.from({length:21},(_,i)=><span style={`--cell:${i}`} />)}</div>
        </div>
        <p>{t.loading}</p>
      </div>
      <iframe data-booking-frame data-src={`${bookingEmbedUrl}&hl=${locale}`} title={t.frame} width="100%" height="720" referrerpolicy="no-referrer" data-cmp-ab="1"></iframe>
    </div>
    <div class="booking-tools"><a href={bookingUrl} target="_blank" rel="noopener noreferrer">{t.external}<span aria-hidden="true">↗</span></a><button type="button" data-booking-hide>{t.hide}</button></div>
  </div>
</div>
<script>
  import { mountBookingCalendar } from '../scripts/bookingCalendar';
  document.querySelectorAll<HTMLElement>('[data-booking-calendar]').forEach(mountBookingCalendar);
</script>
<style>
  .booking-calendar{width:100%;max-width:1040px;margin:36px auto 0;text-align:center}
  .booking-load{cursor:pointer;font-family:inherit}
  .booking-load[hidden],.booking-fallback[hidden],.booking-panel[hidden],.booking-placeholder[hidden],.booking-status[hidden]{display:none}
  .booking-panel{text-align:left;background:#fff;border:1px solid #d6c9e0;border-radius:16px;overflow:hidden;box-shadow:0 18px 55px -38px #32214066;transform-origin:top center}
  .booking-window{position:relative;background:white}
  .booking-window iframe{display:block;width:100%;height:720px;border:0;background:#fff;opacity:0}
  [data-phase=ready] .booking-window iframe{opacity:1}
  .booking-status{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:flex-start;padding:100px 24px 32px;background:#fff;color:#745188;text-align:center;pointer-events:none}
  .booking-status p{font-size:14px;line-height:1.6;color:#706873;margin:32px 0 0}
  .booking-preview{width:min(320px,90%)}
  .booking-spark{display:block;width:70px;height:58px;margin:0 auto 30px;color:#ad46ff}
  .booking-preview-line{height:8px;width:40%;border-radius:4px;background:#e9dff1;margin-bottom:22px}
  .booking-preview-grid{display:grid;grid-template-columns:repeat(7,1fr);gap:10px}
  .booking-preview-grid span{aspect-ratio:1;border-radius:9px;background:#eee6f5}
  .booking-tools{display:flex;justify-content:space-between;align-items:center;gap:20px;padding:15px 22px;border-top:1px solid #eee7f2;font-size:12px;line-height:1.6}
  .booking-tools a{display:inline-flex;gap:15px;align-items:center;color:#745188;text-decoration:underline;text-underline-offset:4px}
  .booking-tools button{background:none;border:0;color:#706873;text-decoration:underline;text-underline-offset:4px;cursor:pointer;font:inherit}
  .booking-calendar :is(button,a):focus-visible{outline:3px solid #8038ee;outline-offset:4px}
  @media(prefers-reduced-motion:no-preference){
    [data-phase=loading] .booking-spark{animation:booking-spark-breathe 2.4s ease-in-out infinite}
    [data-phase=loading] .booking-preview-grid span{animation:booking-cell-wave 1.8s ease-in-out infinite;animation-delay:calc(var(--cell)*45ms)}
    [data-phase=ready] .booking-window iframe{animation:booking-content-in .3s ease-out both}
    @keyframes booking-spark-breathe{50%{transform:rotate(90deg) scale(.82);opacity:.7}}
    @keyframes booking-cell-wave{50%{transform:translateY(-5px);background:#d8bdf2}}
    @keyframes booking-content-in{from{opacity:0;transform:translateY(5px)}to{opacity:1;transform:none}}
  }
  @media(max-width:700px){.booking-calendar{margin-top:28px}.booking-panel{border-radius:12px}.booking-placeholder .hp-button{justify-content:space-between;padding:15px 22px}.booking-window iframe{height:1100px}.booking-status{padding:80px 20px 30px}.booking-tools{flex-wrap:wrap;padding:14px 16px;gap:13px}.booking-tools :is(a,button){min-height:36px}}
</style>
