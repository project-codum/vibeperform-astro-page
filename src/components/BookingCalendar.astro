---
import { bookingEmbedUrl, bookingUrl, type Locale } from '../lib/siteMetadata';

interface Props { locale: Locale; analyticsLocation?: string; }
const { locale, analyticsLocation = 'home-contact' } = Astro.props;
const t = locale === 'de' ? {
  title: 'Kennenlerngespräch',
  button: 'Termin finden',
  external: 'Kalender in neuem Tab öffnen',
  close: 'Kalender schließen',
} : {
  title: 'Introductory call',
  button: 'Find a time',
  external: 'Open calendar in a new tab',
  close: 'Close calendar',
};
---
<div class="booking-calendar" id="terminbuchung" data-booking-calendar data-phase="closed">
  <a class="hp-button booking-trigger" data-booking-fallback href={bookingUrl} target="_blank" rel="noopener noreferrer">{t.button}</a>
  <button class="hp-button booking-trigger" type="button" data-booking-open hidden aria-expanded="false" aria-controls="booking-panel" data-analytics-event="contact_start" data-analytics-name="load-booking-calendar" data-analytics-location={analyticsLocation}>{t.button}</button>
  <div class="booking-panel" role="region" id="booking-panel" data-booking-panel aria-label={t.title} hidden tabindex="-1">
    <div class="booking-tools">
      <button type="button" data-booking-close>{t.close}</button>
      <a href={bookingUrl} target="_blank" rel="noopener noreferrer">{t.external}<span aria-hidden="true"> ↗</span></a>
    </div>
    <iframe title={t.title} data-booking-frame data-src={`${bookingEmbedUrl}&hl=${locale}`} loading="lazy" referrerpolicy="no-referrer" width="100%" height="720" data-cmp-ab="1"></iframe>
  </div>
</div>
<script>
  import { mountBookingCalendar } from '../scripts/bookingCalendar';
  document.querySelectorAll<HTMLElement>('[data-booking-calendar]').forEach(mountBookingCalendar);
</script>
<style>
  .booking-calendar { width: 100%; max-width: 1040px; margin: 28px auto 0; text-align: center; scroll-margin-top: 105px; }
  .booking-calendar [hidden] { display: none; }
  .booking-trigger { min-width: 180px; background: #573869; border-color: #573869; color: #fff; font: inherit; cursor: pointer; }
  .booking-trigger:hover { background: #402a4d; }
  .booking-panel { text-align: left; background: #fff; border: 1px solid #d6c9e0; border-radius: 16px; overflow: hidden; }
  .booking-tools { display: flex; justify-content: space-between; align-items: center; gap: 8px 24px; flex-wrap: wrap; padding: 3px 22px; border-bottom: 1px solid #eee7f2; background: #f8f4fb; }
  .booking-tools :is(a, button) { display: inline-flex; align-items: center; min-height: 44px; padding: 4px 0; color: #573869; font: inherit; font-size: .875rem; text-decoration: underline; text-underline-offset: 3px; }
  .booking-tools button { border: 0; background: transparent; cursor: pointer; }
  .booking-panel iframe { display: block; width: 100%; height: 720px; border: 0; background: #fff; }
  .booking-calendar :is(a, button):focus-visible { outline: 2px solid #8038ee; outline-offset: 3px; }
  @media (max-width: 700px) {
    .booking-panel { border-radius: 12px; }
    .booking-tools { padding-inline: 14px; }
    .booking-panel iframe { height: 990px; }
  }
</style>
