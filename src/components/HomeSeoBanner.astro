---
interface Props { title: string; body: string; href: string; link: string; }
const { title, body, href, link } = Astro.props;
---
<div class="hp-seo-banner">
  <div class="hp-seo-heading">
    <div class="hp-seo-copy"><h3>{title}</h3><p>{body}</p></div>
    <div class="hp-seo-actions">
      <a class="hp-text-link" href={href}>{link}<span aria-hidden="true">↗</span></a>
    </div>
  </div>
</div>
