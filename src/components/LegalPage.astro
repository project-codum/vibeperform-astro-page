---
import AgencyFooter from './AgencyFooter.astro';
import ConsentManagerHead from './ConsentManagerHead.astro';
import HomeNavigation from './HomeNavigation.astro';
import SmoothScroll from './SmoothScroll.astro';
import { homeIntroContent } from '../data/homeIntroContent';
import type { LegalContent } from '../data/legalContent';
import { absoluteUrl, type Locale } from '../lib/siteMetadata';
import '../styles/global.css';
import '../styles/home-page.css';

interface Props {
  content: LegalContent;
  locale: Locale;
  path: string;
  alternatePath: string;
}

const { content, locale, path, alternatePath } = Astro.props;
const alternateLocale = locale === 'de' ? 'en' : 'de';
const base = (import.meta.env.BASE_URL ?? '/').replace(/\/$/, '');
const canonical = absoluteUrl(path);
const alternate = absoluteUrl(alternatePath);
---
<html lang={locale} class="home-document">
  <head>
    <ConsentManagerHead locale={locale} />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/png" href={`${base}/favicon-spark-20261012.png`} />
    <title>{content.metaTitle}</title>
    <meta name="description" content={content.metaDescription} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang={locale} href={canonical} />
    <link rel="alternate" hreflang={alternateLocale} href={alternate} />
    <link rel="alternate" hreflang="x-default" href={locale === 'de' ? canonical : alternate} />
  </head>
  <body>
    <div class="home-shell home-shell--front" id="top">
      <HomeNavigation copy={homeIntroContent[locale]} locale={locale} alternateLocaleHref={`${base}${alternatePath}`} />
      <main class="home-main">
        <header class="legal-hero" id="home-intro" tabindex="-1">
          <div class="legal-wrap">
            <p class="legal-kicker">{content.kicker}</p>
            <h1>{content.title}</h1>
            <div class="legal-rich-text legal-intro">
              {content.intro.map(paragraph => <p set:html={paragraph} />)}
            </div>
            <p class="legal-updated">{content.updatedLabel}: {content.updated}</p>
          </div>
        </header>

        <div class="legal-content">
          <div class="legal-wrap">
            {content.noticeItems.length > 0 && (
              <section class="legal-notice" aria-labelledby="legal-notice-title">
                <h2 id="legal-notice-title">{content.noticeTitle}</h2>
                <ul class="legal-rich-text">
                  {content.noticeItems.map(item => <li set:html={item} />)}
                </ul>
              </section>
            )}
            {content.sections.map(section => (
              <section class="legal-section">
                <h2>{section.title}</h2>
                <div class="legal-rich-text">
                  {section.paragraphs.map(paragraph => <p set:html={paragraph} />)}
                </div>
              </section>
            ))}
          </div>
        </div>
      </main>
      <AgencyFooter locale={locale} />
    </div>
    <SmoothScroll />
  </body>
</html>

<style>
  .legal-wrap {
    width: min(52rem, calc(100% - 3rem));
    margin-inline: auto;
  }

  .legal-hero {
    padding: clamp(8.25rem, 13vw, 11rem) 0 clamp(3rem, 7vw, 6rem);
    background:
      radial-gradient(ellipse at 85% 12%, #332544 0, transparent 66%),
      linear-gradient(160deg, #111116 30%, #211929);
    color: #f7f4fb;
  }

  .legal-kicker {
    margin: 0 0 1rem;
    color: #d9c4ee;
    font-size: .875rem;
  }

  .legal-hero h1 {
    margin: 0;
    font-size: clamp(2rem, 6vw, 5rem);
    font-weight: 400;
    line-height: 1.08;
    letter-spacing: -.055em;
    overflow-wrap: anywhere;
  }

  .legal-intro {
    margin-top: clamp(1.2rem, 3vw, 2rem);
    max-width: 68ch;
    color: #eee7f3;
  }

  .legal-updated {
    margin: 1.5rem 0 0;
    color: #d3c6dc;
    font-size: .875rem;
  }

  .legal-content {
    padding-block: clamp(3rem, 7vw, 6rem);
    background: var(--hp-paper);
    color: var(--hp-ink);
  }

  .legal-section + .legal-section {
    margin-top: clamp(1.75rem, 4vw, 3rem);
    padding-top: clamp(1.75rem, 4vw, 3rem);
    border-top: 1px solid var(--hp-line);
  }

  .legal-content h2 {
    margin: 0 0 1rem;
    font-size: clamp(1.35rem, 3vw, 2rem);
    font-weight: 400;
    line-height: 1.2;
    letter-spacing: -.025em;
    overflow-wrap: anywhere;
  }

  .legal-rich-text {
    display: grid;
    gap: .95rem;
    font-size: clamp(1rem, 1.4vw, 1.125rem);
    line-height: 1.7;
    overflow-wrap: anywhere;
  }

  .legal-rich-text p { margin: 0; }

  .legal-rich-text :global(a) {
    color: #60436e;
    text-decoration: underline;
    text-underline-offset: .2em;
  }

  .legal-hero .legal-rich-text :global(a) { color: #e6d2fa; }
  .legal-rich-text :global(a:focus-visible) { outline: 2px solid currentColor; outline-offset: 3px; }

  .legal-rich-text :global(code) {
    padding: .1rem .3rem;
    border-radius: .25rem;
    background: #e7deee;
    color: #28232e;
    font-size: .92em;
  }

  .legal-notice {
    margin-bottom: 2rem;
    padding: 1.25rem;
    border: 1px solid var(--hp-line);
    border-radius: .75rem;
    background: #eee7f3;
  }

  .legal-notice ul {
    margin: 0;
    padding-left: 1.25rem;
    list-style: disc;
  }
</style>
