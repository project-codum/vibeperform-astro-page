---
interface Props {nav:any;homeHref:string;alternateLocaleHref:string;currentLocale:'de'|'en'}
const {nav,homeHref,alternateLocaleHref,currentLocale}=Astro.props;
const base=import.meta.env.BASE_URL.replace(/\/$/,'');
---
<header><div class="wrap header-in"><a class="brand" href={homeHref} aria-label={currentLocale==='de'?'Zur VibePerform-Startseite':'VibePerform homepage'}><img src={`${base}/vibeperform-logo.png`} alt="VibePerform" width="184" height="78" /></a><nav class="nav" aria-label={currentLocale==='de'?'Hauptnavigation':'Main navigation'}>{nav.links.map((link:{label:string;href:string})=><a href={link.href}>{link.label}</a>)}<a class="website-language" href={alternateLocaleHref} aria-label={nav.toggleAriaLabel} data-locale-switch data-target-locale={currentLocale==='de'?'en':'de'} data-analytics-location="website-navigation">{nav.toggleLabel}</a><a class="btn" href="#anfrage" data-analytics-event="contact_start" data-analytics-name="website-project-inquiry" data-analytics-location="website-navigation">{currentLocale==='de'?'Projekt anfragen':'Start a project'}</a></nav></div></header>
