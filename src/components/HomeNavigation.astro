---
import { serviceMenu } from '../data/serviceContent';
import type { HomeIntroContent } from '../data/homeIntroContent';

interface Props { copy: HomeIntroContent; locale: 'de' | 'en'; alternateLocaleHref: string; }
const { copy, locale, alternateLocaleHref } = Astro.props;
const de = locale === 'de';
const base = (import.meta.env.BASE_URL ?? '/').replace(/\/$/, '');
const currentPath = Astro.url.pathname;
const active = (path: string) => currentPath === `${base}${path}`;
const agencyPath = `/${locale}/${de ? 'ueber-uns' : 'about-us'}/`;
const insightsPath = `/${locale}/blog/`;
const localize = (text: string) => de ? text.replaceAll('Websites', 'Webseiten').replaceAll('Website', 'Webseite') : text;
type MenuLink = { href: string; label: string; description?: string; language?: 'de' };
const agencyLinks: MenuLink[] = [
  { href: agencyPath, label: de ? 'Über uns' : 'About us' },
  { href: '/de/fallstudien/wunderwelt-kids/', label: de ? 'Fallstudien' : 'Case studies', language: 'de', description: de ? undefined : 'In German' },
];
const dropdowns = [
  { className: 'home-services-menu', label: de ? 'Leistungen' : 'Services', groups: serviceMenu(locale) },
  { className: 'home-agency-menu', label: de ? 'Agentur' : 'Agency', groups: [{ title: '', links: agencyLinks }] },
];
---
<a class="home-skip" href="#home-intro">{copy.skipLabel}</a>
<header class="home-navigation">
  <vf-home-navigation>
    <a class="home-brand" href={`${base}/${locale}/`} aria-label={copy.homeLabel}>
      <img src={`${base}/vibeperform-logo-a-20261020-dunkel.svg`} alt="VibePerform" width="224" height="132" loading="eager" decoding="async" />
    </a>
    <button class="home-menu-toggle" type="button" aria-controls="home-menu" aria-expanded="false" data-open-label={copy.menuLabel} data-close-label={copy.closeLabel} hidden>
      <span data-menu-label>{copy.menuLabel}</span><span class="home-menu-icon" aria-hidden="true"></span>
    </button>
    <nav id="home-menu" aria-label={copy.navLabel} data-lenis-prevent>
      {dropdowns.map(({ className, label, groups }) => <details class={className}>
        <summary class:list={{ 'home-dropdown-active': groups.some(group => group.links.some(link => active(link.href))) }}>
          {label}<span class="home-chevron" aria-hidden="true"></span>
        </summary>
        <div class="home-mega-panel">
          <div class="home-mega-mobile-head">
            <button class="home-mega-back" type="button" hidden>
              <span class="home-chevron" aria-hidden="true"></span>{de ? 'Zurück' : 'Back'}
            </button>
            <span>{label}</span>
          </div>
          <div class="home-mega-columns">
            {groups.map(group => (
              <div class="home-mega-group">
                {group.title && <h2>{localize(group.title)}</h2>}
                <ul>
                  {group.links.map((link: MenuLink) => (
                    <li>
                      <a href={`${base}${link.href}`} aria-current={active(link.href) ? 'page' : undefined} hreflang={link.language}>
                        <span class="home-mega-link-copy">
                          <strong>{localize(link.label)}</strong>
                          {link.description && <span>{localize(link.description)}</span>}
                        </span>
                        <span class="home-chevron" aria-hidden="true"></span>
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        </div>
      </details>)}
      <div class="home-main-links">
        <a aria-current={currentPath.startsWith(`${base}${insightsPath}`) ? (active(insightsPath) ? 'page' : 'location') : undefined} href={`${base}${insightsPath}`}>{de ? 'Wissen' : 'Insights'}</a>
      </div>
      <div class="home-nav-actions">
        <a class="home-nav-contact" data-booking-entry href={copy.primaryHref} data-analytics-event="contact_start" data-analytics-name="book-discovery-call" data-analytics-location="home-navigation">{copy.primaryLabel}<span aria-hidden="true">↗</span></a>
        <a class="home-language" href={alternateLocaleHref} aria-label={copy.languageAria} data-locale-switch data-target-locale={de ? 'en' : 'de'} data-analytics-location="home-navigation">{copy.languageLabel}</a>
      </div>
    </nav>
  </vf-home-navigation>
</header>
<noscript><style>.home-navigation{position:relative;background:#111116}.vf-hero{padding-top:0}</style></noscript>
<script>
  class HomeNavigation extends HTMLElement {
    private cleanup?: () => void;

    connectedCallback() {
      if (this.cleanup) return;
      const toggle = this.querySelector<HTMLButtonElement>('.home-menu-toggle')!;
      const toggleLabel = toggle.querySelector<HTMLElement>('[data-menu-label]')!;
      const menu = this.querySelector<HTMLElement>('nav')!;
      const dropdowns = Array.from(menu.querySelectorAll<HTMLDetailsElement>('details'), details => ({
        details,
        summary: details.querySelector<HTMLElement>('summary')!,
        panel: details.querySelector<HTMLElement>('.home-mega-panel')!,
        back: details.querySelector<HTMLButtonElement>('.home-mega-back')!,
      }));
      const mobile = matchMedia('(max-width: 900px)');
      const events = new AbortController();
      const options = { signal: events.signal };
      let activeDropdown: typeof dropdowns[number] | undefined;
      let leaveTimer: number | undefined;
      let openedOnHover = false;

      const setDropdown = (next?: typeof activeDropdown, byHover = false) => {
        window.clearTimeout(leaveTimer);
        if (activeDropdown && activeDropdown !== next) activeDropdown.details.open = false;
        activeDropdown = next;
        openedOnHover = byHover;
        if (next) next.details.open = true;
        if (mobile.matches) menu.scrollTop = 0;
      };
      const setMenu = (open: boolean) => {
        if (!open) setDropdown();
        toggle.setAttribute('aria-expanded', String(open));
        toggleLabel.textContent = open ? toggle.dataset.closeLabel! : toggle.dataset.openLabel!;
        menu.hidden = mobile.matches && !open;
      };
      const sync = () => {
        const focusInMenu = menu.contains(document.activeElement);
        const desktopFocus = activeDropdown?.panel.contains(document.activeElement)
          ? activeDropdown.summary
          : document.activeElement === toggle ? dropdowns[0]?.summary : undefined;
        toggle.hidden = !mobile.matches;
        dropdowns.forEach(({ back }) => { back.hidden = !mobile.matches; });
        setMenu(false);
        if (mobile.matches && focusInMenu) toggle.focus();
        else if (!mobile.matches) desktopFocus?.focus();
      };

      // A disclosure opened before enhancement may already have focus inside it.
      activeDropdown = dropdowns.find(({ details }) => details.open);
      this.dataset.enhanced = 'true';
      sync();
      mobile.addEventListener('change', sync, options);
      toggle.addEventListener('click', () => setMenu(menu.hidden), options);

      dropdowns.forEach(dropdown => {
        const { details, summary, panel, back } = dropdown;
        summary.addEventListener('click', event => {
          event.preventDefault();
          const open = activeDropdown !== dropdown || (openedOnHover && event.detail > 0);
          setDropdown(open ? dropdown : undefined);
          if (open && mobile.matches) back.focus({ preventScroll: true });
        }, options);
        back.addEventListener('click', () => {
          setDropdown();
          summary.focus({ preventScroll: true });
        }, options);

        summary.addEventListener('pointerenter', event => {
          if (mobile.matches || event.pointerType !== 'mouse') return;
          window.clearTimeout(leaveTimer);
          if (activeDropdown !== dropdown && !activeDropdown?.panel.contains(document.activeElement)) {
            setDropdown(dropdown, true);
          }
        }, options);
        panel.addEventListener('pointerenter', () => window.clearTimeout(leaveTimer), options);
        details.addEventListener('pointerleave', event => {
          if (mobile.matches || event.pointerType !== 'mouse' || activeDropdown !== dropdown) return;
          window.clearTimeout(leaveTimer);
          leaveTimer = window.setTimeout(() => {
            if (openedOnHover && !details.matches(':hover') && !panel.contains(document.activeElement)) setDropdown();
          }, 140);
        }, options);
        details.addEventListener('focusout', event => {
          if (!mobile.matches && activeDropdown === dropdown && event.relatedTarget
            && !details.contains(event.relatedTarget as Node)) setDropdown();
        }, options);
      });

      document.addEventListener('keydown', event => {
        if (event.key !== 'Escape') return;
        if (activeDropdown) {
          const { summary } = activeDropdown;
          const restoreFocus = this.contains(document.activeElement);
          setDropdown();
          if (restoreFocus) summary.focus({ preventScroll: true });
        } else if (mobile.matches && !menu.hidden) {
          setMenu(false);
          toggle.focus({ preventScroll: true });
        } else return;
        event.preventDefault();
        event.stopPropagation();
      }, options);
      this.addEventListener('click', event => {
        const link = (event.target as Element).closest<HTMLAnchorElement>('a');
        if (!link) return;
        if (link.dataset.targetLocale) {
          try { localStorage.setItem('vibeperform:locale', link.dataset.targetLocale); } catch { /* Language links still navigate without storage. */ }
        }
        if (mobile.matches && !menu.hidden) toggle.focus({ preventScroll: true });
        else if (activeDropdown?.panel.contains(link)) activeDropdown.summary.focus({ preventScroll: true });
        setMenu(false);
      }, options);
      document.addEventListener('click', event => {
        if (this.contains(event.target as Node)) return;
        if (mobile.matches && menu.contains(document.activeElement)) toggle.focus({ preventScroll: true });
        else if (!mobile.matches && activeDropdown?.panel.contains(document.activeElement)) activeDropdown.summary.focus({ preventScroll: true });
        setMenu(false);
      }, options);
      this.addEventListener('focusout', event => {
        if (event.relatedTarget && !this.contains(event.relatedTarget as Node)) setMenu(false);
      }, options);

      this.cleanup = () => {
        window.clearTimeout(leaveTimer);
        events.abort();
        this.cleanup = undefined;
      };
    }
    disconnectedCallback() { this.cleanup?.(); }
  }
  if (!customElements.get('vf-home-navigation')) customElements.define('vf-home-navigation', HomeNavigation);
</script>
<style>
  .home-navigation {
    --nav-text: #f7f3fb;
    --nav-muted: #c9bfd3;
    --nav-accent: #e2c7fb;
    --nav-line: #d7b5f334;
    --nav-surface: #19151f;
    position: absolute;
    inset: 0 0 auto;
    z-index: 20;
    color: var(--nav-text);
    font: 600 15px/1.4 Arial, Helvetica, sans-serif;
  }
  vf-home-navigation {
    position: relative;
    display: flex;
    align-items: stretch;
    justify-content: space-between;
    gap: clamp(20px, 3vw, 48px);
    width: min(100%, 1440px);
    margin-inline: auto;
    padding-inline: 4.4%;
  }
  .home-brand { display: block; align-self: center; flex: 0 0 auto; width: 138px; padding-block: 20px; }
  .home-brand img { display: block; width: 100%; height: auto; }
  a { color: inherit; text-decoration: none; }
  button { color: inherit; font: inherit; cursor: pointer; }
  :is(a, button, summary):focus-visible { outline: 2px solid var(--nav-accent); outline-offset: 3px; }
  nav, .home-main-links, .home-nav-actions { display: flex; align-items: center; }
  nav { flex: 1; gap: 4px; }
  .home-main-links { gap: 6px; }
  .home-nav-actions { gap: 16px; margin-inline-start: auto; }
  .home-main-links a, summary, .home-language, .home-nav-contact {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 12px;
    border-radius: 9px;
  }
  .home-main-links a:hover, .home-language:hover, summary:hover { background: #e6d1f616; }
  nav a[aria-current], .home-dropdown-active, details[open] > summary { color: var(--nav-accent); }
  .home-nav-contact {
    justify-content: center;
    gap: 14px;
    padding-inline: 16px;
    background: #dec6f4;
    color: #1c1325;
    border-radius: var(--radius-pill, 9999px);
    text-align: center;
  }
  .home-nav-contact:hover { background: #eddafe; }
  .home-language { min-width: 44px; justify-content: center; font-size: .875rem; }
  .home-chevron {
    display: inline-block;
    flex: 0 0 auto;
    width: 7px;
    height: 7px;
    border: solid currentColor;
    border-width: 0 1.5px 1.5px 0;
    transform: rotate(-45deg);
  }
  nav > details { align-self: stretch; display: flex; align-items: center; }
  .home-agency-menu { position: relative; }
  summary { gap: 11px; cursor: pointer; list-style: none; }
  summary::-webkit-details-marker { display: none; }
  summary .home-chevron { margin-block-start: -4px; transform: rotate(45deg); }
  details[open] > summary .home-chevron { margin-block-start: 3px; transform: rotate(225deg); }
  .home-mega-panel {
    position: absolute;
    top: calc(100% - 12px);
    inset-inline: 4.4%;
    max-height: calc(100svh - 132px);
    overflow: auto;
    overscroll-behavior: contain;
    border: 1px solid var(--nav-line);
    border-radius: 19px;
    background: var(--nav-surface);
    box-shadow: 0 26px 72px #080511a6;
  }
  .home-agency-menu .home-mega-panel { inset-inline: 0 auto; width: 16rem; }
  .home-agency-menu .home-mega-columns { display: block; }
  .home-agency-menu .home-mega-group { padding: 12px 18px; background: transparent; }
  .home-agency-menu .home-mega-group a { min-height: 48px; }
  details[open] .home-mega-panel { animation: home-nav-enter 160ms ease-out both; }
  .home-mega-columns { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .home-mega-group { padding: clamp(22px, 2.6vw, 38px); }
  .home-mega-group + .home-mega-group { border-inline-start: 1px solid var(--nav-line); }
  .home-mega-group:last-child { background: #271c33; }
  .home-mega-group h2 {
    margin: 0 0 12px;
    color: #dbc0f0;
    font-size: .875rem;
    font-weight: 600;
    letter-spacing: .025em;
  }
  .home-mega-group ul { margin: 0; padding: 0; list-style: none; }
  .home-mega-group li + li { margin-top: 4px; }
  .home-mega-group a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    min-height: 63px;
    margin-inline: -10px;
    padding: 9px 10px;
    border-radius: 9px;
  }
  .home-mega-group a:is(:hover, :focus-visible, [aria-current]) { background: #dfc2f318; }
  .home-mega-group a .home-chevron { color: #cfabec; }
  .home-mega-link-copy { display: grid; gap: 4px; }
  .home-mega-link-copy strong { font-size: 1rem; font-weight: 600; }
  .home-mega-link-copy > span { color: var(--nav-muted); font-size: .875rem; font-weight: 400; }
  .home-mega-mobile-head, .home-menu-toggle, [hidden] { display: none; }
  .home-skip { position: fixed; top: 10px; left: 10px; z-index: 100; padding: 12px 18px; background: #f5f2ed; color: #28232e; transform: translateY(-160%); font: 16px Arial,sans-serif; }
  .home-skip:focus { transform: none; }

  @keyframes home-nav-enter {
    from { opacity: 0; transform: translateY(-5px); }
    to { opacity: 1; transform: translateY(0); }
  }
  @media (max-width: 900px) {
    vf-home-navigation { align-items: center; flex-wrap: wrap; gap: 0; padding-inline: clamp(14px, 4.4vw, 32px); }
    .home-brand { width: 112px; padding-block: 15px; }
    .home-menu-toggle:not([hidden]) {
      display: inline-flex;
      align-items: center;
      gap: 12px;
      min-height: 44px;
      padding: 0 14px;
      color: var(--nav-text);
      border: 1px solid #776387;
      border-radius: var(--radius-pill, 9999px);
      background: #211a2c;
    }
    .home-menu-icon { position: relative; display: inline-block; width: 14px; height: 14px; }
    .home-menu-icon::before, .home-menu-icon::after {
      position: absolute;
      top: 6px;
      inset-inline: 0;
      height: 1.5px;
      background: currentColor;
      content: '';
    }
    .home-menu-icon::before { transform: translateY(-3px); }
    .home-menu-icon::after { transform: translateY(3px); }
    [aria-expanded="true"] .home-menu-icon::before { transform: rotate(45deg); }
    [aria-expanded="true"] .home-menu-icon::after { transform: rotate(-45deg); }
    nav:not([hidden]) {
      display: flex;
      flex: 0 0 auto;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      width: 100%;
      background: var(--nav-surface);
      border: 1px solid var(--nav-line);
      border-radius: 16px;
    }
    vf-home-navigation[data-enhanced] nav {
      position: absolute;
      top: calc(100% - 2px);
      inset-inline: clamp(14px, 4.4vw, 32px);
      width: auto;
      max-height: calc(100dvh - 106px);
      overflow-y: auto;
      overscroll-behavior: contain;
      scroll-padding-block-start: 58px;
      box-shadow: 0 18px 54px #090510a6;
    }
    nav > details { display: block; }
    summary, .home-main-links a { width: 100%; justify-content: space-between; min-height: 56px; padding-inline: 20px; border-radius: 0; font-size: 1.0625rem; }
    summary .home-chevron { margin: 0; transform: rotate(-45deg); }
    .home-main-links { align-items: stretch; flex-direction: column; gap: 0; }
    .home-main-links a, summary { border-bottom: 1px solid var(--nav-line); }
    .home-nav-actions { gap: 12px; margin-inline-start: 0; padding: 17px 19px; }
    .home-nav-contact { flex: 1 1 auto; }
    .home-language { border: 1px solid var(--nav-line); }
    .home-mega-panel { position: static; max-height: none; overflow: visible; border: 0; border-radius: 0; box-shadow: none; }
    .home-agency-menu .home-mega-panel { width: auto; }
    .home-mega-columns { display: block; }
    .home-mega-group { padding: 18px 20px; }
    .home-mega-group + .home-mega-group { border-inline-start: 0; border-top: 1px solid var(--nav-line); }
    .home-mega-group a, .home-agency-menu .home-mega-group a { min-height: 56px; }
    vf-home-navigation[data-enhanced] nav:has(details[open]) > :is(details:not([open]), .home-main-links, .home-nav-actions),
    vf-home-navigation[data-enhanced] nav > details[open] > summary { display: none; }
    .home-mega-mobile-head:has(button:not([hidden])) {
      position: sticky;
      top: 0;
      z-index: 1;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      padding: 6px 18px;
      border-bottom: 1px solid var(--nav-line);
      background: var(--nav-surface);
      color: var(--nav-muted);
      font-size: .875rem;
    }
    .home-mega-back {
      display: flex;
      align-items: center;
      gap: 10px;
      min-height: 44px;
      padding: 0 7px;
      border: 0;
      border-radius: 8px;
      background: transparent;
      color: var(--nav-accent);
    }
    .home-mega-back .home-chevron { transform: rotate(135deg); }
    :is(.home-main-links a, summary):focus-visible { outline-offset: -5px; }
  }
  @media (prefers-reduced-motion: reduce) {
    details[open] .home-mega-panel { animation: none; }
  }
</style>
