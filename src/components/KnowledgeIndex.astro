---
import AgencyDocument from './AgencyDocument.astro';
import AgencyContact from './AgencyContact.astro';
import AiImageFrame from './AiImageFrame.astro';
import ResponsiveBlogImage from './ResponsiveBlogImage.astro';
import { knowledgeContent, type KnowledgePostFrontmatter } from '../data/knowledgeContent';
import '../styles/knowledge.css';
interface Post { url?: string; frontmatter: KnowledgePostFrontmatter; }
interface Props { locale: 'de'|'en'; posts: Post[]; }
const { locale, posts } = Astro.props;
const c = knowledgeContent[locale];
const byDate = (a: Post, b: Post) => new Date(b.frontmatter.date).getTime() - new Date(a.frontmatter.date).getTime();
const websitePosts = posts.filter(post => post.frontmatter.category === 'website').sort((a,b) => (a.frontmatter.guideOrder ?? 99) - (b.frontmatter.guideOrder ?? 99) || byDate(a,b));
const [featured, ...remaining] = websitePosts;
const supplemental = posts.filter(post => post.frontmatter.category !== 'website').sort(byDate);
const groups = [{ id: 'website-guides', posts: remaining, supplemental: false }, { id: 'ai-perspectives', posts: supplemental, supplemental: true }];
const dateLabel = (date:string) => new Date(date).toLocaleDateString(locale === 'de' ? 'de-DE' : 'en-GB', {day:'numeric',month:'long',year:'numeric',timeZone:'UTC'});
---
<AgencyDocument locale={locale} title={c.title} description={c.intro} path={`/${locale}/blog/`} alternatePath={`/${locale==='de'?'en':'de'}/blog/`}>
  <section class="sv-hero kn-hero" id="home-intro" aria-labelledby="knowledge-title"><div class="hp-wrap"><h1 id="knowledge-title">{c.headline}<br/><em>{c.emphasis}</em></h1><div class="kn-hero-foot"><p class="sv-lead">{c.intro}</p><a class="hp-text-link" href="#beitraege">{c.browse}<span aria-hidden="true">↓</span></a></div></div></section>
  <section class="hp-section kn-articles" id="beitraege" aria-labelledby="articles-title"><div class="hp-wrap"><p class="hp-kicker">{c.articlesKicker}</p><div class="hp-section-heading"><h2 id="articles-title">{c.articlesTitle}<br/><em>{c.articlesEmphasis}</em></h2><p>{c.articlesIntro}</p></div>
    {featured && <article class:list={['kn-featured', {'kn-featured--text': !featured.frontmatter.coverImage}]}>
      {featured.frontmatter.coverImage && <a class="kn-cover-link" href={featured.url} aria-label={`${c.read}: ${featured.frontmatter.title}`}><AiImageFrame label={featured.frontmatter.coverImageDisclosure ?? (locale==='de'?'KI-generierte Illustration':'AI-generated illustration')}><ResponsiveBlogImage image={featured.frontmatter} sizes="(max-width: 700px) calc(100vw - 52px), (max-width: 900px) 90vw, (max-width: 1288px) 45vw, 583px"/></AiImageFrame></a>}
      <div class="kn-featured-copy"><p class="hp-kicker">{c.latest} · {featured.frontmatter.kicker}</p><h3><a href={featured.url}>{featured.frontmatter.title}</a></h3><p>{featured.frontmatter.excerpt}</p><div class="kn-meta"><time datetime={featured.frontmatter.date}>{dateLabel(featured.frontmatter.date)}</time><span>{featured.frontmatter.readTime}</span></div><a class="hp-text-link" href={featured.url}>{c.read}<span aria-hidden="true">↗</span></a></div>
    </article>}
    {groups.map(group => group.posts.length > 0 && <div class:list={{'kn-supplementary': group.supplemental}}>
      {group.supplemental && <><p class="hp-kicker">{c.supplementaryKicker}</p><div class="hp-section-heading"><h2 id={group.id}>{c.supplementaryTitle}<br/><em>{c.supplementaryEmphasis}</em></h2><p>{c.supplementaryIntro}</p></div></>}
      <div class="kn-article-list">{group.posts.map(post => <article class:list={{'kn-article--text': !post.frontmatter.coverImage}}>
        {post.frontmatter.coverImage && <a class="kn-cover-link kn-list-cover" href={post.url} aria-label={`${c.read}: ${post.frontmatter.title}`}><AiImageFrame label={post.frontmatter.coverImageDisclosure ?? (locale==='de'?'KI-generierte Illustration':'AI-generated illustration')}><ResponsiveBlogImage image={post.frontmatter} sizes="(max-width: 700px) calc(100vw - 52px), (max-width: 900px) 180px, 260px"/></AiImageFrame></a>}
        <div><p class="hp-kicker">{post.frontmatter.kicker}</p><h3><a href={post.url}>{post.frontmatter.title}</a></h3><p>{post.frontmatter.excerpt}</p><div class="kn-meta"><time datetime={post.frontmatter.date}>{dateLabel(post.frontmatter.date)}</time><span>{post.frontmatter.readTime}</span></div></div><a class="hp-text-link" href={post.url} aria-label={`${c.read}: ${post.frontmatter.title}`}>{c.read}<span aria-hidden="true">↗</span></a>
      </article>)}</div>
    </div>)}
  </div></section>
  <AgencyContact locale={locale} copy={c.contact} showKicker={false} showNote={false}/>
</AgencyDocument>
