---
import AgencyDocument from './AgencyDocument.astro';
import AgencyContact from './AgencyContact.astro';
import AiImageFrame from './AiImageFrame.astro';
import { knowledgeContent, type KnowledgePostFrontmatter } from '../data/knowledgeContent';
import '../styles/knowledge.css';
interface Post { url?: string; frontmatter: KnowledgePostFrontmatter; }
interface Props { locale: 'de'|'en'; posts: Post[]; }
const { locale, posts } = Astro.props;
const c=knowledgeContent[locale];
const sorted=[...posts].sort((a,b)=>new Date(b.frontmatter.date).getTime()-new Date(a.frontmatter.date).getTime());
const [featured,...remaining]=sorted;
const dateLabel=(date:string)=>new Date(date).toLocaleDateString(locale==='de'?'de-DE':'en-GB',{day:'numeric',month:'long',year:'numeric',timeZone:'UTC'});
---
<AgencyDocument locale={locale} title={c.title} description={c.intro} path={`/${locale}/blog/`} alternatePath={`/${locale==='de'?'en':'de'}/blog/`}>
  <section class="sv-hero kn-hero" id="home-intro" aria-labelledby="knowledge-title"><div class="hp-wrap"><p class="sv-kicker">{c.kicker}</p><h1 id="knowledge-title">{c.headline}<br/><em>{c.emphasis}</em></h1><div class="kn-hero-foot"><p class="sv-lead">{c.intro}</p><a class="hp-text-link" href="#beitraege">{c.browse}<span aria-hidden="true">↓</span></a></div></div></section>
  <section class="hp-section kn-topics" aria-labelledby="topics-title"><div class="hp-wrap"><div class="kn-topics-heading"><p class="hp-kicker">{c.topicsKicker}</p><h2 id="topics-title">{c.topicsTitle} <em>{c.topicsEmphasis}</em></h2></div><div class="kn-topics-grid">{c.topics.map((t,i)=><article><span class="hp-number">0{i+1}</span><h3>{t.title}</h3><p>{t.body}</p><a class="hp-text-link" href={t.href}>{t.label}<span aria-hidden="true">↗</span></a></article>)}</div></div></section>
  <section class="hp-section kn-articles" id="beitraege" aria-labelledby="articles-title"><div class="hp-wrap"><p class="hp-kicker">{c.articlesKicker}</p><div class="hp-section-heading"><h2 id="articles-title">{c.articlesTitle}<br/><em>{c.articlesEmphasis}</em></h2><p>{c.articlesIntro}</p></div>
  {featured && <article class="kn-featured"><a class="kn-cover-link" href={featured.url} aria-label={`${c.read}: ${featured.frontmatter.title}`}><AiImageFrame label={featured.frontmatter.coverImageDisclosure ?? (locale==='de'?'KI-generierte Illustration':'AI-generated illustration')}><picture>{featured.frontmatter.coverImageFallback && <source srcset={featured.frontmatter.coverImage} type="image/avif"/>}<img src={featured.frontmatter.coverImageFallback ?? featured.frontmatter.coverImage} alt={featured.frontmatter.coverImageAlt ?? featured.frontmatter.title} width={featured.frontmatter.coverImageWidth ?? 1600} height={featured.frontmatter.coverImageHeight ?? 900} loading="lazy" decoding="async"/></picture></AiImageFrame></a><div class="kn-featured-copy"><p class="hp-kicker">{c.latest} · {featured.frontmatter.kicker}</p><h3><a href={featured.url}>{featured.frontmatter.title}</a></h3><p>{featured.frontmatter.excerpt}</p><div class="kn-meta"><time datetime={featured.frontmatter.date}>{dateLabel(featured.frontmatter.date)}</time><span>{featured.frontmatter.readTime}</span></div><a class="hp-text-link" href={featured.url}>{c.read}<span aria-hidden="true">↗</span></a></div></article>}
  <div class="kn-article-list">{remaining.map(post=><article><a class="kn-cover-link kn-list-cover" href={post.url} aria-label={`${c.read}: ${post.frontmatter.title}`}><AiImageFrame label={post.frontmatter.coverImageDisclosure ?? (locale==='de'?'KI-generierte Illustration':'AI-generated illustration')}><picture>{post.frontmatter.coverImageFallback && post.frontmatter.coverImage.endsWith('.avif') && <source srcset={post.frontmatter.coverImage} type="image/avif"/>}<img src={post.frontmatter.coverImageFallback ?? post.frontmatter.coverImage} alt={post.frontmatter.coverImageAlt ?? post.frontmatter.title} width={post.frontmatter.coverImageWidth ?? 1600} height={post.frontmatter.coverImageHeight ?? 900} loading="lazy" decoding="async"/></picture></AiImageFrame></a><div><p class="hp-kicker">{post.frontmatter.kicker}</p><h3><a href={post.url}>{post.frontmatter.title}</a></h3><p>{post.frontmatter.excerpt}</p><div class="kn-meta"><time datetime={post.frontmatter.date}>{dateLabel(post.frontmatter.date)}</time><span>{post.frontmatter.readTime}</span></div></div><a class="hp-text-link" href={post.url} aria-label={`${c.read}: ${post.frontmatter.title}`}>{c.read}<span aria-hidden="true">↗</span></a></article>)}</div>
  </div></section>
  <AgencyContact locale={locale} copy={c.contact}/>
</AgencyDocument>
