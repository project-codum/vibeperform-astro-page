---
import '../../styles/global.css';
import { getImage } from 'astro:assets';
import HomePage from '../../components/HomePage.astro';
import ConsentManagerHead from '../../components/ConsentManagerHead.astro';
import ogImageSource from '../../assets/home-promise-workshop-ai.png';
import { homeContent } from '../../data/homeContent';
import { absoluteUrl, jsonLd, organizationSchema, websiteSchema } from '../../lib/siteMetadata';
const faviconHref = `${import.meta.env.BASE_URL}favicon.png`;
const description = homeContent.de.hero.subtitle;
const title = 'KI-Beratung für Handwerk & Mittelstand | Vibeperform';
const canonicalUrl = absoluteUrl('/de/');
const alternateUrl = absoluteUrl('/en/');
const ogImage = await getImage({
	src: ogImageSource,
	width: 1200,
	height: 630,
	fit: 'cover',
	format: 'jpeg',
	quality: 85,
});
const ogImageUrl = absoluteUrl(ogImage.src);
const structuredData = [organizationSchema(), websiteSchema('de')];
---

<html lang="de">
	<head>
		<meta charset="utf-8" />
		<ConsentManagerHead locale="de" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href={faviconHref} />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={ogImageUrl} />
		<meta property="og:image:alt" content="Drei Mitarbeitende besprechen einen Bauplan in einer Metallwerkstatt" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:type" content="image/jpeg" />
		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:site_name" content="Vibeperform" />
		<meta property="og:locale" content="de_DE" />
		<meta property="og:locale:alternate" content="en_US" />
		<link rel="canonical" href={canonicalUrl} />
		<link rel="alternate" hreflang="de" href={canonicalUrl} />
		<link rel="alternate" hreflang="en" href={alternateUrl} />
		<link rel="alternate" hreflang="x-default" href={canonicalUrl} />
		<script type="application/ld+json" set:html={jsonLd(structuredData)} />
	</head>

	<body class="bg-white text-slate-900">
		<HomePage content={homeContent.de} currentLocale="de" alternateLocaleHref="/en/" />
	</body>
</html>
