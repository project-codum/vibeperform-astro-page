---
import type { MarkdownInstance } from 'astro';
import type { KnowledgePostFrontmatter } from '../../../data/knowledgeContent';
import KnowledgeIndex from '../../../components/KnowledgeIndex.astro';
const posts = Object.values(import.meta.glob<MarkdownInstance<KnowledgePostFrontmatter>>('./*.md', { eager: true }));
---
<KnowledgeIndex locale="de" posts={posts} />
